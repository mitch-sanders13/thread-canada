{% doc %}
Renders product swatches, variant controls, purchase options, and add-to-cart content.

@param {object} blocksettings - Product option block settings. @param {boolean} [featured] - Uses the section product
when rendered in a featured-product section.

@example
{% render 'product__options', blocksettings: block.settings, featured: true %}
{% enddoc %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

{% if settings.enable_unavailable_options %}
  {%- liquid
    assign variants_available_arr = product.variants | map: 'available'
    assign variants_option1_arr = product.variants | map: 'option1'
    assign variants_option2_arr = product.variants | map: 'option2'
    assign variants_option3_arr = product.variants | map: 'option3'
  -%}
{% endif %}

{% if product.tags contains 'sale' %}
  <div class="hidden">
    <label
      for="custom-sale"
      class="flex mb-2 opacity-75 type--smaller"
    >
    </label>
    <input
      id="custom-sale"
      type="text"
      name="properties[SALE]"
      class="custom-input_{{ product.handle }}"
      @keyup.debounce="checkLineItems('{{ product.handle }}')"
      value="ALL SALES ARE FINAL ON ITEM"
    >
  </div>
{% endif %}

{% comment %} Swatches {% endcomment %}

{% comment %} Check if this is a collegiate product {% endcomment %}
{% assign is_collegiate = false %}
{% for tag in product.tags %}
  {% assign tag_lowercase = tag | downcase | strip %}
  {% if tag_lowercase == 'collegiate' %}
    {% assign is_collegiate = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% comment %} Product styles load from the cached collection data in collections.ts. {% endcomment %}
{% if product.metafields.custom.swatch_collection %}
  {% liquid
    assign swatch_collection_ref = product.metafields.custom.swatch_collection.value
    assign swatch_expected_count = swatch_collection_ref.all_products_count | default: 0
    assign swatch_container_class = 'js:pdp-swatches'
    assign swatch_selector_id = 'PdpStyleSelector-' | append: product.id
    assign swatch_row_count = 3
    if product.type == 'Bundle'
      assign swatch_row_count = 1
    endif
    if is_collegiate
      assign swatch_container_class = 'js:pdp-collegiate-swatches'
    endif
  %}
  <div class="flex w-full px-4">
    <div
      class="{{ swatch_container_class }} flex min-w-0 w-full flex-col [--pdp-style-selector-column-count:4] [--pdp-style-selector-tile-width:clamp(6.5rem,calc((100%-1.5rem)/3.6),10rem)]"
      data-pdp-swatch-rows="{{ swatch_row_count }}"
      data-product-type="{{ product.type }}"
      data-product-handle="{{ product.handle }}"
      data-swatch-collection-handle="{{ swatch_collection_ref.handle }}"
      data-expected-swatch-count="{{ swatch_expected_count }}"
      data-style-count-template="{{ 'products.general.styles_count' | t: count: '__COUNT__' | escape }}"
      aria-busy="true"
    >
      <div class="flex items-center gap-2 border--t-width color__border-divider-1 pt-4">
        <p class="type--small mb-0 mr-auto min-w-0 font-bold">
          {{ 'products.general.select_style' | t }}
        </p>
        <p
          class="type--small mb-0 shrink-0 opacity-60"
          data-pdp-swatch-count
          aria-live="polite"
        ></p>
        <div class="flex shrink-0 gap-1">
          <button
            type="button"
            class="btn btn--plain btn--circle disabled:pointer-events-none disabled:opacity-30"
            data-pdp-swatch-previous
            aria-controls="{{ swatch_selector_id }}"
            aria-label="{{ 'general.media.previous_slide' | t }}"
            disabled
          >
            {% render 'component__icon', icon: 'chevron-left', size: '20', class: '' %}
          </button>
          <button
            type="button"
            class="btn btn--plain btn--circle disabled:pointer-events-none disabled:opacity-30"
            data-pdp-swatch-next
            aria-controls="{{ swatch_selector_id }}"
            aria-label="{{ 'general.media.next_slide' | t }}"
            disabled
          >
            {% render 'component__icon', icon: 'chevron-right', size: '20', class: '' %}
          </button>
        </div>
      </div>

      <div
        id="{{ swatch_selector_id }}"
        class="grid w-full min-w-0 grid-flow-row {% if swatch_row_count == 1 %}grid-rows-1{% else %}grid-rows-[repeat(3,auto)]{% endif %} gap-2 overflow-x-auto overflow-y-hidden overscroll-x-contain pb-1 pl-1 pt-3 scroll-pl-1 scroll-smooth snap-x snap-mandatory hidescrollbar motion-reduce:scroll-auto [-webkit-overflow-scrolling:touch] [grid-template-columns:repeat(var(--pdp-style-selector-column-count),var(--pdp-style-selector-tile-width))]"
        data-pdp-swatch-track
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ 'products.general.select_style' | t }}"
        tabindex="0"
      >
        {% for i in (1..12) %}
          <span class="grid min-w-0 grid-rows-[auto_minmax(1.25rem,auto)]" aria-hidden="true">
            <span class="color__bg-overlay-2 block aspect-square w-full animate-pulse rounded-lg"></span>
            <span
              class="mx-auto min-w-0 w-[70%] truncate whitespace-nowrap px-1 pt-1 text-center opacity-0 type--smaller"
              >&nbsp;</span
            >
          </span>
        {% endfor %}
      </div>

      <template data-pdp-selected-icon>
        {% render 'component__icon', icon: 'check', size: '14', class: '' %}
      </template>
    </div>
  </div>
{% endif %}

{%- comment -%} Variants {%- endcomment -%}
<div
  class="
    flex flex-wrap px-4 no-js--hide
    {% if product.variants.size <= 1 %}
      hidden
    {% endif %}
  "
>
  <p
    class="mb-2 type--small"
    x-show="choosing && buttonDisabled"
    x-cloak
  >
    {{ 'products.general.options_prompt' | t }}
  </p>

  {% for product_option in product.options_with_values %}
    <div
      class="
        w-full
        {% if product_option.values.size <= 1 %}hidden{% endif %}
      "
    >
      {% comment %} Label and popup {% endcomment %}
      <div class="flex justify-between mb-2">
        <label
          class="flex opacity-75 type--smaller"
          for="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
        >
          {{ product_option.name }}
          {% for value in product_option.values %}
            <span
              x-model="{{ product_option.name | handle | remove: '-' }}"
              class="ml-1"
              :class="
                {
                  'inline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                  'hidden' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                }
              "
              x-cloak
              >: {{ value -}}
            </span>
          {% endfor %}
        </label>

        {% capture option_handle %}{{ product_option.name | handle | remove: '-' }}{% endcapture %}
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'popup' -%}
              {% if block.settings.option == option_handle %}
                <div x-data="{ drawer: false }">
                  <button
                    class="flex underline opacity-75 type--smaller"
                    type="button"
                    @click="drawer = true; hide_header = true;"
                  >
                    {{ block.settings.title }}
                  </button>
                  {% capture drawer_content %}
                    <div class="flex sticky top-0 flex-wrap justify-between items-center px-4 py-2 border--b-width color__border-divider-1 color__bg-body">
                      <div>
                        <button class="btn-close-dark btn--smaller" 
                          type="button"
                          title="{{ 'general.navigation.close' | t }}"
                          @click="drawer = false; hide_header = false;">
                          {% render 'component__icon', icon: 'x', size: '24', class: '' %}
                        </button>
                      </div>
                      <div class="text-right">
                        {{ block.settings.title }}
                      </div>
                    </div>
                    <div class="p-4">
                      {{ block.settings.page.content }}
                    </div>
                  {% endcapture %}
                  {% render 'component__drawer', drawer_id: 'drawer', position: 'right', content: drawer_content %}
                </div>
              {% endif %}
          {%- endcase -%}
        {% endfor %}
      </div>

      {%- assign color = 'general.color.color' | t -%}
      {%- assign colorDowncase = color | downcase -%}

      {% comment %} Color options {% endcomment %}
      {%- if product_option.name == color
        or product_option.name == colorDowncase
        or product_option.name == 'Colour'
        or product_option.name == 'colour'
      -%}
        {% if settings.product_color_selection == 'swatches' %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}

              {%- capture swatch_image_filename -%}swatch-{{ value | handle }}.jpg{%- endcapture -%}
              {% assign swatch_image = images[swatch_image_filename] %}
              <button
                type="button"
                class="btn btn--plain btn--small bg-center bg-contain bg-no-repeat !w-8 !h-8 !min-w-0 !min-h-0"
                {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                  x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                {% endif %}
                :class="
                  {
                    {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                      'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                    {% elsif settings.enable_unavailable_options %}
                      'strikethrough': {{ option_disabled }},
                    {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                style="
                  background-color: {{ value | handle }};
                  {% if swatch_image contains '.jpg' %}
                    background-image: url('{{ swatch_image | image_url: width: 128 }}');
                  {% endif %}
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              ></button>
            {% endfor %}
          </div>
        {% elsif settings.product_color_selection == 'buttons' %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <button
                type="button"
                class="btn btn--plain btn--small"
                {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                  x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                {% endif %}
                :class="
                  {
                    {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                      'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                    {% elsif settings.enable_unavailable_options %}
                      'strikethrough': {{ option_disabled }},
                    {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        {% else %}
          <select
            @change="handleForm()"
            class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
            :class="{ '!border-rose-500': choosing }"
            id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
            x-model="{{ product_option.name | handle | remove: '-' }}"
          >
            <option disabled selected value="">
              {{ 'products.general.choose_option' | t }}
            </option>
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <option
                value="{{ value | handle }}"
                {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                  :disabled="!optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                {% endif %}
              >
                {{ value }}
                {% if settings.enable_unavailable_options and option_disabled %}
                  - {{ 'products.general.sold_out' | t -}}
                {%- endif %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        {% comment %} All other options {% endcomment %}
      {% else %}
        {% if settings.product_variant_selection == 'dropdowns' %}
          <select
            @change="handleForm()"
            class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
            :class="{ '!border-rose-500': choosing }"
            id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
            x-model="{{ product_option.name | handle | remove: '-' }}"
          >
            <option disabled selected value="">
              {{ 'products.general.choose_option' | t }}
            </option>
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <option
                value="{{ value | handle }}"
                {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                  :disabled="!optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                {% endif %}
              >
                {{ value }}
                {% if settings.enable_unavailable_options and option_disabled %}
                  - {{ 'products.general.sold_out' | t -}}
                {%- endif %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <button
                type="button"
                class="btn btn--plain btn--small"
                {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                  x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                {% endif %}
                :class="
                  {
                    {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                      'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                    {% elsif settings.enable_unavailable_options %}
                      'strikethrough': {{ option_disabled }},
                    {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}

  <select
    class="hidden"
    name="handle"
    x-model="variantHandle"
  >
    {% for variant in product.variants %}
      <option
        value="{{ variant.title | handle }}"
        data-id="{{ variant.id }}"
        {% if variant.id == product.selected_or_first_available_variant.id %}
          selected
        {% endif %}
      >
        {{ variant.title | handle }}
      </option>
    {% endfor %}
  </select>
</div>
<div
  class="
    flex-wrap px-4 hidden no-js--block
    {% if product.variants.size <= 1 %}hidden{% endif %}
  "
>
  <div class="w-full">
    <label
      class="flex mb-1 opacity-75 type--smaller"
      for="Variants-{{ section.id }}"
    >
      {{ 'products.general.sold_out' | t }}
    </label>
    <select
      id="Variants-{{ section.id }}"
      class="w-full"
      name="id"
      x-model="defaultVariantId"
    >
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          {% if variant.available == false %}
            disabled
          {% endif %}
        >
          {{ variant.title }}
          {%- if variant.available == false %}
            - {{ 'products.general.sold_out' | t -}}
          {%- endif %}
          - {{ variant.price | money | strip_html }}
        </option>
      {%- endfor -%}
    </select>
  </div>
</div>

{% comment %} Variant ID input {% endcomment %}
<input
  class="hidden"
  name="id"
  x-model="defaultVariantId"
  value="{{ variant.id }}"
>

{%- comment -%} Selling plan{%- endcomment -%}
{% if product.selected_or_first_available_selling_plan_allocation %}
  <div
    class="
      no-js--hide w-full px-4
      {% if product.variants.size <= 1 %}mt-4{% endif %}
    "
    x-show="defaultHasSellingPlan"
  >
    <div
      class="border--width color__border-divider-1 border--radius w-full !border-b-0 overflow-hidden"
    >
      {% unless product.requires_selling_plan %}
        <div
          class="border--b-width color__border-divider-1"
        >
          <label
            class="inline-flex justify-between items-center px-4 py-4 w-full"
            @click="sellingGroupId = 0"
          >
            <input
              type="radio"
              name="purchase_option"
              value="0"
              {% if product.selected_or_first_available_selling_plan_allocation %}
                checked
              {% endif %}
              :checked="{ 'checked': sellingGroupId == 0 }"
              @change="handleForm"
            >
            <span
              class="ml-2 grow"
            >
              {{ 'products.general.one_time_purchase' | t }}
            </span>
            <span>
              {{ product.price_min | money }}
            </span>
          </label>
        </div>
      {% endunless %}

      {% for group in product.selling_plan_groups %}
        <div
          class="border--b-width color__border-divider-1"
        >
          {% comment %} find lowest price {% endcomment %}
          {% assign selling_plan_price_min = product.price_max | plus: 0 %}
          {% assign selling_plan_discount = 0 %}
          {% for variant in product.variants %}
            {%- for allocation in variant.selling_plan_allocations -%}
              {% if allocation.selling_plan_group_id == group.id %}
                {% if selling_plan_price_min >= allocation.per_delivery_price %}
                  {% assign selling_plan_price_min = allocation.per_delivery_price | plus: 0 %}
                {% endif %}
              {% endif %}
            {%- endfor -%}
          {%- endfor -%}

          {% comment %} find biggest discount {% endcomment %}
          {% assign selling_plan_discount = 0 %}
          {% assign selling_plan_discount_original = 0 %}
          {% assign selling_plan_discount_type = '' %}
          {% for selling_plan in group.selling_plans %}
            {%- for price_adjustment in selling_plan.price_adjustments -%}
              {% assign current_discount = 0 %}
              {% if price_adjustment.value_type == 'fixed_amount' %}
                {% assign current_discount = price_adjustment.value %}
              {% elsif price_adjustment.value_type == 'price' %}
                {% assign current_discount = product.price | minus: price_adjustment.value %}
              {% elsif price_adjustment.value_type == 'percentage' %}
                {% assign current_discount = product.price | times: price_adjustment.value | divided_by: 100 %}
              {% endif %}
              {% if current_discount > selling_plan_discount %}
                {% assign selling_plan_discount = current_discount %}
                {% assign selling_plan_discount_original = price_adjustment.value %}
                {% assign selling_plan_discount_type = price_adjustment.value_type %}
              {% endif %}
            {%- endfor -%}
          {% endfor %}

          <label
            class="inline-flex justify-between items-center px-4 py-4 w-full"
            @click="sellingGroupId = '{{ group.id }}';"
          >
            <input
              type="radio"
              name="purchase_option"
              value="{{ group.id }}"
              {% if product.requires_selling_plan or product.selling_plan_groups.size == 1 %}
                checked
              {% endif %}
              {% if product.selling_plan_groups.size == 1 %}
                x-init="sellingGroupId = '{{ group.id }}';"
              {% endif %}
              @change="handleForm"
            >
            <span class="flex flex-wrap gap-1 items-center ml-2 grow">
              {{ group.name }}
              {% capture selling_plan_discount %}
                {% if selling_plan_discount_type == 'percentage' %}
                  {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | append: '%' }}
                {% else %}
                  {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | money }}
                {% endif %}
              {% endcapture %}
              {% render 'component__badge', color: 'overlay-1', icon: '', content: selling_plan_discount %}
            </span>
            <span class="flex flex-col items-end text-right">
              {{ selling_plan_price_min | money }}
              <span class="flex opacity-75 type--smaller">
                {{ 'products.general.each' | t }}
              </span>
            </span>
          </label>

          {% for variant in product.variants %}
            <div
              class="pb-4 pl-4 border--t-width color__border-divider-1 color__bg-overlay-1"
              x-show="defaultVariantId == {{ variant.id }} && sellingGroupId == '{{ group.id }}'"
              x-cloak
            >
              {% for selling_plan in group.selling_plans %}
                <label
                  class="inline-flex justify-between items-center px-4 pt-4 w-full"
                >
                  <input
                    class="js:{{ group.id }}_{{ variant.id }}_selling_plan"
                    type="radio"
                    name="{{ group.id }}_{{ variant.id }}_selling_plan"
                    value="{{ selling_plan.id }}"
                    {% if product.selected_or_first_available_selling_plan_allocation
                      or group.selling_plans.size == 1
                    %}
                      checked
                    {% endif %}
                    {% if group.selling_plans.size == 1 %}
                      x-init="handleForm"
                    {% endif %}
                    x-model="defaultSellingPlanId"
                    @change="handleForm"
                    data-selling-plan='
                      {
                        {%- for allocation in variant.selling_plan_allocations -%}
                          {% if allocation.selling_plan.id == selling_plan.id %}
                            "price": {{ allocation.price }},
                            "compare_at_price": {{ allocation.compare_at_price }},
                            "per_delivery_price": {{ allocation.per_delivery_price }},
                            "unit_price": {{ allocation.unit_price | default: "0" }},
                          {% endif %}
                        {%- endfor -%}
                        "recurring_deliveries": {{ selling_plan.recurring_deliveries }},
                        "name": "{{ selling_plan.name }}",
                        "description": "{{ selling_plan.description }}",
                        "price_adjustments": [
                          {%- for price_adjustment in selling_plan.price_adjustments -%}
                            {
                              "index": {{ price_adjustment.position }},
                              "value": {{ price_adjustment.value }},
                              "order_count": {{ price_adjustment.order_count | default: "null" }},
                              "value_type": "{{ price_adjustment.value_type }}"
                            }{% unless forloop.last == true %},{% endunless %}
                          {%- endfor -%}
                        ]
                      }
                    '
                  >
                  <span class="ml-2 grow">
                    {{ selling_plan.name }}
                  </span>
                  <span>
                    {%- for allocation in variant.selling_plan_allocations -%}
                      {% if allocation.selling_plan.id == selling_plan.id %}
                        <span class="flex flex-col items-end text-right">
                          {{ allocation.per_delivery_price | money }}
                          <span class="flex opacity-75 type--smaller">
                            {{ 'products.general.each' | t }}
                          </span>
                        </span>
                      {% endif %}
                    {%- endfor -%}
                  </span>
                </label>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <div
      class="mt-2"
      x-show="defaultSellingPlanName && sellingGroupId != 0"
      x-cloak
    >
      <div class="flex gap-2 items-center">
        {% render 'component__icon', icon: 'refresh-cw', size: '16' %}
        <p class="mb-0 type--small">
          <span x-text="defaultSellingPlanName"></span>
          <span x-text="defaultSavingsSummary"></span>
          <span x-text="defaultSellingPlanDescription"></span>
        </p>
      </div>
    </div>
  </div>
  <div class="flex hidden flex-wrap px-4 no-js--block">
    <div class="w-full">
      <label
        class="flex mb-1 opacity-75 type--smaller"
        for="Variants-{{ section.id }}"
      >
        {{ 'products.general.purchase_options' | t }}
      </label>
      <select
        name="selling_plan"
        x-model="defaultSellingPlanId"
      >
        {% for group in product.selling_plan_groups %}
          <optgroup label="{{ group.name }}">
            {% for selling_plan in group.selling_plans %}
              <option value="{{ selling_plan.id }}">
                {{ selling_plan.name }}
              </option>
            {% endfor %}
          </optgroup>
        {% endfor %}
      </select>
    </div>
  </div>
{% endif %}
