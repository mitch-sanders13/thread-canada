<!-- snippets/product__upsell.liquid -->
{% comment %} 
  Block to display a upsell within product block loop.

  Accepts:
    - blocksettings: liquid object of block settings

  Usage:
    {% render 'product__upsell', 
      blocksettings: block.settings %}

  Globals:
    - settings.thumbmails_color_scheme: color scheme of thumbnails

  Possible enhancements: 
    - Fix for duplicate IDs - quantity
  
  Pro tips:
    - Use the Search and Discovery app to update and set custom upsells.
    - Upsells can be set to related or complimentary products.
{% endcomment %}

{%- comment -%}
  Same-colourway companions are shown first (wristlet, chapstick holder, elastic wallet, etc.),
  then Shopify recommendations fill any remaining slots.
  Colourway is derived the same way as bundle__pdp-fbt (handle minus product type, title fallback).
  Up to 9 all_products lookups; bundle__pdp-fbt uses up to 9 as well.
{%- endcomment -%}
{%- liquid
  assign product_type_handle = product.type | handleize
  assign product_type_suffix = '-' | append: product_type_handle
  assign current_colorway_handle = product.handle | remove: product_type_suffix
  if current_colorway_handle == product.handle
    assign current_colorway_title = product.title | split: ' - ' | first
    assign current_colorway_handle = current_colorway_title | handleize
  endif

  assign companion_suffixes = '-wristlet-keychain,-chapstick-holder-keychain,-elastic-wallet,-vertical-leather-wallet,-leather-zip-wallet,-neck-lanyard,-keychain-clip,-wrist-lanyard,-lip-balm-holder' | split: ','
  assign companion_seed = ''
  assign companion_seed_count = 0
  for companion_suffix in companion_suffixes
    if companion_seed_count >= blocksettings.products_count
      break
    endif
    assign companion_handle = current_colorway_handle | append: companion_suffix
    if companion_handle != product.handle
      assign companion_product = all_products[companion_handle]
      if companion_product != blank and companion_product.available
        unless companion_product.tags contains 'hiderecommendation'
          assign companion_seed = companion_seed | append: '|' | append: companion_handle
          assign companion_seed_count = companion_seed_count | plus: 1
        endunless
      endif
    endif
  endfor
  assign companion_seed_handles = companion_seed | remove_first: '|' | split: '|'
-%}
<script type="application/json" id="upsell-seed-{{ product.id }}">
  [{%- for companion_handle in companion_seed_handles -%}{{ all_products[companion_handle] | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
</script>

<section 
  data-product-mix-match
  x-data="{
    initialLoad: true,
    loadingRecomendations: false,
    complementary_products: [],
    getRecomendations(){
      fetch(window.Shopify.routes.root + 'recommendations/products.json?product_id={{ product.id }}&limit=' + ({{ blocksettings.products_count }} + 4) + '&intent={{ blocksettings.intent }}')
        .then(response => response.json())
        .then(({ products }) => {
          let seedProducts = [];
          try {
            const seedEl = document.getElementById('upsell-seed-{{ product.id }}');
            seedProducts = JSON.parse((seedEl && seedEl.textContent) || '[]');
          } catch (e) { seedProducts = []; }
          seedProducts = seedProducts
            .filter(p => p && p.available && p.handle)
            .map(p => Object.assign({}, p, { url: p.url || (window.Shopify.routes.root + 'products/' + p.handle) }));
          const visibleProducts = (products || [])
            .filter(p => p && p.available && p.url)
            .filter(p => !(p.tags || []).includes('hiderecommendation'))
            .filter(p => !seedProducts.some(s => s.id === p.id));
          this.complementary_products = [...seedProducts, ...visibleProducts].slice(0, {{ blocksettings.products_count }});
          this.loadingRecomendations = this.complementary_products.length > 0;
          this.initialLoad = false;
        });
    }
  }"
  x-init="getRecomendations();"
  x-show="complementary_products.length > 0">

  <div x-show="initialLoad">
    <div class="type__nav text-left p-4">
      {{ blocksettings.title }}
    </div>
    <div class="flex flex-col pb-2 px-4">
      <template x-for=" i in {{ blocksettings.products_count }}">
        {% render 'component__skeleton-upsell-item' %}
      </template>
    </div>
  </div>
  
  <div x-init="getRecomendations();"
    x-show="complementary_products.length > 0"
    x-cloak>
    <div class="type__nav text-left p-4">
      {{ blocksettings.title }}
    </div>
    <div class="flex flex-col pb-2 px-4">
      <template x-for="(item, index) in complementary_products">
        <div :class="'relative snap-center mb-2 flex justify-center flex-none whitespace-normal border--width border--radius overflow-hidden color__border-divider-1 upsell upsell--' + item.id"
        x-show="item && item.available && item.url && !(item.tags || []).includes('hiderecommendation')">

          <div class="color__bg-body color__text flex items-center w-full">

            <div class="w-[25%] h-full">
              <div class="object-cover flex items-center aspect-[1/1] aspect-w-1 aspect-h-1 h-full
                {{ settings.thumbmails_color_scheme }}">
                <a :href="item && item.url ? `${ item.url }` : '#'">
                  <img class="w-full h-full object-cover aspect-[1/1] {{ settings.thumbmails_color_scheme }}"
                    width="200"
                    height="200"
                    loading="lazy"
                    :src="`${ item.featured_image }`" 
                    :alt="`${ item.title }`" />
                </a>
              </div>
            </div>

            <div class="flex flex-row items-center justify-between flex-grow gap-2 p-4 text-left">
              <a class="no-underline hover:no-underline" :href="`${ item.url }`">   
                <div class="grow" x-bind:data-product-id="`${ item.id }`">
                  <p class="mb-0 type--small !leading-tight type__heading"
                    x-text="`${item.title}`"></p>
                  <p class="type--small mb-0 !leading-tight" 
                    x-text="Shopify.formatMoney(item.price,'{{ cart.currency.symbol }}')"></p>
                </div>
              </a>

              <div>
                <form class="flex flex-wrap" 
                  action="/cart/add" 
                  method="post" 
                  enctype="multipart/form-data"
                  x-data="{
                    defaultVariantId: item.variants[0].id,
                    defaultSellingPlanId: 0,
                    quantity: 1,
                    button_loading: false
                  }"
                  @submit.prevent="
                    addCartItem(defaultVariantId, defaultSellingPlanId, quantity, true); 
                    button_loading = true; 
                    setTimeout(function(){ button_loading = false}, 500);
                  ">                      
                    <div class="!w-full" 
                      x-show="item.variants.length == 1"> 
                      <input name="id" 
                        type="hidden"
                        value="item.variants[0].id">
                      <label 
                        :for="'upsell_item_quantity_' + item.variants[0].id" class="sr-only">{{ 'products.general.quantity' | t }}</label>
                      <input :id="'upsell_item_quantity_' + item.variants[0].id"
                        class="!hidden" 
                        type="text" 
                        name="quantity" 
                        value="1" 
                        min="1"
                        max="" 
                        x-model="quantity">
                      <button type="submit" 
                        role="button"   
                        class="btn btn--secondary btn--small btn--load"
                        :class="{ 'btn--loading' : cart_loading && button_loading }"
                        :disabled="button_loading">
                        <div class="btn__content">{{ 'products.general.short_add_label' | t }}</div>
                        <div class="btn__spinner">
                          {% render 'component__icon', icon: 'spinner', size: '24', class: '' %}
                        </div>
                      </button>
                    </div>
              
                    <div>
                      <button type="button" 
                        role="button"
                        class="btn btn--secondary btn--small btn--load" 
                        :class="{ 'btn--loading' : button_loading }" 
                        :disabled="button_loading"
                        @click="
                          button_loading = true; 
                          fetchAndRenderQuickAdd(item.handle, 'upsell', $event.currentTarget);
                          setTimeout(function(){ button_loading = false}, 500);"
                        x-show="item.variants.length !== 1">
        
                        <div class="btn__content">{{ 'products.general.short_add_label' | t }}</div>
                        <div class="btn__spinner">
                          {% render 'component__icon', icon: 'spinner', size: '24', class: '' %}
                        </div>
                      </button>
                    </div>

                </form>
              </div>
            </div>

          </div>
  
          {%- comment -%}quick add popup{%- endcomment -%}
          <div :id="'js:quickAdd-upsell-' + item.handle"></div>
  
        </div>
      </template>
    </div>
  </div>
</section>

{% stylesheet %}
  [data-pdp-main]:has([data-fbt-ready]:not([hidden])) [data-product-mix-match] {
    /* Override Alpine's visibility styling while the FBT upsell is available. */
    display: none !important;
  }
{% endstylesheet %}
