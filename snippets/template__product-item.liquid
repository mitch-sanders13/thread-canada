{% doc %}
Renders a client-side product card for recently viewed and recommendation data.

The surrounding Alpine template must expose the product as `item`.
{% enddoc %}

<article
  class="group relative w-full text-left [&:has([data-product-card-primary-link]:focus-visible)]:border--focus-outline"
  x-show="!item.tags.includes('hiderecommendation') && item.available && item.url"
  x-bind:aria-labelledby="`RecentProductCardTitle-${item.id}`"
  x-data="
    {
      active_image: 0,
      card_hovered: false,
      original_second_image: item.images?.[1] || item.featured_image,
      second_image: item.images?.[1] || item.featured_image,
      cardTitle(title) {
        return title.includes(' - ') ? title.split(' - ')[0] : title;
      },
      cardType(title, type) {
        return title.includes(' - ') ? title.split(' - ').slice(-1)[0] : type;
      },
      handleize(value) {
        return value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      },
      swatchClass() {
        const collegiate = item.tags.some(tag => tag.toLowerCase().trim() === 'collegiate');
        const schoolTag = item.tags.find(tag => tag.toLowerCase().trim().startsWith('school_'));
        let value = collegiate ? `collegiate-${this.handleize(item.type)}` : this.handleize(item.type);
        if (collegiate && schoolTag) value += `-${this.handleize(schoolTag.replace(/^school_/i, ''))}`;
        return `js:swatchList-${value}`;
      },
      showActiveSwatch(card, activeSwatch) {
        for (const swatch of card.querySelectorAll('a[data-swatch-preview-image]')) {
          swatch.classList.toggle('border--focus-outline', swatch === activeSwatch);
        }
      },
      previewSwatch(card, target) {
        const swatch = target.closest?.('a[data-swatch-preview-image]');
        if (!swatch) return;
        this.showActiveSwatch(card, swatch);
        this.second_image = swatch.getAttribute('data-swatch-preview-image') || this.original_second_image;
        this.showImage(1, 'auto');
      },
      resetActiveSwatch(card) {
        const defaultSwatch = card.querySelector('a[data-default-product-swatch=true]');
        if (defaultSwatch) this.showActiveSwatch(card, defaultSwatch);
      },
      showImage(index, behavior = 'smooth') {
        const imageCount = Math.min(item.images?.length || 0, 5);
        if (imageCount <= 1) {
          this.active_image = index > 0 ? 1 : 0;
          return;
        }
        const track = this.$refs.imageTrack;
        if (!track || index < 0 || index >= imageCount) return;
        track.scrollTo({ left: track.clientWidth * index, behavior });
        this.active_image = index;
      },
      syncImage() {
        const track = this.$refs.imageTrack;
        if (!track || !track.clientWidth) return;
        this.active_image = Math.round(track.scrollLeft / track.clientWidth);
      }
    }
  "
  @mouseover="previewSwatch($el, $event.target)"
  @mouseenter="card_hovered = true"
  @mouseleave="
    card_hovered = false;
    resetActiveSwatch($el);
    second_image = original_second_image;
    showImage(0, 'auto');
  "
>
  <div
    class="relative overflow-hidden color__bg-overlay-1 {% if settings.thumbnails_border_style == 'image' %}border--radius{% endif %}"
    @mouseenter="if (window.matchMedia('(hover: hover)').matches && item.images.length > 1) showImage(1, 'auto')"
  >
    <div
      x-ref="imageTrack"
      class="hidescrollbar flex w-full snap-x snap-mandatory overscroll-x-contain"
      x-bind:class="item.images.length > 1 ? 'overflow-x-auto' : 'overflow-x-hidden'"
      @scroll.debounce.50ms="syncImage()"
    >
      <template x-for="(image, imageIndex) in item.images.slice(0, 5)" x-bind:key="image">
        <a
          x-bind:href="item.url"
          tabindex="-1"
          class="{{ settings.thumbnails_ratio }} block w-full flex-none snap-start overflow-hidden hover:opacity-100"
          x-bind:aria-label="`${item.title} – image ${imageIndex + 1} of ${Math.min(item.images.length, 5)}`"
        >
          <img
            class="w-full h-full {% if settings['thumbnails_object-sizing'] == 'cover' %}object-cover{% else %}object-contain{% endif %}"
            x-bind:src="item.images.length === 1 ? second_image : (imageIndex === 1 ? second_image : image)"
            x-bind:alt="item.title"
            width="904"
            height="904"
            loading="lazy"
          >
        </a>
      </template>
    </div>

    <div
      class="absolute bottom-2 left-1/2 z-[5] flex -translate-x-1/2 items-center gap-2"
      x-show="card_hovered && item.images.length > 1"
      x-cloak
    >
      <button
        type="button"
        tabindex="-1"
        class="btn btn--plain btn--circle"
        @click.prevent.stop="showImage(active_image === 0 ? Math.min(item.images.length, 5) - 1 : active_image - 1)"
        aria-label="Previous product image"
      >
        {% render 'component__icon', icon: 'chevron-left', size: '20', class: '' %}
      </button>
      <button
        type="button"
        tabindex="-1"
        class="btn btn--plain btn--circle"
        @click.prevent.stop="showImage(active_image === Math.min(item.images.length, 5) - 1 ? 0 : active_image + 1)"
        aria-label="Next product image"
      >
        {% render 'component__icon', icon: 'chevron-right', size: '20', class: '' %}
      </button>
    </div>
  </div>

  <div
    x-bind:class="swatchClass()"
    x-bind:data-current-handle="item.handle"
    class="relative z-[15] hidden py-3 lg:block"
  >
    <div class="flex flex-wrap items-center justify-start gap-3 px-2">
      {% for i in (1..4) %}
        <span
          title="Loading swatches..."
          class="animate-pulse btn btn--plain btn--small !h-8 !min-h-[2rem] !w-8 !min-w-[2rem] !rounded-full bg-center bg-contain !p-0"
        ></span>
      {% endfor %}
    </div>
  </div>

  <div class="whitespace-normal px-2 pb-2 text-left">
    <p
      x-bind:id="`RecentProductCardTitle-${item.id}`"
      class="type__body type--small m-0 p-0 text-left normal-case"
    >
      <a
        x-bind:href="item.url"
        data-product-card-primary-link
        class="type__body type--small normal-case no-underline outline-none hover:no-underline hover:opacity-75"
        x-text="cardTitle(item.title)"
      ></a>
    </p>

    <h3
      class="type__body type--small m-0 p-0 text-left normal-case opacity-60"
      x-show="cardType(item.title, item.type)"
      x-text="cardType(item.title, item.type)"
    ></h3>

    <div class="type__body type--small m-0 flex flex-wrap items-center justify-start gap-2 p-0 text-left">
      <span
        x-bind:data-product-id="item.id"
        x-bind:data-variant-id="item.variants?.[0]?.id"
        x-html="Shopify.formatMoney(item.variants?.[0]?.price ?? item.price)"
      ></span>
      <span
        class="line-through opacity-60"
        x-show="(item.variants?.[0] != null ? (item.variants[0].compare_at_price || 0) : (item.compare_at_price_max || 0)) > (item.variants?.[0]?.price ?? item.price)"
        x-html="Shopify.formatMoney(item.variants?.[0] != null ? (item.variants[0].compare_at_price || 0) : (item.compare_at_price_max || 0))"
      ></span>
    </div>

    <p
      class="type__body type--small m-0 p-0 text-left opacity-60"
      x-show="{{ settings.enable_thumbnails_vendor | json }}"
      x-text="item.vendor"
    ></p>
    <p
      class="type__body type--small m-0 p-0 text-left opacity-60"
      x-show="{{ settings.enable_thumbnails_variant_count | json }}"
      x-text="`${item.variants.length} {{ 'products.general.options' | t }}`"
    ></p>
  </div>
</article>
