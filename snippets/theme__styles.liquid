<!-- snippets/theme__styles.liquid -->
{% comment %} 
  Theme-wide CSS variables. Brand fonts load through theme__fonts; styles live in src/css.

  Usage:
    {% render 'theme__styles' %}

  Globals: 
    - settings.background_body_light: set the body background color for light mode
    - settings.background_body_dark: set the body background color for dark mode
    - settings.foreground_body_light: set the body foreground for light mode (used for text color)
    - settings.foreground_body_dark: set the body foreground for dark mode (used for text color)
    - settings.background_primary_light: set the primary background color for light mode
    - settings.background_primary_dark: set the primary background color for dark mode
    - settings.foreground_primary_light: set the primary foreground for light mode
    - settings.foreground_primary_dark: set the primary foreground for dark mode
    - settings.background_secondary_light: set the secondary background color for light mode
    - settings.background_secondary_dark: set the secondary background color for dark mode
    - settings.foreground_secondary_light: set the secondary foreground for light mode
    - settings.foreground_secondary_dark: set the secondary foreground for dark mode
    - settings.border_button_radius: set the border radius for buttons
    - settings.border_input_radius: set the border radius for input elements
    - settings.border_element_radius: set the border radius for secondary elements
    - settings.border_width: set the border width
    - settings.border_light: set the border color for light mode
    - settings.border_dark: set the border color for dark mode
    - settings.type_base_size: set base size for font size
    - settings.type_button_capitilization: set capitilization for button text
{% endcomment %}

<noscript><style>
  .js\:animation.opacity-0 {
    opacity: 100 !important;
  }
  .js\:animation.translate-y-4,
  .js\:animation.translate-y-8 {
    transform: translateY(0px) !important;
  }
  .no-js--hide {
    display: none !important;
  }
  .no-js--block {
    display: block !important;
  }
</style></noscript>

{% style %}
  :root {
    --type-font-handwritten-family: "Thread Handwritten", cursive;
    --thread-ink: #1c1c1c;
    --thread-blue: #1e7db3;
    --thread-gold: #eebc2c;
    --thread-bronze: #c08951;
    --thread-bone: #f4f1ea;
    --thread-putty: #e0ddd8;
    --thread-hairline: #e3ded2;
    --thread-grey: #888888;

    --oke-button-backgroundColor: var(--color-primary-button-background-light) !important;
    --oke-button-backgroundColorHover: var(--color-primary-button-background-light) !important;
    --oke-button-backgroundColorActive: var(--color-primary-button-background-light) !important;
    --oke-button-borderColor: var(--color-primary-button-background-light) !important;
    --oke-button-borderColorHover: var(--color-primary-button-background-light) !important;
    --oke-button-borderColorActive: var(--color-primary-button-background-light) !important;
    --oke-avatar-backgroundColor: var(--color-primary-button-background-light) !important;
    --oke-highlightColor: var(--color-primary-button-background-light) !important;
    --oke-attributeBar-markerColor: var(--color-primary-button-background-light) !important;
    --oke-filter-backgroundColorActive: var(--color-primary-button-background-light) !important;
    --oke-filter-borderColor: var(--color-primary-button-background-light) !important;
    --oke-filter-borderColorActive: var(--color-primary-button-background-light) !important;
    --oke-filter-textColor: var(--color-primary-button-background-light) !important;
    --oke-stars-foregroundColor: var(--color-primary-button-background-light) !important;
    
    --color__bg-body-light: {{ settings.background_body_light }};
    --color__bg-overlay-light-1: #f5f5f5;
    --color__bg-overlay-light-2: {{ settings.background_body_light | color_darken: 12 }};
    --color__bg-overlay-light-3: {{ settings.background_body_light | color_darken: 24 }};

    --color__text-light: {{ settings.foreground_body_light | default: 'var(--thread-ink)' }};
    --color__link-light: var(--color-primary-button-background-light);

    --color__text-dark: {{ settings.foreground_body_dark }};

    --color__border-divider-light-1: {{ settings.border_light | default: 'var(--thread-hairline)' }};
    --color__border-divider-light-2: {{ settings.border_light | color_darken: 15 }};
    --color__border-divider-light-3: {{ settings.border_light | color_darken: 30 }};
    --color__border-selected-light-1: {{ settings.border_light | color_darken: 45 }};
    --color__border-selected-light-2: {{ settings.border_light | color_darken: 60 }};

    --color-primary-button-background-light: {{ settings.background_primary_light | default: 'var(--thread-blue)' }};
    --color-primary-button-border-light: var(--color-primary-button-background-light);
    --color-primary-button-text-light: {{ settings.foreground_primary_light }};

    --color-secondary-button-background-light: {{ settings.background_secondary_light | default: 'var(--thread-ink)' }};
    --color-secondary-button-border-light: var(--color-secondary-button-background-light);
    --color-secondary-button-text-light: {{ settings.foreground_secondary_light }};

    --color-tertiary-button-background-light: {{ settings.background_tertiary_light | default: 'var(--thread-bronze)' }};
    --color-tertiary-button-border-light: var(--color-tertiary-button-background-light);
    --color-tertiary-button-text-light: {{ settings.foreground_tertiary_light }};

    --color-neutral-button-background-light: {{ settings.background_body_light | color_darken: 5 | color_mix: settings.background_primary_light, 94 }};
    --color-neutral-button-border-light: {{ settings.background_body_light | color_darken: 5 | color_mix: settings.background_primary_light, 94 }};
    --color-neutral-button-text-light: var(--color__text-light);

    --color-plain-button-background-light: {{ settings.background_body_light | color_darken: 6 }};
    --color-plain-button-border-light: {{ settings.background_body_light | color_darken: 6 }};
    --color-plain-button-text-light: var(--color__text-light);

    --color-minimal-button-background-transparent: rgb(0,0,0,0);
    --color-minimal-button-border-light: {{ settings.foreground_minimal_light }};
    --color-minimal-button-text-light: {{ settings.foreground_minimal_light }};
    
    --color-minimal-button-border-dark: var(--color-minimal-button-text-dark);
    --color-minimal-button-text-dark: {{ settings.foreground_minimal_dark | default: 'var(--thread-ink)' }};

    --color-minimal-button-border-primary: var(--color-primary-button-background-light);
    --color-minimal-button-text-primary: var(--color-primary-button-background-light);

    --sizes-border-button-radius: {{ settings.border_button_radius }}px;
    --sizes-border-input-radius: {{ settings.border_input_radius }}px;
    --sizes-border-element-radius: {{ settings.border_element_radius }}px;
    --sizes-border-width: {{ settings.border_width }}px;
    --sizes-gap-width: {{ settings.layout_gap_size }}px;

    --type-font-forma-family: "FormaDJR", sans-serif;
    --type-font-forma-letter-spacing: 1.275px;
    --type-font-body-family: var(--type-font-forma-family);
    --type-font-body-style: normal;
    --type-font-body-weight: 300;
    --type-font-body-letter-spacing: 0.07em;
    --type-font-header-family: "PP Right Grotesk", sans-serif;
    --type-font-header-style: normal;
    --type-font-header-weight: 700;
    --type-font-nav-family: var(--type-font-header-family);
    --type-font-nav-style: normal;
    --type-font-nav-weight: 500;
    --type-font-button-family: var(--type-font-forma-family);
    --type-font-button-style: normal;
    --type-font-button-weight: 700;
    --type-font-button-letter-spacing: var(--type-font-forma-letter-spacing);
    --type-font-base-size: {{ settings.type_base_size }}px;
  }

{% endstyle %}
