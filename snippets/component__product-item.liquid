<!-- snippets/component__product-item.liquid -->
{% comment %}
  Standard product thumbnail.
  Accepts:
    - product: Liquid product object
    - source: accessibility context
    - prioritize_image: eager-load the primary image for an initial collection card
{% endcomment %}

{% assign disable_quick_add = false %}
{% if product.tags contains 'disable_quick_add' %}
  {% assign disable_quick_add = true %}
{% endif %}

{% assign hideproduct = false %}
{% assign hide_sale = false %}
{% assign is_collegiate_product = false %}
{% assign school_tag = '' %}
{% for tag in product.tags %}
  {% assign tag_lowercase = tag | downcase | strip %}
  {% if tag contains 'hideproduct' %}
    {% assign hideproduct = true %}
  {% endif %}
  {% if tag == 'collegiate' and collection.handle != 'collegiate' and template != 'search' %}
    {% assign hideproduct = true %}
  {% endif %}
  {% if tag == 'hide_sale' %}
    {% assign hide_sale = true %}
  {% endif %}
  {% if tag_lowercase == 'collegiate' %}
    {% assign is_collegiate_product = true %}
  {% endif %}
  {% if tag_lowercase contains 'school_' %}
    {% assign school_tag = tag_lowercase | remove: 'school_' %}
  {% endif %}
{% endfor %}

{% assign swatch_class = product.type | handle %}
{% if is_collegiate_product %}
  {% assign swatch_class = 'collegiate-' | append: swatch_class %}
  {% if school_tag != '' %}
    {% assign swatch_class = swatch_class | append: '-' | append: school_tag %}
  {% endif %}
{% endif %}

{% assign card_title = product.title %}
{% assign card_type = product.type %}
{% assign title_parts = product.title | split: ' - ' %}
{% if title_parts.size > 1 %}
  {% assign card_title = title_parts | first %}
  {% assign card_type = title_parts | last %}
{% endif %}

{% assign image_count = product.images.size | at_most: 5 %}
{% assign image_slide_count = image_count | at_least: 2 %}
{% assign second_image = product.images[1] | default: product.featured_image %}

{% assign product_qty = 0 %}
{% if settings.stock_threshold %}
  {% for variant in product.variants %}
    {% if variant.inventory_quantity > 0 %}
      {% assign product_qty = product_qty | plus: variant.inventory_quantity %}
    {% endif %}
  {% endfor %}
{% endif %}

{% capture badge_markup %}
  {% for tag in product.tags %}
    {% if tag contains 'badge_' %}
      {% assign badge_text = tag | remove: 'badge_' | strip %}
      {% if badge_text != blank %}<span class="type__body type--small normal-case px-2 py-1 text-black">{{ badge_text }}</span>{% endif %}
    {% endif %}
  {% endfor %}
  {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price and hide_sale == false %}<span class="type__body type--small normal-case px-2 py-1 text-black">Sale</span>{% endif %}
  {% if settings.stock_threshold and product_qty < settings.stock_threshold and product_qty > 0 %}<span class="type__body type--small normal-case px-2 py-1 text-black">Low Stock</span>{% endif %}
  {% unless product.available %}<span class="type__body type--small normal-case px-2 py-1 text-black">{{ 'products.general.sold_out' | t }}</span>{% endunless %}
  {% if product.metafields.custom.badge %}<span class="type__body type--small normal-case px-2 py-1 text-black">{{ product.metafields.custom.badge }}</span>{% endif %}
{% endcapture %}
{% assign badge_markup = badge_markup | strip %}

{% unless hideproduct %}
  <article
    data-product-card
    class="group relative w-full text-left [&:has([data-product-card-primary-link]:focus-visible)]:border--focus-outline"
    aria-labelledby="ProductCardTitle-{{ product.id }}"
    x-data='productCard({ originalSecondImage: {{ second_image | image_url: width: 900 | json }}, imageSlideCount: {{ image_slide_count }} })'
    x-init="initialize($el)"
    @mouseenter="{% if image_count > 1 %}hoverSecondImage(){% endif %}"
    @mouseover="previewSwatch($el, $event.target)"
    @mouseleave="handleMouseLeave($el)"
  >
    <div
      class="relative overflow-hidden color__bg-overlay-1 {% if settings.thumbnails_border_style == 'image' %}border--radius{% endif %}"
    >
      {% if badge_markup != blank %}
        <div class="pointer-events-none absolute left-2 top-2 z-[6] flex flex-col items-start gap-1">
          {{ badge_markup }}
        </div>
      {% endif %}

      <div
        data-product-card-image-track
        class="hidescrollbar flex w-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain"
        @scroll.debounce.50ms="syncImage()"
      >
        {% for image in product.images limit: 5 %}
          <a
            href="{{ product.url }}"
            tabindex="-1"
            class="{{ settings.thumbnails_ratio }} block w-full flex-none snap-start overflow-hidden hover:opacity-100"
            aria-label="{{ product.title | escape }} – image {{ forloop.index }} of {{ image_count }}"
          >
            {% if settings['thumbnails_object-sizing'] == 'cover' %}
              {% assign image_class = 'w-full h-full object-cover' %}
            {% else %}
              {% assign image_class = 'w-full h-full object-contain' %}
            {% endif %}

            {% if forloop.index == 2 %}
              <img
                class="{{ image_class }}"
                :src="second_image"
                alt="{{ image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <img
                class="{{ image_class }}"
                src="{{ image | image_url: width: 600 }}"
                srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w"
                sizes="(min-width: 768px) 25vw, 50vw"
                alt="{{ image.alt | default: product.title | escape }}"
                {% if forloop.first and prioritize_image %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% endif %}
          </a>
        {% endfor %}

        {% if image_count == 1 %}
          <a
            href="{{ product.url }}"
            tabindex="-1"
            class="{{ settings.thumbnails_ratio }} block w-full flex-none snap-start overflow-hidden hover:opacity-100"
            aria-label="{{ product.title | escape }} – image preview"
          >
            <img
              class="{{ image_class }}"
              :src="second_image"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          </a>
        {% endif %}
      </div>

      {% if image_count > 1 %}
        <div
          class="animation-500 absolute bottom-2 left-1/2 z-[5] flex -translate-x-1/2 items-center gap-2 opacity-0 group-hover:opacity-100"
        >
          <button
            type="button"
            tabindex="-1"
            class="btn btn--plain btn--circle"
            @click.prevent.stop="showImage(active_image === 0 ? {{ image_count | minus: 1 }} : active_image - 1)"
            aria-label="Previous product image"
          >
            {% render 'component__icon', icon: 'chevron-left', size: '20', class: '' %}
          </button>
          <button
            type="button"
            tabindex="-1"
            class="btn btn--plain btn--circle"
            @click.prevent.stop="showImage(active_image === {{ image_count | minus: 1 }} ? 0 : active_image + 1)"
            aria-label="Next product image"
          >
            {% render 'component__icon', icon: 'chevron-right', size: '20', class: '' %}
          </button>
        </div>
      {% endif %}

      <div class="absolute right-2 top-2 z-10 flex items-center gap-2">
        {% render 'rivo-wishlist-heart', product: product, tabindex: -1, card: true %}

        {% if disable_quick_add == false and product.available %}
          {% if settings.enable_quick_mobile or settings.enable_quick_desktop %}
            <form
              action="/cart/add"
              method="post"
              enctype="multipart/form-data"
              class="{% if settings.enable_quick_mobile and settings.enable_quick_desktop %}flex{% elsif settings.enable_quick_desktop %}hidden md:flex{% else %}flex md:hidden{% endif %}"
              x-data="{ defaultVariantId: {{ product.selected_or_first_available_variant.id }}, defaultSellingPlanId: 0, quantity: 1 }"
              @submit.prevent="
                button_loading = true;
                {% if product.variants.size == 1 %}
                  {% if product.tags contains 'sale' %}
                    addCartItem(defaultVariantId, defaultSellingPlanId, quantity, true, { 'SALE': 'ALL SALES FINAL ON ITEM' });
                  {% else %}
                    addCartItem(defaultVariantId, defaultSellingPlanId, quantity, true);
                  {% endif %}
                  setTimeout(function(){ button_loading = false }, 500);
                {% else %}
                  fetchAndRenderQuickAdd('{{ product.handle }}', 'product', $event.submitter)
                    .finally(() => { button_loading = false });
                {% endif %}
              "
            >
              <input name="id" :value="defaultVariantId" type="hidden">
              <input name="quantity" value="1" type="hidden">
              <button
                type="submit"
                tabindex="-1"
                class="btn btn--plain btn--circle"
                :disabled="button_loading"
                aria-label="{{ 'products.general.add_to_cart' | t | escape }} – {{ product.title | escape }}"
              >
                <span x-show="!button_loading">{% render 'component__icon', icon: 'plus', size: '20', class: '' %}</span>
                <span x-show="button_loading" x-cloak class="animate-spin-slow">
                  {% render 'component__icon', icon: 'spinner', size: '20', class: '' %}
                </span>
              </button>
            </form>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% if product.metafields.custom.swatch_collection or is_collegiate_product %}
      <div
        class="js:swatchList-{{ swatch_class }} relative z-[15] hidden py-3 lg:block"
        data-current-handle="{{ product.handle }}"
      >
        <div class="flex flex-wrap items-center justify-start gap-3 px-2">
          {% for i in (1..4) %}
            <span
              title="Loading swatches..."
              class="animate-pulse btn btn--plain btn--small !h-8 !min-h-[2rem] !w-8 !min-w-[2rem] !rounded-full bg-center bg-contain !p-0"
            ></span>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="px-2 pb-2 text-left {% unless product.metafields.custom.swatch_collection or is_collegiate_product %}pt-2{% endunless %}">
      <p
        id="ProductCardTitle-{{ product.id }}"
        class="type__body type--small m-0 p-0 text-left normal-case"
      >
        <a
          href="{{ product.url }}"
          data-product-card-primary-link
          class="type__body type--small normal-case no-underline outline-none hover:no-underline hover:opacity-75"
        >
          {{- card_title -}}
        </a>
      </p>

      {% if card_type != blank %}
        <h3
          class="type__body type--small m-0 p-0 text-left normal-case opacity-60"
        >
          {{ card_type }}
        </h3>
      {% endif %}

      <div
        class="type__body type--small m-0 flex flex-wrap items-center justify-start gap-2 p-0 text-left"
      >
        <span
          data-product-id="{{ product.id }}"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        >
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {% if product.selected_or_first_available_variant.compare_at_price
            > product.selected_or_first_available_variant.price
        %}
          <span
            class="line-through opacity-60"
            data-product-id="{{ product.id }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          >
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      {% if product.selected_or_first_available_variant.unit_price %}
        <p class="type__body type--small m-0 p-0 text-left opacity-60">
          {{ product.selected_or_first_available_variant.unit_price | money }}/
          {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
          {{- product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
        </p>
      {% endif %}

      {% if settings.enable_thumbnails_vendor %}
        <p class="type__body type--small m-0 p-0 text-left opacity-60">{{ product.vendor }}</p>
      {% endif %}
      {% if settings.enable_thumbnails_variant_count %}
        <p class="type__body type--small m-0 p-0 text-left opacity-60">
          {{ product.variants.size }}
          {{ 'products.general.options' | t }}
        </p>
      {% endif %}
      {% if product.has_only_default_variant and settings.enable_sku %}
        <p class="type__body type--small m-0 p-0 text-left opacity-60">{{ product.variants[0].sku }}</p>
      {% endif %}
      {% if settings.enable_tagline and product.metafields.descriptors.subtitle %}
        <p class="type__body type--small m-0 p-0 text-left opacity-60">{{ product.metafields.descriptors.subtitle }}</p>
      {% endif %}
    </div>

    <div id="js:quickAdd-product-{{ product.handle }}"></div>
  </article>
{% endunless %}
