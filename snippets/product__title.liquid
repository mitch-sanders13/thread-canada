<!-- snippets/product__title.liquid -->
{% comment %}
  Block to display a product title with optional rich text content.

  Accepts:
    - blocksettings: liquid object of block settings
    - featured: boolean to assign product object from section settings, set this to true if block is used within a section rather than product template
    - mobile_layout: boolean to use the shared mobile PDP spacing from the gallery wrapper

  Usage:
    {% render 'product__title',
      blocksettings: block.settings,
      featured: true %}

  Globals:
    - settings.type_seperator: setting to pick the type of seperator between text

  Possible enhancements:
    - Revise design of vender, variant and product category text.
    - Add option to set product title font size - longer product titles may need to be smaller.

  Pro tips:
    - Use metafields to display dynamic product content in rich text field.
{% endcomment %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

<div
  class="
    {% if mobile_layout %}flex flex-col gap-2{% else %}px-4{% endif %}
    {{ section.settings.color_border }}
    {{ blocksettings.color_scheme }}
    {{ blocksettings.style_border }}
  "
  {% unless mobile_layout %}
    style="
      padding-top:{{ blocksettings.spacing_top }}px;
      padding-bottom:{{ blocksettings.spacing_bottom }}px;
    "
  {% endunless %}
>
  {% if mobile_layout %}
    <p class="flex max-w-full mb-0 leading-none type__heading type__heading--bold-3">
      {{ product.title }}
    </p>
  {% else %}
    <h1 class="flex max-w-full mb-0 leading-none type__heading type__heading--bold-3">
      {{ product.title }}
    </h1>
  {% endif %}

  {% unless blocksettings.content == blank %}
    <div class="block m-0--clear">
      {{ blocksettings.content }}
    </div>
  {% endunless %}

  {% assign hide_ratings = false %}
  {% if product.tags contains 'hide_ratings' %}
    {% assign hide_ratings = true %}
  {% endif %}

  {% if hide_ratings == false and product.metafields.reviews.rating.value != blank %}
    <a
      class="
        color__link inline-flex items-center justify-start gap-2 underline-offset-4 hover:underline
        {% unless mobile_layout %}mt-2 md:mt-3 md:mb-0{% endunless %}
      "
      href="#reviews"
    >
      {% assign rating = product.metafields.reviews.rating.value.rating | times: 1 %}
      {% assign max = product.metafields.reviews.rating.value.scale_max %}
      {% assign filled_stars = rating | round %}
      <span class="sr-only">
        {{-
          'general.accessibility.rating_summary'
          | t: rating: rating, max: max, count: product.metafields.reviews.rating_count
        -}}
      </span>
      <div
        class="text-[var(--oke-stars-foregroundColor)] flex shrink-0 items-center gap-1 leading-none"
        aria-hidden="true"
      >
        {% for iteration in (1..max) %}
          {% if iteration <= filled_stars %}
            {% render 'component__icon', icon: 'star', size: '14', class: 'block shrink-0' %}
          {% else %}
            {% render 'component__icon', icon: 'star', size: '14', class: 'block shrink-0 opacity-25' %}
          {% endif %}
        {% endfor %}
      </div>
      {% if product.metafields.reviews.rating_count > 0 %}
        <span class="type--small shrink-0 leading-none opacity-75"
          >({{ product.metafields.reviews.rating_count }})</span
        >
      {% else %}
        <span class="type--small shrink-0 leading-none opacity-75">{{ product.metafields.reviews.rating_count }}</span>
      {% endif %}
    </a>
  {% endif %}
</div>
