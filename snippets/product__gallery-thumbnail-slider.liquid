{% doc %}
  Displays product media in a slider with a desktop thumbnail rail.

  @param {boolean} [featured] - Uses the section product when rendered in a featured product section.
  @param {boolean} [nested_gallery_column] - Uses the full width of the parent gallery column.

  @example
  {% render 'product__gallery-thumbnail-slider', featured: true %}
{% enddoc %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

{% if nested_gallery_column %}
  {% assign gallery_width_class = 'w-full' %}
{% else %}
  {% assign gallery_width_class = section.settings.layout_gallery_size %}
{% endif %}

{% liquid
  assign gallery_ratio_class = blank
  if section.settings.enable_ratio
    if section.settings.media_ratio contains '2/3'
      assign gallery_ratio_class = 'aspect-[2/3]'
    else
      assign gallery_ratio_class = 'aspect-square'
    endif
  endif
  assign selected_variant_handle = product.selected_or_first_available_variant.title | handle
  assign eager_gallery_image_id = blank
  if product.selected_or_first_available_variant.featured_media.media_type == 'image'
    assign eager_gallery_image_id = product.selected_or_first_available_variant.featured_media.id
  else
    for media in product.media
      if media.media_type == 'image'
        assign eager_gallery_image_id = media.id
        break
      endif
    endfor
  endif
  assign gallery_skeleton_count = 0
  for media in product.media
    assign show_skeleton = true
    if section.settings.enable_variant_images and media.media_type == 'image'
      assign media_alt_handle = media.alt | handle
      unless media_alt_handle contains selected_variant_handle
        assign show_skeleton = false
      endunless
    endif
    if show_skeleton
      assign gallery_skeleton_count = gallery_skeleton_count | plus: 1
    endif
  endfor
  if gallery_skeleton_count < 1
    assign gallery_skeleton_count = 1
  endif
%}

{% comment %} Mobile only blocks {% endcomment %}
<div class="flex w-full flex-col gap-2 px-4 py-4 md:hidden">
  {% for block in section.blocks %}
    {%- case block.type -%}
      {%- when 'breadcrumb' -%}
        {% render 'product__breadcrumb', blocksettings: block.settings %}

      {%- when 'title' -%}
        {% render 'product__title', blocksettings: block.settings, mobile_layout: true %}

      {%- when 'price' -%}
        <div
          class="
            {{ section.settings.color_border }}
            {{ block.settings.color_scheme }}
            {{ block.settings.style_border }}
          "
        >
          <div class="relative flex items-end justify-between">
            {% render 'product__price', blocksettings: block.settings %}
          </div>
        </div>
    {%- endcase -%}
  {% endfor %}
</div>

<div class="{{ gallery_width_class }} flex flex-col">
  <div
    class="flex min-w-0 flex-wrap items-start overflow-hidden md:flex-nowrap"
    style="gap: {{ settings.layout_gap_size }}px;"
  >
    {% comment %} thumbnails {% endcomment %}
    <div
      class="hidden min-w-0 shrink-0 basis-[10%] max-h-[calc(100vh-8rem)] flex-col overflow-hidden md:flex"
      style="gap: {{ settings.layout_gap_size }}px;"
      x-show="!gallery_ready"
      aria-hidden="true"
    >
      {% for item in (1..gallery_skeleton_count) %}
        <span
          class="color__bg-overlay-2 border--width border--radius block aspect-square w-full shrink-0 animate-pulse overflow-hidden"
        ></span>
      {% endfor %}
    </div>
    <template x-if="gallery_ready">
      <div
        class="hidden min-w-0 shrink-0 basis-[10%] max-h-[calc(100vh-8rem)] flex-col overflow-x-hidden overflow-y-auto md:flex"
        style="gap: {{ settings.layout_gap_size }}px;"
        x-ref="thumbnail_slider"
      >
        {% for media in product.media %}
          <div
            data-gallery-thumbnail
            class="
              relative snap-center flex-none hover:cursor-pointer w-full opacity-50 border--width border--radius overflow-hidden animation-300
              {{ media | handle }}
            "
            :class="{ '!opacity-100 color__border-selected-1': gallery_index === {{ forloop.index0 }} }"
            {% if section.settings.enable_variant_images and media.media_type == 'image' %}
              x-show="'{{ media.alt | handle }}'.includes(variantHandle) && !Object.keys(variants).some(candidate => candidate !== variantHandle && candidate.includes(variantHandle) && '{{ media.alt | handle }}'.includes(candidate))"
            {% endif %}
            x-bind:data-slide="{{ forloop.index0 }}"
            @click="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll);"
          >
            <div class="aspect-square w-full overflow-hidden object-cover">
              {% capture image_class %}w-full h-full object-cover !bg-transparent {{ settings.thumbmails_color_scheme }}{% endcapture %}
              {{
                media.preview_image
                | image_url: width: 192, height: 192
                | image_tag: class: image_class, loading: 'lazy', alt: media.alt
              }}
            </div>
          </div>
        {% endfor %}
      </div>
    </template>

    {% comment %} main images {% endcomment %}
    <div
      data-gallery-main
      class="relative flex {{ gallery_ratio_class }} min-h-0 min-w-0 w-full self-start overflow-hidden md:flex-1"
    >
      <div
        class="color__bg-overlay-2 absolute inset-0 z-20 animate-pulse"
        x-show="!gallery_ready"
        aria-hidden="true"
      ></div>
      {%- comment -%}badges{%- endcomment -%}
      {% if section.settings.show_product_badges %}
        <div class="absolute top-0 left-0 z-10 flex flex-wrap w-full gap-2 px-4 py-2 whitespace-normal">
          {%- if product.metafields.reviews.rating.value != blank -%}
            {% capture badge_content %}
            {% assign rating = product.metafields.reviews.rating.value | strip %}
            {{ rating | times: 1 | round: 2 }}
              {% render 'component__icon', icon: 'star', size: '12', class: 'ml-1' %} 
            {% endcapture %}
            {% render 'component__badge', background: 'overlay-2', text: 'text', icon: '', content: badge_content %}
          {%- endif -%}

          {% for tag in product.tags %}
            {% if tag contains 'badge_' %}
              {% capture badge_content %}{{ tag | remove: "badge_" }}{% endcapture %}
              {% render 'component__badge',
                background: 'secondary',
                text: 'secondary',
                icon: '',
                content: badge_content
              %}
            {% endif %}
          {% endfor %}

          {% render 'product__savings-badge-alpine', product: product %}
        </div>
      {% endif %}

      {%- comment -%}arrows{%- endcomment -%}
      {% if product.media.size > 1 %}
        <div
          x-show="show_arrows && gallery_ready"
          class="absolute left-4 top-1/2 z-10 hidden -translate-y-1/2 md:block"
        >
          <button
            type="button"
            class="btn btn--plain btn--circle shadow-sm"
            title="{{ 'general.media.previous_slide' | t }}"
            aria-label="{{ 'general.media.previous_slide' | t }}"
            aria-controls="ProductGallery-{{ section.id }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            x-cloak
            @click.stop.prevent="scrollBack();"
          >
            {% render 'component__icon', icon: 'chevron-left', size: '20', class: '' %}
          </button>
        </div>
        <div
          x-show="show_arrows && gallery_ready"
          class="absolute right-4 top-1/2 z-10 hidden -translate-y-1/2 md:block"
        >
          <button
            type="button"
            class="btn btn--plain btn--circle shadow-sm"
            title="{{ 'general.media.next_slide' | t }}"
            aria-label="{{ 'general.media.next_slide' | t }}"
            aria-controls="ProductGallery-{{ section.id }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            x-cloak
            @click.stop.prevent="scrollNext();"
          >
            {% render 'component__icon', icon: 'chevron-right', size: '20', class: '' %}
          </button>
        </div>
      {% endif %}

      {%- comment -%}slides{%- endcomment -%}
      <div
        id="ProductGallery-{{ section.id }}"
        class="inline-flex {{ gallery_ratio_class }} min-h-0 min-w-0 max-w-full w-full items-start overflow-x-auto overflow-y-hidden whitespace-nowrap text-center snap-x snap-mandatory overscroll-x-contain [-webkit-overflow-scrolling:touch] md:snap-x hidescrollbar"
        style="gap: {{ settings.layout_gap_size }}px; visibility: hidden;"
        :style="{ visibility: gallery_ready ? 'visible' : 'hidden' }"
        x-init="$nextTick(function(){ initializeGallery($el); })"
        x-ref="slider"
      >
        {% for media in product.media %}
          {% case media.media_type %}
            {% when 'image' %}
              {% assign gallery_image_loading = 'lazy' %}
              {% assign gallery_image_fetchpriority = 'auto' %}
              {% if media.id == eager_gallery_image_id %}
                {% assign gallery_image_loading = 'eager' %}
                {% assign gallery_image_fetchpriority = 'high' %}
              {% endif %}
              <div
                class="
                  relative flex-none {{ gallery_ratio_class }} overflow-hidden border--width border--radius snap-center snap-always
                  {{ section.settings.image_border }}
                  {{ media | handle }}
                  {% if section.settings.enable_zoom %}cursor-zoom-in{% endif %}
                  w-full
                "
                {% if section.settings.enable_variant_images %}
                  x-show="'{{ media.alt | handle }}'.includes(variantHandle) && !Object.keys(variants).some(candidate => candidate !== variantHandle && candidate.includes(variantHandle) && '{{ media.alt | handle }}'.includes(candidate))"
                  x-cloak
                {% endif %}
                {% if section.settings.enable_zoom %}
                  @click="fullscreen = true; hide_header = true;"
                {% endif %}
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}"
                data-media-type="image"
                {% if media.id == eager_gallery_image_id %}
                  data-initial-slide
                {% endif %}
              >
                <div
                  class="
                    h-full w-full overflow-hidden object-cover
                    {{ section.settings.media_color_scheme }}
                  "
                >
                  {% if section.settings['media_object-sizing'] == 'cover' %}
                    {% capture image_class %}w-full h-full object-cover {{ section.settings.media_color_scheme }}{% endcapture %}
                  {% else %}
                    {% capture image_class %}w-full h-full object-contain {{ section.settings.media_color_scheme }}{% endcapture %}
                  {% endif %}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      class: image_class,
                      loading: gallery_image_loading,
                      fetchpriority: gallery_image_fetchpriority,
                      widths: '400, 600, 900, 1200, 1400',
                      sizes: '(min-width: 768px) 60vw, 100vw',
                      alt: media.alt
                  }}
                </div>
                {% if section.settings.enable_alt == true and media.alt != product.title %}
                  <div class="type--smaller absolute bottom-0 w-full p-2 text-left whitespace-normal opacity-75">
                    {{ media.alt }}
                  </div>
                {% endif %}
              </div>

            {% when 'external_video' %}
              <div
                class="
                  relative flex-none {{ gallery_ratio_class }} overflow-hidden border--width border--radius snap-center snap-always
                  {{ section.settings.image_border }}
                  w-full
                "
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}"
                data-media-type="external_video"
              >
                <div
                  class="
                    h-full w-full overflow-hidden object-cover
                    {{ section.settings.media_color_scheme }}
                  "
                >
                  <div class="flex h-full w-full items-center">
                    <div class="h-full w-full object-cover">
                      {% if media.host == 'youtube' %}
                        {{
                          media
                          | external_video_url: color: 'white', autoplay: '1', loop: '1', mute: '1', playsinline: '1'
                          | external_video_tag: class: 'h-full max-w-full w-full'
                        }}
                      {% elsif media.host == 'vimeo' %}
                        {{
                          media
                          | external_video_url: autoplay: '1', loop: '1', muted: '1', playsinline: '1'
                          | external_video_tag: class: 'h-full max-w-full w-full'
                        }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>

            {% when 'video' %}
              <div
                class="
                  relative flex-none {{ gallery_ratio_class }} overflow-hidden border--width border--radius snap-center snap-always
                  {{ section.settings.image_border }}
                  w-full
                "
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}"
                data-media-type="video"
              >
                <div
                  class="
                    h-full w-full overflow-hidden object-contain
                    {{ section.settings.media_color_scheme }}
                  "
                >
                  <div class="flex h-full w-full items-center">
                    {{
                      media
                      | video_tag:
                        autoplay: true,
                        loop: true,
                        muted: true,
                        playsinline: true,
                        controls: true,
                        preload: 'auto',
                        class: 'h-full object-contain w-full'
                    }}
                  </div>
                </div>
              </div>

            {% when 'model' %}
              <div
                class="
                  relative flex-none {{ gallery_ratio_class }} overflow-hidden border--width border--radius snap-center snap-always
                  {{ section.settings.image_border }}
                  w-full
                "
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="model"
              >
                <div class="bottom-2 left-2 absolute z-10">
                  {% capture badge_content %}
                    {% render 'component__icon', icon: 'box', size: '16' %}
                  {% endcapture %}
                  {% render 'component__badge', background: 'body', text: 'text', icon: '', content: badge_content %}
                </div>
                <div class="bottom-2 absolute left-auto right-auto z-10 w-full">
                  <button
                    class="btn btn--small btn--secondary"
                    data-shopify-xr
                    data-shopify-model3d-id="{{ media.id }}"
                    data-shopify-title="{{ product.title | escape }}"
                    data-shopify-xr-hidden
                  >
                    {{ 'general.media.view_in_space' | t }}
                  </button>
                </div>
                <div
                  class="
                    h-full w-full overflow-hidden object-contain
                    {{ section.settings.media_color_scheme }}
                  "
                >
                  <div class="flex h-full w-full items-center">
                    {{ media | model_viewer_tag: class: 'w-full h-full' }}
                  </div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {%- comment -%}indicators{%- endcomment -%}
      {% if product.media.size > 1 and product.media.size <= 12 %}
        <div
          class="pointer-events-none absolute bottom-6 left-0 right-0 z-10 flex items-center justify-center gap-3 px-4"
          data-gallery-indicators
          aria-hidden="true"
          x-show="gallery_ready"
          x-cloak
        >
          {% for media in product.media %}
            <span
              class="color__bg-text animation-100 h-2 w-2 shrink-0 rounded-full opacity-25"
              :class="{ '!opacity-100': gallery_index === {{ forloop.index0 }} }"
              data-gallery-indicator="{{ forloop.index0 }}"
              {% if section.settings.enable_variant_images and media.media_type == 'image' %}
                x-show="'{{ media.alt | handle }}'.includes(variantHandle) && !Object.keys(variants).some(candidate => candidate !== variantHandle && candidate.includes(variantHandle) && '{{ media.alt | handle }}'.includes(candidate))"
                x-cloak
              {% endif %}
            ></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
{% if first_3d_model %}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script>
    function setupShopifyXr() {
      if (!window.ShopifyXR) {
        document.addEventListener('shopify_xr_initialized', function () {
          setupShopifyXr();
        });
      } else {
        document.querySelectorAll('[id^="ProductJSON-"]').forEach((modelJSON) => {
          window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
          window.ShopifyXR.setupXRElements();
          modelJSON.remove();
        });
      }
    }

    window.Shopify.loadFeatures([
      {
        name: 'shopify-xr',
        version: '1.0',
        onLoad: setupShopifyXr,
      },
    ]);
  </script>
{% endif %}
