<!-- snippets/product__icon.liquid -->
{% comment %}
  Icon

  Accepts:
    - blocksettings: liquid object of block settings

  Usage:
    {% render 'product__icon',
      blocksettings: block.settings
    %}
{% endcomment %}

<nav
  class="
    type--smaller type__nav flex w-fit shrink-0 items-center justify-center px-4 md:px-0
    {{ section.settings.color_border }}
    {{ blocksettings.color_scheme }}
    {{ blocksettings.style_border }}
  "
  aria-label="{{ blocksettings.content }}"
  style="
    padding-top:{{ blocksettings.spacing_top }}px;
    padding-bottom:{{ blocksettings.spacing_bottom }}px;
  "
>
  {% render 'component__icon', icon: blocksettings.icon, size: '16', class: 'mr-2 opacity-75' %}

  {{ blocksettings.content }}
</nav>
