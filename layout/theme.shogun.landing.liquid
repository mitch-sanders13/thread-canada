{% comment %}
Auto-generated by Shogun.
This file can be re-written at any time.
{% endcomment %}

{% include 'shogun-content-handler' %}
<html class="min-h-[100vh]" lang="{{ request.locale.iso_code }}" x-data="app()" x-init="
    if (window.location.search.includes('?cart')) cart_drawer = true;
    handleSharedCart(); 
    updateCart(false);">
  <head>
    <!-- do not edit or remove- code to remove duplicate slash from URL -->
    <script>
      (function() {
        var path = window.location.pathname;

        // Only fix if there are multiple slashes (but ignore protocol like https://)
        if (path.includes('//')) {
          var cleanPath = path.replace(/\/{2,}/g, '/');
          window.location.replace(cleanPath + window.location.search + window.location.hash);
        }
      })();
    </script>
    <!-- do not edit or remove- code to remove duplicate slash from URL -->
    {% render 'theme__meta' %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_font_heading.system? and settings.type_font_body.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_font_body.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_font_body | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_font_heading.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_font_heading | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- comment -%} Preload logo animation to prevent cold CDN misses {%- endcomment -%}
    <link rel="preload" as="fetch" href="{{ 'logo.json' | asset_url }}" crossorigin>
    {% if template contains "about" %}
      <link rel="stylesheet" href="https://use.typekit.net/cuk8lrh.css">
    {% endif %}
    {% render 'theme__pwa' %}
    {% render 'theme__structured-data' %}
    {% render 'theme__styles' %}
    
    {{ settings.snippet_head }}
    {% render 'assets' with 'styles.css', preload_stylesheet: true %}
    {{ content_for_header }}    

    <script>
      window.Shopify = window.Shopify || {theme: {id: {{ theme.id }}, role: '{{ theme.role }}' } };
      window._template = {
          directory: "{{ template.directory }}",
          name: "{{ template.name }}",
          suffix: "{{ template.suffix }}"
      };
    </script>
    
  
  {% render 'shogun-head' %}
</head>
  <body class="
      min-h-[100vh] break-words 
      {{ template | handle }}
    " x-init="initScroll()" x-intersect.half:enter="scroll_up = false" x-intersect.half:leave="scroll_up = true">
    {% include 'shogun-content-handler' %}

    
    
    {{ content_for_layout }}
    
    <script type="application/ld+json">
        {{ article.metafields.custom.faq_schema.value }}
      </script>
    <style type="text/css">
      body, html {
        width: 100% !important;
        background: white !important;
      }
    </style>
    
  </body>
</html>
