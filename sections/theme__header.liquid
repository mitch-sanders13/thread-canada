<!-- sections/theme__header.liquid -->
{% liquid
  assign enable_homepage_overlay = false
  if request.page_type == 'index'
    assign enable_homepage_overlay = true
  endif

  assign use_dark_homepage_overlay = false
  if section.settings.homepage_overlay_color == 'dark'
    assign use_dark_homepage_overlay = true
  endif

  case section.settings.bar_color_border
    when 'color__border-selected-1'
      assign active_header_border_color = 'var(--color__border-selected-light-1)'
    when '!color__border-transparent'
      assign active_header_border_color = 'transparent'
    else
      assign active_header_border_color = 'var(--color__border-divider-light-1)'
  endcase

  if settings.enable_audio
    assign click_audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();'
  endif
%}

{% capture header_logo %}
  {% render 'header__logo',
    enable_homepage_overlay: enable_homepage_overlay,
    use_dark_homepage_overlay: use_dark_homepage_overlay
  %}
{% endcapture %}

{% capture mobile_menu_label %}
  {% if section.settings.bar_button_menu_type == 'text' %}
    {{ 'general.navigation.menu' | t }}
  {% else %}
    {% render 'component__icon', icon: 'menu', size: '24', class: '' %}
  {% endif %}
{% endcapture %}

{% capture desktop_navigation %}
  <div
    class="header__navigation flex items-center justify-center overflow-x-auto
    type__nav
    {{ settings.type_header_capitilization }}
    "
    x-data="{
      active_dropdown: null,
      hovered_dropdown: null,
      focused_dropdown: null,
      dropdown_timer: null,
      scheduleDropdown() {
        window.clearTimeout(this.dropdown_timer);
        const next_dropdown = this.focused_dropdown !== null ? this.focused_dropdown : this.hovered_dropdown;
        if (this.active_dropdown === next_dropdown) return;
        this.dropdown_timer = window.setTimeout(() => {
          this.active_dropdown = this.focused_dropdown !== null ? this.focused_dropdown : this.hovered_dropdown;
        }, 100);
      },
      hoverDropdown(index) {
        this.hovered_dropdown = index;
        this.scheduleDropdown();
      },
      leaveDropdown() {
        this.hovered_dropdown = null;
        this.scheduleDropdown();
      },
      focusDropdown(index) {
        window.clearTimeout(this.dropdown_timer);
        this.focused_dropdown = index;
        this.active_dropdown = index;
      },
      blurDropdown() {
        this.focused_dropdown = null;
        this.scheduleDropdown();
      }
    }">

    {% assign active_link_count = 0 %}
    {%- for link in section.settings.dropdown_links.links -%}
      {% assign submenu_links = link.links %}
      {% if submenu_links == blank %}
        {% assign submenu_links = linklists[link.handle].links %}
      {% endif %}
      {% assign dropdown_index = 'null' %}
      {% if submenu_links != blank %}
        {% assign dropdown_index = forloop.index %}
      {% endif %}
      {% if link.child_active %}
        {% assign active_link_count = active_link_count | plus: 1 %}
      {% else %}
        {% if link.active %}
          {% assign active_link_count = active_link_count | plus: 1 %}
        {% endif %}
      {% endif %}

      <div
        class="group/dropdown flex-shrink h-full"
        @mouseenter="hoverDropdown({{ dropdown_index }})"
        @mouseleave="leaveDropdown()"
        @focusin="focusDropdown({{ dropdown_index }})"
        @focusout="if (!$el.contains($event.relatedTarget)) blurDropdown()">
        <a 
          href="{{ link.url }}"
          {% if submenu_links != blank %}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="HeaderDropdown-{{ section.id }}-{{ forloop.index }}"
            :aria-expanded="active_dropdown === {{ forloop.index }}"
          {% endif %}
          class="header__link group/link type__nav type--big h-full flex items-center mr-2 block px-4 py-2 md:py-6 no-underline hover:shadow-none hover:!no-underline hover:opacity-100
          {{ settings.type_header_capitilization }}
          {% if active_link_count <= 1 %}
            {% if link.child_active %}shadow-none !no-underline opacity-100{% endif %}
            {% if link.active %}shadow-none !no-underline opacity-100{% endif %}
          {% endif %}
          ">
          <span class="header__link-label type__nav relative inline-block after:absolute after:left-0 after:right-px after:-bottom-[2px] after:h-px after:bg-current after:opacity-0 after:content-[''] group-hover/link:after:opacity-100 group-focus/link:after:opacity-100 group-hover/dropdown:after:opacity-100 group-focus-within/dropdown:after:opacity-100
            {% if active_link_count <= 1 %}
              {% if link.child_active %}after:opacity-100{% endif %}
              {% if link.active %}after:opacity-100{% endif %}
            {% endif %}">{{ link.title }}</span>

        </a>

        {% if submenu_links != blank %}
          <div
            id="HeaderDropdown-{{ section.id }}-{{ forloop.index }}"
            class="header__dropdown pointer-events-none invisible absolute left-0 block w-full overflow-hidden normal-case opacity-0 [transition:opacity_100ms_ease-out,visibility_0s_linear_100ms] group-hover/dropdown:visible group-hover/dropdown:opacity-100 group-hover/dropdown:[transition-delay:100ms,100ms] group-focus-within/dropdown:visible group-focus-within/dropdown:opacity-100 group-focus-within/dropdown:[transition-delay:0s] motion-reduce:![transition-delay:0ms] motion-reduce:![transition-duration:0.01ms]"
            :class="{ '!visible !opacity-100 ![transition-delay:0s]': active_dropdown === {{ forloop.index }} }">
            <div class="pointer-events-auto mx-auto max-w-[900px] rounded-none border--width
              {{ section.settings.dropdown_color_scheme }}
              {{ section.settings.dropdown_color_border }}">

              <div>
                <div class="flex h-[min(500px,calc(100vh-160px))] overflow-hidden">
                  
                  {% comment %} Menu links {% endcomment %}
                  <div class="flex h-full w-1/3 flex-col overflow-hidden px-8 py-4">
                    {% for child_link in submenu_links %}
                      <div>
                        <a
                          href="{{ child_link.url }}"
                          class="type__nav type--big m-0 block py-1.5 whitespace-nowrap no-underline hover:no-underline">
                          {{ child_link.title }}
                        </a>
                        {% for grandchild_link in child_link.links %}
                          <a
                            href="{{ grandchild_link.url }}"
                            class="type__body type--base m-0 block py-1.5 whitespace-nowrap no-underline hover:no-underline">
                            {{ grandchild_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>

                  {% comment %} Menu content images {% endcomment %}
                  <div class="flex h-full min-w-0 flex-grow">
                    {% for block in section.blocks %}
                      {% assign link_handle = link.handle | handle %}
                      {% assign menu_handle = block.settings.menu | handle %}
                      {% if link_handle == menu_handle and block.settings.image != blank %}
                        {% capture dropdown_feature_content %}
                          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'block h-full w-full object-cover' }}
                          {% if block.settings.heading != blank or block.settings.content != blank %}
                            <div class="color__light absolute inset-x-0 bottom-0 z-10 p-6 text-center whitespace-normal">
                              {% if block.settings.heading != blank %}
                                <h3 class="type__nav type--big m-0 break-words">{{ block.settings.heading }}</h3>
                              {% endif %}
                              {% if block.settings.content != blank %}
                                <div class="type__body m-0--clear mt-2 underline underline-offset-4">
                                  {% if block.settings.url != blank %}
                                    {{ block.settings.content | strip_html }}
                                  {% else %}
                                    {{ block.settings.content }}
                                  {% endif %}
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}
                        {% endcapture %}
                        {% if block.settings.url != blank %}
                          <a class="relative block h-full min-w-0 flex-1 overflow-hidden no-underline hover:no-underline" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                            {{ dropdown_feature_content }}
                          </a>
                        {% else %}
                          <div class="relative h-full min-w-0 flex-1 overflow-hidden" {{ block.shopify_attributes }}>
                            {{ dropdown_feature_content }}
                          </div>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>

                </div>
              </div>
              
            </div>
          </div>
        {% endif %}
        
      </div>
    {%- endfor -%}

  </div>
{% endcapture %}

{% capture desktop_actions %}
  <div class="flex items-center justify-end flex-shrink pl-2 text-right">

    {% if section.settings.enable_search %}
      {% if section.settings.bar_button_search_type == "text" %}
        <a
          x-ref="desktopSearchTrigger"
          class="hover:underline inline-flex pl-4 ml-2 no-underline
          type__nav
          {{ settings.type_header_capitilization }}"
          href="{{ routes.search_url }}"
          x-ref="desktopSearchTrigger"
          rel="nofollow"
          @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
          {{ 'general.search.search' | t }}
        </a>
      {% else %}
        <a
          x-ref="desktopSearchTrigger"
          class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
          href="{{ routes.search_url }}"
          x-ref="desktopSearchTrigger"
          rel="nofollow"
          title="{{ 'general.search.search' | t }}"
          @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
          {% render 'component__icon', icon: 'search', size: '24', class: '' %}
        </a>
      {% endif %}
    {% endif %}

    {%- if shop.customer_accounts_enabled -%}
     {% unless section.settings.bar_button_login_type == "none" %}
      {% if section.settings.bar_button_login_type == "text" %}
        <a
          class="hover:underline inline-flex pl-4 ml-2 no-underline
          type__nav
          {{ settings.type_header_capitilization }}"
          href="{{ routes.account_url }}"
          rel="nofollow">
          {% if customer %}
            {{ 'general.navigation.account' | t }}
          {% else %}
            {{ 'customer.account.log_in' | t }}
          {% endif %}

        </a>
      {% else %}
        <a
          class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
          href="{{ routes.account_url }}"
          rel="nofollow"
          title=" {% if customer %}{{ 'general.navigation.account' | t }}{% else %}{{ 'customer.account.log_in' | t }}{% endif %}">
          {% render 'component__icon', icon: 'account', size: '24', class: '' %}
        </a>
      {% endif %}
     {% endunless %}
    {% endif %}

    {% render 'header__cart', display_type: section.settings.bar_button_cart_type, click_audio: click_audio %}

  </div>
{% endcapture %}

<nav
  aria-label="Header Navigation"
  style="--site-header-active-border-color: {{ active_header_border_color }};"
  class="site-header__nav group/header relative isolate m-0 rounded-none !bg-transparent transition-[border-color] duration-100 ease-in-out
    hover:!text-[#212121] hover:![border-color:var(--site-header-active-border-color)]
    [&:has(:focus-visible)]:!text-[#212121] [&:has(:focus-visible)]:![border-color:var(--site-header-active-border-color)]
    [&_a]:!transition-opacity [&_a]:!duration-100 [&_a]:!ease-in-out [&_a]:!delay-0
    [&_button]:!transition-opacity [&_button]:!duration-100 [&_button]:!ease-in-out [&_button]:!delay-0
    border--b-width
    {{ section.settings.visibility }}
    {{ section.settings.bar_color_scheme }}
    {{ section.settings.bar_color_border }}
    {% if enable_homepage_overlay and use_dark_homepage_overlay %}!m-0 !border-transparent !bg-transparent !text-[#212121] !shadow-none{% elsif enable_homepage_overlay %}!m-0 !border-transparent !bg-transparent !text-white !shadow-none{% endif %}
  "
  x-data="{ header_at_top: window.scrollY <= 10 }"
  @scroll.window="header_at_top = window.scrollY <= 10"
  @keydown.escape.window="
    if (search_visible || search_active) {
      $event.preventDefault();
      $event.stopPropagation();
      search_visible = false;
      search_active = false;
      $nextTick(() => {
        const trigger = window.matchMedia('(min-width: 768px)').matches ? $refs.desktopSearchTrigger : $refs.mobileMenuTrigger;
        trigger?.focus();
      });
    } else if (menu_drawer) {
      $event.preventDefault();
      $event.stopPropagation();
      menu_drawer = false;
      menu_nested = false;
      hide_header = false;
    }
  "
  :class="{
    '!m-0 !border-transparent !bg-transparent !text-white !shadow-none': ({{ enable_homepage_overlay | json }} || has_banner_overlap) && header_at_top && !(({{ enable_homepage_overlay | json }} && {{ use_dark_homepage_overlay | json }}) || (!{{ enable_homepage_overlay | json }} && has_banner_overlap && (header_color == 'color__dark' || header_color == 'color__text'))),
    '!m-0 !border-transparent !bg-transparent !text-[#212121] !shadow-none': ({{ enable_homepage_overlay | json }} || has_banner_overlap) && header_at_top && (({{ enable_homepage_overlay | json }} && {{ use_dark_homepage_overlay | json }}) || (!{{ enable_homepage_overlay | json }} && has_banner_overlap && (header_color == 'color__dark' || header_color == 'color__text')))
  }">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-white transition-[clip-path] duration-100 ease-in-out
      {% if enable_homepage_overlay %}[clip-path:inset(0_0_100%_0)]{% else %}[clip-path:inset(0_0_0_0)]{% endif %}
      group-hover/header:![clip-path:inset(0_0_0_0)] group-[:has(:focus-visible)]/header:![clip-path:inset(0_0_0_0)]"
    :class="{
      '[clip-path:inset(0_0_100%_0)]': ({{ enable_homepage_overlay | json }} || has_banner_overlap) && header_at_top,
      '[clip-path:inset(0_0_0_0)]': !(({{ enable_homepage_overlay | json }} || has_banner_overlap) && header_at_top)
    }"></span>
  
  <div class="relative">
    
    {%- comment -%} mobile {%- endcomment -%}
    <div
      class="
        md:hidden flex flex-wrap items-center py-2
        {{ settings.layout_horizontal }}
      ">
      
      {{ header_logo }}

      <div class="ml-auto flex shrink-0 items-center">
        {% render 'header__cart', display_type: section.settings.bar_button_cart_type, is_mobile: true, click_audio: click_audio %}

        <button
          x-ref="mobileMenuTrigger"
          type="button"
          class="type__nav no-js--hide inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-3.5 py-2.5 no-underline {{ settings.type_header_capitilization }}"
          aria-label="{{ 'general.navigation.menu' | t }}"
          aria-expanded="false"
          :aria-expanded="menu_drawer"
          @click="menu_drawer = true; {{ click_audio }}">
          {{ mobile_menu_label }}
        </button>
        <noscript>
          <details>
            <summary
              class="type__nav inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center px-3.5 py-2.5 [&::-webkit-details-marker]:hidden {{ settings.type_header_capitilization }}"
              aria-label="{{ 'general.navigation.menu' | t }}">
              {{ mobile_menu_label }}
            </summary>
            <div class="absolute inset-x-0 top-full z-10 max-h-[70vh] overflow-y-auto border--t-width color__bg-body color__text color__border-divider-1">
              {%- for link in section.settings.dropdown_links.links -%}
                <a
                  class="border--b-width color__border-divider-1 block w-full p-4 no-underline"
                  href="{{ link.url }}"
                >
                  {{- link.title -}}
                </a>
                {% for child_link in link.links %}
                  <a
                    class="border--b-width color__border-divider-1 block w-full p-4 !pl-8 no-underline"
                    href="{{ child_link.url }}"
                  >
                    {{- child_link.title -}}
                  </a>
                  {% for grandchild_link in child_link.links %}
                    <a
                      class="border--b-width color__border-divider-1 block w-full p-4 !pl-12 no-underline"
                      href="{{ grandchild_link.url }}"
                    >
                      {{- grandchild_link.title -}}
                    </a>
                  {% endfor %}
                {% endfor %}
              {%- endfor -%}
            </div>
          </details>
        </noscript>
      </div>

      {%- comment -%}mobile search{%- endcomment -%}
      {% if section.settings.enable_search %}
        {% render 'header__search-mobile' %}
      {% endif %}
      
    </div>

    {%- comment -%} desktop {%- endcomment -%}
    {% if section.settings.enable_search %}
      <div class="hidden md:block">
        {% render 'header__search-desktop' %}
      </div>
    {% endif %}
    <div class="site-header__desktop {{ settings.layout_horizontal }} hidden grid-cols-[1fr_auto_1fr] items-stretch md:grid">
      <div class="flex items-center justify-start py-3">{{ header_logo }}</div>
      {{ desktop_navigation }}
      <div class="flex justify-end">{{ desktop_actions }}</div>
    </div>
    
  </div>
</nav>

{% schema %}
{
  "name": "t:sections.theme_header.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.theme_header.settings.ignored_settings.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__15.content"
    },
    {
      "type": "link_list",
      "id": "dropdown_links",
      "label": "t:sections.theme_header.settings.dropdown_links.label",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "search_links",
      "label": "t:sections.theme_header.settings.search_links.label",
      "info": "t:sections.theme_header.settings.search_links.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__12.content"
    },
    {
      "type": "select",
      "id": "homepage_overlay_color",
      "label": "Homepage overlay color",
      "info": "Choose the header icon and navigation color shown over the homepage banner before scrolling.",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "bar_color_scheme",
      "label": "t:sections.all.colors.settings.color_scheme.label",
      "options": [
        {
          "value": "color__bg-body color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__1.label"
        },
        {
          "value": "color__bg-neutral color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__2.label"
        },
        {
          "value": "color__bg-overlay-1 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__3.label"
        },
        {
          "value": "color__bg-overlay-2 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__4.label"
        },
        {
          "value": "color__bg-overlay-3 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__5.label"
        },
        {
          "value": "color__bg-primary color__primary",
          "label": "t:sections.all.colors.settings.color_scheme.options__6.label"
        },
        {
          "value": "color__bg-secondary color__secondary",
          "label": "t:sections.all.colors.settings.color_scheme.options__7.label"
        },
        {
          "value":"color__bg-tertiary color__tertiary",
          "label":"t:sections.all.colors.settings.color_scheme.options__8.label"
        }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "bar_color_border",
      "label": "t:sections.all.colors.settings.color_border.label",
      "options": [
        {
          "value": "color__border-divider-1",
          "label": "t:sections.all.colors.settings.color_border.options__1.label"
        },
        {
          "value": "color__border-selected-1",
          "label": "t:sections.all.colors.settings.color_border.options__2.label"
        },
        {
          "value": "!color__border-transparent",
          "label": "t:sections.all.colors.settings.color_border.options__3.label"
        }
      ],
      "default": "color__border-divider-1"
    },
    {
      "type": "select",
      "id": "bar_layout_desktop",
      "label": "t:sections.theme_header.settings.bar_layout_desktop.label",
      "options": [
        {
          "value": "left-below",
          "label": "t:sections.theme_header.settings.bar_layout_desktop.options__1.label"
        },
        {
          "value": "left-inline",
          "label": "t:sections.theme_header.settings.bar_layout_desktop.options__2.label"
        },
        {
          "value": "center-below",
          "label": "t:sections.theme_header.settings.bar_layout_desktop.options__3.label"
        }
      ],
      "default": "left-inline"
    },
    {
      "type": "select",
      "id": "bar_button_cart_type",
      "label": "t:sections.theme_header.settings.bar_button_cart_type.label",
      "options": [
        {
          "value": "icon",
          "label": "t:sections.theme_header.settings.bar_button_cart_type.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.theme_header.settings.bar_button_cart_type.options__2.label"
        }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "bar_button_search_type",
      "label": "t:sections.theme_header.settings.bar_button_search_type.label",
      "options": [
        {
          "value": "icon",
          "label": "t:sections.theme_header.settings.bar_button_search_type.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.theme_header.settings.bar_button_search_type.options__2.label"
        }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "bar_button_login_type",
      "label": "t:sections.theme_header.settings.bar_button_login_type.label",
      "options": [
        {
          "value": "icon",
          "label": "t:sections.theme_header.settings.bar_button_login_type.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.theme_header.settings.bar_button_login_type.options__2.label"
        },
        {
          "value": "none",
          "label": "t:sections.theme_header.settings.bar_button_login_type.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bar_button_menu_type",
      "label": "t:sections.theme_header.settings.bar_button_menu_type.label",
      "info": "t:sections.theme_header.settings.bar_button_menu_type.info",
      "options": [
        {
          "value": "icon",
          "label": "t:sections.theme_header.settings.bar_button_menu_type.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.theme_header.settings.bar_button_menu_type.options__2.label"
        }
      ],
      "default": "icon"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "t:sections.theme_header.settings.enable_search.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__18.content"
    },
    {
      "type": "select",
      "id": "dropdown_color_scheme",
      "label": "t:sections.all.colors.settings.color_scheme.label",
      "options": [
        {
          "value": "color__bg-body color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__1.label"
        },
        {
          "value": "color__bg-neutral color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__2.label"
        },
        {
          "value": "color__bg-overlay-1 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__3.label"
        },
        {
          "value": "color__bg-overlay-2 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__4.label"
        },
        {
          "value": "color__bg-overlay-3 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__5.label"
