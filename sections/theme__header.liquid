<!-- sections/theme__header.liquid -->
{% comment %}
{% endcomment %}


{% capture desktop_logo %}
  <div class="md:py-4 flex items-center max-w-xs py-2{% if section.settings.bar_layout_desktop == "center-below" %}justify-center{% endif %}">
    <a class="inline-block relative items-center h-[45px] w-[45px] hover:!opacity-100"
      style="background: #000;"
      href="{{ routes.root_url }}" 
      rel="nofollow"
      title="{{ shop.name }}">
      {%- comment -%} Fallback SVG logo shown immediately while animation loads {%- endcomment -%}
      <img 
        class="absolute top-0 left-0 w-full h-full"
        id="logo-fallback"
        src="{{ "threadwallets-logomark.svg" | asset_url }}" 
        alt="Thread Wallets logo"
        style="opacity: 1; transition: opacity 0.3s ease;">
      <noscript>
        <img 
          class="absolute top-0 left-0 w-full h-full" 
          src="{{ "threadwallets-logomark.svg" | asset_url }}" 
          alt="Thread Wallets logo">
      </noscript>
      {%- comment -%} Self-hosted lottie-player v2.0.2 (pinned version) {%- endcomment -%}
      <script src="{{ 'lottie-player-2.0.2.js' | asset_url }}" defer></script>
      <lottie-player 
        id="logo-animation"
        src="{{ 'logo.json' | asset_url }}" 
        background="transparent" 
        speed="2" 
        style="width: 100%; height: 100%; opacity: 0; transition: opacity 0.3s ease;" 
        direction="1" 
        mode="normal" 
        autoplay></lottie-player>
      <script>
        {%- comment -%} Hide fallback and show animation once loaded {%- endcomment -%}
        (function() {
          var animation = document.getElementById('logo-animation');
          var fallback = document.getElementById('logo-fallback');
          if (animation && fallback) {
            animation.addEventListener('load', function() {
              animation.style.opacity = '1';
              fallback.style.opacity = '0';
              setTimeout(function() {
                fallback.style.display = 'none';
              }, 300);
            });
            {%- comment -%} Fallback timeout - if animation doesn't load in 3 seconds, keep showing static logo {%- endcomment -%}
            setTimeout(function() {
              if (animation.style.opacity === '0') {
                console.warn('Logo animation failed to load, keeping static fallback');
              }
            }, 3000);
          }
        })();
      </script>
    </a>
  </div>
{% endcapture %}

{% capture desktop_navigation %}
  <div class="flex flex-wrap items-center overflow-x-auto
    type__nav
    {{ settings.type_header_capitilization }}
    {% if section.settings.bar_layout_desktop == "center-below" %}w-full justify-center{% endif %}
    {% if section.settings.bar_layout_desktop == "left-below" %}w-full{% endif %}
    {% if section.settings.bar_layout_desktop == "left-inline" %}pl-6 flex-grow{% endif %}">

    {% assign activeLinkCounter = 0 %}
    {%- for link in section.settings.dropdown_links.links -%}
      {% if link.child_active %}
        {% assign activeLinkCounter = activeLinkCounter | plus: 1 %}
      {% else %}
        {% if link.active %}
          {% assign activeLinkCounter = activeLinkCounter | plus: 1 %}
        {% endif %}
      {% endif %}

      <div class="flex-shrink h-full">
        <a 
          href="{{ link.url }}"
          onclick=""
          class="header__link type__nav type--small h-full flex items-center mr-2 block no-underline hover:no-underline
          {{ settings.type_header_capitilization }}
          {% if section.settings.bar_layout_desktop == "center-below" %}px-4 md:py-6 py-2 type--small{% endif %}
          {% if section.settings.bar_layout_desktop == "left-below" %}pr-4 pt-2 pb-4 type--small{% endif %}
          {% if section.settings.bar_layout_desktop == "left-inline" %}px-4 md:py-6 py-2{% endif %}
          {% if activeLinkCounter <= 1 %}
            {% if link.child_active %}header__link--hover{% endif %}
            {% if link.active %}header__link--hover{% endif %}
          {% endif %}
          {% if section.settings.bar_layout_desktop == "center-below" %}
            px-4 mx-2
          {% else %}
            mr-2 pr-4
          {% endif %}">
          {{ link.title }}

          {%- comment -%}
            {% if link.levels >= 1 %}
                {% render 'component__icon', icon: 'chevron-down', class: 'ml-1', size: '16' %}
            {% endif %}
          {%- endcomment -%}
        </a>

        {% if link.levels >= 1 %}
          <div class="header__dropdown animation-300 absolute left-0 block w-full h-0 overflow-hidden normal-case opacity-0">
            <div class="border--t-width border--b-width
              {{ section.settings.dropdown_color_scheme }}
              {{ section.settings.dropdown_color_border }}"
              x-data="{ 
                active_link: '' 
              }">

              <div class="{{ settings.layout_horizontal }}">
                <div class="flex overflow-hidden 
                  {{ section.settings.dropdown_color_border }}">
                  
                  {% comment %} Menu links {% endcomment %}
                  <div class="flex flex-wrap">
                    {% for child_link in link.links %}
                      <div class="py-8 pr-24">
                        <a 
                          href="{{ child_link.url }}" 
                          class="type__nav type--small hover:no-underline block mb-4 no-underline whitespace-nowrap"
                          {% if child_link.url contains 'collections' %}
                            x-init="
                              if (window.innerWidth >= 768) {
                                fetchAndRenderProductSlider('{{ child_link.url | remove_first: '/collections/' }}', 'js:dropdownSlider-{{ child_link.title | handle }}');
                                active_link = '{{ child_link.title | handle }}';
                              }
                            "
                            @mouseover="
                              active_link = '{{ child_link.title | handle }}';
                            "
                          {% endif %}>
                          {{ child_link.title }}
                        </a>
                        {% for grandchild_link in child_link.links %}
                          <a 
                            href="{{ grandchild_link.url }}" 
                            class="type__body hover:no-underline block mb-2 no-underline whitespace-nowrap"
                            {% if grandchild_link.url contains 'collections' %}
                              x-init="
                                if (window.innerWidth >= 768) {
                                  fetchAndRenderProductSlider('{{ grandchild_link.url | remove_first: '/collections/' }}', 'js:dropdownSlider-{{ grandchild_link.title | handle }}');
                                }
                              "
                              @mouseover="
                                active_link = '{{ grandchild_link.title | handle }}';
                              "
                            {% endif %}>
                            {{ grandchild_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>

                  {% comment %} Dynamic product slider containers {% endcomment %}
                  {% for child_link in link.links %}
                    {% if child_link.url contains 'collection' %}
                      <div 
                        id="js:dropdownSlider-{{ child_link.title | handle }}"
                        class="py-8 flex-grow border--l-width color__border-divider-1"
                        x-show="active_link == '{{ child_link.title | handle }}'"
                        x-cloak>
                        <span class="type__nav type--small px-4 pb-2 block">{{ child_link.title }}</span>
                        <div class="flex whitespace-nowrap md:snap-x scroll-smooth hidescrollbar w-full px-4 overflow-x-auto overflow-y-hidden"
                          style="
                            column-gap: {{ settings.layout_gap_size }}px;
                            row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;">
                          <div class="snap-center md:w-[22%] flex justify-center flex-none w-8/12">
                            {% render 'component__skeleton-grid-item' %}
                          </div>
                          <div class="snap-center md:w-[22%] flex justify-center flex-none w-8/12">
                            {% render 'component__skeleton-grid-item' %}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                    {% for grandchild_link in child_link.links %}
                      {% if grandchild_link.url contains 'collection' %}
                        <div 
                          id="js:dropdownSlider-{{ grandchild_link.title | handle }}"
                          class="py-8 flex-grow border--l-width color__border-divider-1"
                          x-show="active_link == '{{ grandchild_link.title | handle }}'"
                          x-cloak>
                          <span class="type__nav type--small px-4 pb-2 block">{{ grandchild_link.title }}</span>
                          <div class="flex whitespace-nowrap md:snap-x scroll-smooth hidescrollbar w-full px-4 overflow-x-auto overflow-y-hidden"
                            style="
                              column-gap: {{ settings.layout_gap_size }}px;
                              row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;">
                            <div class="snap-center md:w-[22%] flex justify-center flex-none w-8/12">
                              {% render 'component__skeleton-grid-item' %}
                            </div>
                            <div class="snap-center md:w-[22%] flex justify-center flex-none w-8/12">
                              {% render 'component__skeleton-grid-item' %}
                            </div>
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                  
                  {%- comment -%}slider{%- endcomment -%}
                  {% assign block_count = 0 %}
                  {% for block in section.blocks %}
                    {% assign link_handle = link.handle | handle %}
                    {% assign menu_handle = block.settings.menu | handle %}
                    {% if link_handle == menu_handle %}
                      {% assign block_count = block_count | plus: 1 %}
                    {% endif %}
                  {% endfor %}
                  
                  {% if block_count > 0 %}
                    {%- capture slides -%}
                      {% assign block_count = 0 %}
                      {% for block in section.blocks %}
                        {% assign link_handle = link.handle | handle %}
                        {% assign menu_handle = block.settings.menu | handle %}
                        {% if link_handle == menu_handle %}
                          {% assign block_count = block_count | plus: 1 %}
                          <div class="snap-center flex justify-center flex-none max-w-[350px] whitespace-normal" 
                            x-intersect:enter.full="index = {{ block_count | minus: 1 }};"
                            x-bind:data-slide="{{ block_count | minus: 1 }}">
                            {% render 'component__card', 
                              url: block.settings.url,
                              image: block.settings.image,
                              title: block.settings.heading, 
                              content: block.settings.content %}
                          </div>
                        {% endif %}
                      {% endfor %}  
                      {%- capture outer_class -%}
                        py-8 max-w-[50%]
                      {%- endcapture -%}
                    {%- endcapture -%}

                    {%- if block_count > 2 -%}
                      {%- capture show_arrows -%}true{%- endcapture -%}
                    {%- else -%}
                      {%- capture show_arrows -%}{%- endcapture -%}
                    {%- endif -%}

                    {%- if block_count > 0 -%}
                      {% assign block_count = block_count | minus: 1 %}
                    {%- endif -%}

                    {% render 'component__slider',
                      show_arrows: show_arrows,
                      outer_class: outer_class,
                      container_class: '',
                      slider_size: block_count,
                      slides: slides %}
                      
                  {% endif %}

                </div>
              </div>
              
            </div>
          </div>
        {% endif %}
        
      </div>
    {%- endfor -%}

  </div>
{% endcapture %}

{% capture desktop_search %}
  {% if section.settings.enable_search %}
    {% render 'header__search-desktop' %} 
  {% endif %}
{% endcapture %}

{% capture desktop_actions %}
  <div class="flex items-center justify-end flex-shrink pl-2 text-right">

    {% if section.settings.enable_search %}
      {% if section.settings.bar_layout_desktop == "left-inline" %}
        {% if section.settings.bar_button_search_type == "text" %}
          <a
            class="hover:underline inline-flex pl-4 ml-2 no-underline
            type__nav
            {{ settings.type_header_capitilization }}"
            href="{{ routes.search_url }}"
            rel="nofollow"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {{ 'general.search.search' | t }}
          </a>
        {% else %}
          <a
            class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
            href="{{ routes.search_url }}"
            rel="nofollow"
            title="{{ 'general.search.search' | t }}"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {% render 'component__icon', icon: 'search', size: '24', class: '' %} 
          </a>
        {% endif %}
      {% endif %}
    {% endif %}

    {%- if shop.customer_accounts_enabled -%}
     {% unless section.settings.bar_button_login_type == "none" %}
      {% if section.settings.bar_button_login_type == "text" %}
        <a
          class="hover:underline inline-flex pl-4 ml-2 no-underline
          type__nav
          {{ settings.type_header_capitilization }}"
          href="{{ routes.account_url }}"
          rel="nofollow">
          {% if customer %}
            {{ 'general.navigation.account' | t }}
          {% else %}
            {{ 'customer.account.log_in' | t }}
          {% endif %}

        </a>
      {% else %}
        <a
          class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
          href="{{ routes.account_url }}"
          rel="nofollow"
          title=" {% if customer %}{{ 'general.navigation.account' | t }}{% else %}{{ 'customer.account.log_in' | t }}{% endif %}">
          {% render 'component__icon', icon: 'account', size: '24', class: '' %} 
        </a>
      {% endif %}
     {% endunless %}
    {% endif %}

    {% if section.settings.bar_button_cart_type == "text" %}
      <a
        class="inline-flex pl-4 ml-2 no-underline items-center
        type__nav
        {{ settings.type_header_capitilization }}"
        {% if settings.enable_audio %}
          {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
        {% endif %}
        {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}
        {% if settings.enable_audio %}  {% endif %} 
        href="{{ routes.cart_url }}"
        rel="nofollow"
        >
        {{ 'cart.general.title' | t }} 
        <span class="ml-1
        type__nav
        {{ settings.type_header_capitilization }}" 
          x-show="cart.item_count > 0" 
          x-cloak>(<span class="
          type__nav
          {{ settings.type_header_capitilization }}" x-text="cart.item_count">{{ cart.item_count }}</span>)</span>
      </a>
    {% else %}
      <a
        class="type__nav relative inline-flex items-center pl-4 ml-2 !no-underline"
        href="{{ routes.cart_url }}"
        rel="nofollow"
        title="{{ 'cart.general.title' | t }}"
        {% if settings.enable_audio %}
          {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
        {% endif %}
        {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}>
        {% render 'component__icon', icon: 'cart', size: '24', class: '' %} 
        <span 
          class="type__nav type--smaller color__bg-primary color__primary ml-1 px-2 py-0.5 border__button--radius"
          x-show="cart.item_count > 0" 
          x-cloak>
          <span class="type__nav" x-text="cart.item_count">{{ cart.item_count }}</span>
        </span>
      </a>
    {% endif %}

  </div>
{% endcapture %}

{% capture desktop_actions--minor %}
  <div class="basis-0 flex items-center justify-start flex-grow flex-shrink pr-2
    {% if section.settings.bar_layout_desktop == "center-below" %}grow-0{% endif %}">

    {% if section.settings.enable_search %}
      {% unless section.settings.bar_layout_desktop == "left-below" %}
        {% if section.settings.bar_button_search_type == "text" %}
          <a
            class="hover:underline inline-flex pl-0 ml-0 no-underline
            type__nav
            {{ settings.type_header_capitilization }}"
            href="{{ routes.search_url }}"
            rel="nofollow"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {{ 'general.search.search' | t }}
          </a>
        {% else %}
          <a
            class="type__nav hover:underline inline-flex pl-0 ml-0 no-underline"
            href="{{ routes.search_url }}"
            rel="nofollow"
            title="{{ 'general.search.search' | t }}"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {% render 'component__icon', icon: 'search', size: '24', class: '' %} 
          </a>
        {% endif %}
      {% endunless %}
    {% endif %}
    
  </div>
{% endcapture %}

{% capture desktop_search %}
  {% if section.settings.enable_search %}
    {% render 'header__search-desktop' %} 
  {% endif %}
{% endcapture %}

<nav
  aria-label="Header Navigation"
  class="
    border--b-width
    {{ section.settings.visibility }}
    {{ section.settings.bar_color_scheme }}
    {{ section.settings.bar_color_border }}
  ">
  
  <div class="relative">
    
    {%- comment -%} mobile {%- endcomment -%}
    <div
      class="
        xl:hidden flex flex-wrap items-center py-2
        {{ settings.layout_horizontal }}
      ">
      
      {%- comment -%} mobile bar- left {%- endcomment -%}
      <div class="basis-0 flex items-center justify-start flex-grow flex-shrink">
        {% if section.settings.bar_button_menu_type == 'text' %}
          <button
            class="
              no-js--hide inline-flex py-2 pr-4 mr-2 no-underline
              type__nav
              {{ settings.type_header_capitilization }}
            "
            @click="
              menu_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}
            ">
            {{ 'general.navigation.menu' | t }}
          </button>
        {% else %}
          <button
            @click="menu_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}"
            class="type__nav no-js--hide inline-flex py-2 pr-4 mr-2 no-underline"
            title="{{ 'general.navigation.menu' | t }}">
            {% render 'component__icon', icon: 'menu', size: '24', class: '' %}
          </button>
        {% endif %}
        <noscript>
          {% if section.settings.bar_button_menu_type == 'text' %}
            <button
              class="type__nav peer inline-flex py-2 pr-4 mr-2 no-underline"
              @click="menu_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}"
            >
              {{ 'general.navigation.menu' | t }}
            </button>
          {% else %}
            <button
              @click="menu_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}"
              class="type__nav peer inline-flex py-2 pr-4 mr-2 no-underline"
              title="{{ 'general.navigation.menu' | t }}"
            >
              {% render 'component__icon',
                icon: 'menu',
                size: '24',
                class: ''
              %}
            </button>
          {% endif %}
          <div class="peer-focus:block hover:block focus-within:block hidden bottom-0 fixed color__bg-body w-full left-0 right-0 -z-10 max-h-[70vh] mt-28 border--t-width color__border-divider-1 overflow-scroll">
            {%- for link in section.settings.dropdown_links.links -%}
              <a
                class="border--b-width color__border-divider-1 block w-full p-4 no-underline"
                href="{{ link.url }}"
              >
                {{- link.title -}}
              </a>
              {% for child_link in link.links %}
                <a
                  class="border--b-width color__border-divider-1 block w-full p-4 !pl-8 no-underline"
                  href="{{ child_link.url }}"
                >
                  {{- child_link.title -}}
                </a>
                {% for grandchild_link in child_link.links %}
                  <a
                    class="border--b-width color__border-divider-1 block w-full p-4 !pl-12 no-underline"
                    href="{{ grandchild_link.url }}"
                  >
                    {{- grandchild_link.title -}}
                  </a>
                {% endfor %}
              {% endfor %}
            {%- endfor -%}
          </div>
        </noscript>
      </div>

      {% comment %} mobile logo {% endcomment %}
      <div class="flex items-center max-w-[45%] sm:max-w-[70%]">
        <a
          class="inline-block relative items-center"
          style=""
          href="{{ routes.root_url }}"
          rel="nofollow"
          title="{{ shop.name }}">
            <img 
              src="{{ "thread-logo-black.svg" | asset_url }}"
              alt="Thread Wallets logo"
              style="height:30px">
        </a>
      </div>
      
      {% comment %}
        mobile bar - right: cart only. Account / login is in the mobile menu drawer (theme__menu) — not in the top bar.
        Login button setting still controls the xl+ header account in desktop_actions.
      {% endcomment %}
      <div class="basis-0 flex items-center justify-end flex-grow flex-shrink text-right">
        {% if section.settings.bar_button_cart_type == 'text' %}
          <a
            class="
              inline-flex py-2 pl-4 ml-2 no-underline
              type__nav
              {{ settings.type_header_capitilization }}
            "
            href="{{ routes.cart_url }}"
            rel="nofollow"
            {% if settings.enable_audio %}
              {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
            {% endif %}
            {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}>
            {{ 'cart.general.title' | t }}
            <span
              class="
                ml-1
                type__nav
                {{ settings.type_header_capitilization }}
              "
              x-show="cart.item_count > 0"
              x-cloak
              >(<span
                class="
                  type__nav
                  {{ settings.type_header_capitilization }}
                "
                x-text="cart.item_count"
              >
                {{- cart.item_count -}}</span
              >)
            </span>
          </a>
        {% else %}
          <a
            class="type__nav relative inline-flex items-center py-2 pl-4 ml-2 no-underline"
            href="{{ routes.cart_url }}"
            rel="nofollow"
            title="{{ 'cart.general.title' | t }}"
            {% if settings.enable_audio %}
              {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
            {% endif %}
            {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}>
            {% render 'component__icon', icon: 'cart', size: '24', class: '' %}
            <span
              class="type__nav type--smaller color__bg-primary color__primary ml-1 px-2 py-0.5 border__button--radius"
              x-show="cart.item_count > 0"
              x-cloak
            >
              <span class="type__nav" x-text="cart.item_count">
                {{- cart.item_count -}}
              </span>
            </span>
          </a>
        {% endif %}
      </div>

      {%- comment -%}mobile search{%- endcomment -%}
      {% if section.settings.enable_search %}
        {% render 'header__search-mobile' %}
      {% endif %}
      
    </div>

    {%- comment -%} desktop {%- endcomment -%}
    <div
      class="
        xl:flex items-stretch justify-between hidden
        {{ settings.layout_horizontal }}
        {% if section.settings.bar_layout_desktop == "left-inline" %}
          flex-nowrap
        {% endif %}
        {% if section.settings.bar_layout_desktop == "left-below" %}
          flex-wrap
        {% endif %}
        {% if section.settings.bar_layout_desktop == "center-below" %}
          flex-wrap
        {% endif %}
      ">
      
      {% if section.settings.bar_layout_desktop == 'left-inline' %}
        {{ desktop_search }}
        {{ desktop_logo }}
        {{ desktop_navigation }}
        {{ desktop_actions }}
      {% endif %}

      {% if section.settings.bar_layout_desktop == 'left-below' %}
        {{ desktop_logo }}
        {{ desktop_search }}
        {{ desktop_actions }}
        {{ desktop_navigation }}
      {% endif %}

      {% if section.settings.bar_layout_desktop == 'center-below' %}
        {{ desktop_search }}
        {{ desktop_actions--minor }}
        {{ desktop_logo }}
        {{ desktop_actions }}
        {{ desktop_navigation }}
      {% endif %}
    </div>
    
  </div>
</nav>

{% schema %}
{
  "name": "t:sections.theme_header.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.header__15.content"
    },
    {
      "type": "link_list",
      "id": "dropdown_links",
      "label": "t:sections.theme_header.settings.dropdown_links.label",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "search_links",
      "label": "t:sections.theme_header.settings.search_links.label",
      "info": "t:sections.theme_header.settings.search_links.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__12.content"
    },
    {
      "type": "select",
      "id": "bar_color_scheme",
      "label": "t:sections.all.colors.settings.color_scheme.label",
      "options": [
        {
          "value": "color__bg-body color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__1.label"
        },
