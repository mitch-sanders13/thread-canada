<!-- sections/quick-add.liquid -->
{% comment %}
  Use section rendering API to load and inject quick-add form for product thumbnails.

  Globals:
    - settings.thumbmails_color_scheme: color scheme of thumbnails
    - settings.type_seperator: setting to pick the type of seperator between text
    - settings.enable_quick_image: boolean to enable/disable image in quick add popup
    - settings.enable_thumbnails_product_type: boolean to enable product type
    - settings.enable_thumbnails_vendor: boolean to enable vendor
    - settings.enable_thumbnails_variant_count: boolean to enable variant count
    - settings.product_variant_selection: set variants style to dropdown or buttons

  Pro tips:
    - Use variant dropdown selectors for products that have lots of variant options.
{% endcomment %}
{% if settings.enable_unavailable_options %}
  {%- liquid
    assign variants_available_arr = product.variants | map: 'available'
    assign variants_option1_arr = product.variants | map: 'option1'
    assign variants_option2_arr = product.variants | map: 'option2'
    assign variants_option3_arr = product.variants | map: 'option3'
  -%}
{% endif %}

{% assign quick_add_title = product.title %}
{% assign quick_add_type = product.type %}
{% assign quick_add_title_parts = product.title | split: ' - ' %}
{% if quick_add_title_parts.size > 1 %}
  {% assign quick_add_title = quick_add_title_parts | first %}
  {% assign quick_add_type = quick_add_title_parts | last %}
{% endif %}

<dialog
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-hidden border-0 bg-transparent p-0"
  aria-labelledby="QuickAddTitle-{{ product.id }}"
  data-quick-add-dialog
  @cancel="theme_scroll = true;"
  @close="theme_scroll = true;"
>
  <div class="flex items-end justify-center min-h-screen px-4 pt-4 text-center sm:block sm:p-0">
    <div
      class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"
      @click="$el.closest('dialog').close(); theme_scroll = true;"
      aria-hidden="true"
    ></div>
    <div
      class="
        md:left-5 md:bottom-auto md:right-5 md:top-1/2 md:align-middle md:-translate-y-1/2 absolute bottom-0 left-0 right-0 inline-block m-auto text-left align-bottom transition-all transform
        {% if settings.enable_quick_image %}
          md:max-w-[80vw]
        {% else %}
          md:max-w-md
        {% endif %}
      "
    >
      <div class="">
        <button
          type="button"
          class="btn color__light btn--smaller !bg-transparent !border-0 !pl-0"
          aria-label="{{ 'general.navigation.close' | t | escape }}"
          autofocus
          @click="$el.closest('dialog').close()"
        >
          {% render 'component__icon', icon: 'x', size: '24', class: '' %}
        </button>
      </div>

      <div
        class="mobile-border--radius-b-0 color__bg-body color__text border--radius overflow-y-auto shadow-lg max-h-[90vh]"
        x-data="{ button_loading: false }"
      >
        {%- capture script_product -%}
          {% render 'script__product' %}
        {%- endcapture -%}
        <div
          x-data="{{ script_product }}"
        >
          <form
            class="flex flex-wrap items-stretch"
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            @submit.prevent="
              addCartItem(defaultVariantId, defaultSellingPlanId, quantity, true);
              button_loading = true;
              $el.closest('dialog').close();
              setTimeout(function(){ button_loading = false}, 500);
            "
            x-ref="formContainer"
            @change="handleForm(true);"
          >
            {%- comment -%}images{%- endcomment -%}
            {% if settings.enable_quick_image %}
              <div class="md:w-1/2 relative w-full md:max-h-full max-h-[50vh]">
                <div
                  class="
                    !sticky top-0 h-full w-full md:max-h-[80vh] object-cover flex items-center
                    {{ settings.thumbmails_color_scheme }}
                  "
                >
                  {%- unless product.featured_image == blank %}
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        style: 'object-fit:cover',
                        class: 'w-full h-full object-cover md:max-h-full max-h-[50vh]',
                        loading: 'lazy',
                        alt: product.title
                    }}
                  {%- endunless -%}
                </div>
                <div class="absolute left-0 right-0 text-center md:hidden bottom-4">
                  <button
                    type="button"
                    aria-label="Arrow down"
                    class="shadow-md btn btn--plain btn--smaller"
                    x-data="{ scroll: () => { $el.scrollTo(0, $el.scrollHeight); }}"
                    x-init="scroll()"
                    @click="scroll()"
                  >
                    {% render 'component__icon',
                      icon: 'arrow-down',
                      size: '20',
                      class: ''
                    %}
                  </button>
                </div>
              </div>
            {% endif %}

            <div
              class="
                flex w-full flex-col
                {% if settings.enable_quick_image %}
                  md:w-1/2
                {% endif %}
              "
            >
              {%- comment -%}details{%- endcomment -%}
              <div class="relative z-10 flex items-end justify-between p-4 border--b-width color__border-divider-1 color__bg-body">
                <div>
                  <h3
                    id="QuickAddTitle-{{ product.id }}"
                    class="type__body type--small m-0 break-words p-0 normal-case"
                  >
                    {{- quick_add_title -}}
                  </h3>
                  {% if quick_add_type != blank %}
                    <p class="type__body type--small m-0 p-0 opacity-60">
                      {{ quick_add_type }}
                    </p>
                  {% endif %}
                  <div class="type__body type--small m-0 flex flex-wrap items-center gap-2 p-0">
                    <span
                      x-html="Shopify.formatMoney(defaultVariantPrice)"
                    >
                      {{- product.selected_or_first_available_variant.price | money -}}
                    </span>
                    <span
                      class="line-through opacity-60"
                      x-show="defaultVariantComparePrice > defaultVariantPrice"
                      x-html="Shopify.formatMoney(defaultVariantComparePrice)"
                    ></span>
                  </div>
                  <a
                    href="{{ product.url }}"
                    class="btn btn--smaller btn--plain mt-2"
                  >
                    {{- 'products.general.learn_more' | t -}}
                  </a>
                </div>
              </div>

              {%- comment -%} Variants {%- endcomment -%}
              <div
                class="
                  flex shrink-0 p-4 no-js--hide
                  {% if product.variants.size <= 1 %}
                    hidden
                  {% endif %}
                "
              >
                <p
                  class="mb-2 type--small"
                  x-show="choosing && buttonDisabled"
                  x-cloak
                >
                  {{ 'products.general.options_prompt' | t }}
                </p>

                {% for product_option in product.options_with_values %}
                  <div
                    class="
                      w-full
                      {% if product_option.values.size <= 1 %}hidden{% endif %}
                    "
                  >
                    {% assign option_size = product_option.values.size
                      | plus: 0
                    %}

                    {% comment %} Label and popup {% endcomment %}
                    <div class="flex justify-between mb-2">
                      <label
                        class="flex opacity-75 type--small"
                        for="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
                      >
                        {{ product_option.name }}
                        {% for value in product_option.values %}
                          <span
                            x-model="{{ product_option.name | handle | remove: '-' }}"
                            class="ml-1"
                            :class="
                              {
                                'inline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                                'hidden' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                              }
                            "
                            x-cloak
                            >: {{ value -}}
                          </span>
                        {% endfor %}
                      </label>

                      {% capture option_handle %}{{ product_option.name | handle | remove: '-' }}{% endcapture %}
                      {% for block in section.blocks %}
                        {%- case block.type -%}
                          {%- when 'popup' -%}
                            {% if block.settings.option == option_handle %}
                              <div x-data="{ drawer: false }">
                                <button
                                  class="flex underline opacity-75 type--smaller"
                                  type="button"
                                  @click="drawer = true; hide_header = true;"
                                >
                                  {{ block.settings.title }}
                                </button>
                                {% capture drawer_content %}
                                  <div class="sticky top-0 flex flex-wrap items-center justify-between px-4 py-2 border--b-width color__border-divider-1 color__bg-body">
                                    <div>
                                      <button class="btn-close-dark btn--smaller"
                                        type="button"
                                        title="{{ 'general.navigation.close' | t }}"
                                        @click="drawer = false; hide_header = false;">
                                        {% render 'component__icon', icon: 'x', size: '24', class: '' %}
                                      </button>
                                    </div>
                                    <div class="text-right">
                                      {{ block.settings.title }}
                                    </div>
                                  </div>
                                  <div class="p-4">
                                    {{ block.settings.page.content }}
                                  </div>
                                {% endcapture %}
                                {% render 'component__drawer',
                                  drawer_id: 'drawer',
                                  position: 'right',
                                  content: drawer_content
                                %}
                              </div>
                            {% endif %}
                        {%- endcase -%}
                      {% endfor %}
                    </div>

                    {%- assign color = 'general.color.color' | t -%}
                    {%- assign colorDowncase = color | downcase -%}

                    {% comment %} Color options {% endcomment %}
                    {%- if product_option.name == color
                      or product_option.name == colorDowncase
                      or product_option.name == 'Colour'
                      or product_option.name == 'colour'
                    -%}
                      {% if settings.product_color_selection == 'swatches' %}
                        <div class="grid w-full grid-cols-8 gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
                          {% for value in product_option.values %}
                            {% if settings.enable_unavailable_options %}
                              {%- liquid
                                assign option_disabled = true

                                for option1_name in variants_option1_arr
                                  case product_option.position
                                    when 1
                                      if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                            {% endif %}

                            {%- capture swatch_image_filename -%}swatch-{{ value | handle }}.jpg{%- endcapture -%}
                            {% assign swatch_image = images[swatch_image_filename] %}
                            <button
                              type="button"
                              class="btn btn--plain btn--small aspect-square !h-auto !min-h-0 !min-w-0 !w-full !rounded-full bg-center bg-cover bg-no-repeat"
                              aria-label="{{ product_option.name | escape }}: {{ value | escape }}"
                              :aria-pressed="{{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}'"
                              {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                                x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                              {% endif %}
                              :class="
                                {
                                  {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                                    'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                                  {% elsif settings.enable_unavailable_options %}
                                    'strikethrough': {{ option_disabled }},
                                  {% endif %}
                                  '!border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                                }
                              "
                              style="
                                background-color: {{ value | handle }};
                                {% if swatch_image contains '.jpg' %}
                                  background-image: url('{{ swatch_image | image_url: width: 128 }}');
                                {% endif %}
                              "
                              @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
                              {% if option_size <= 1 %}
                                x-init="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
                              {% endif %}
                            ></button>
                          {% endfor %}
                        </div>
                      {% elsif settings.product_color_selection == 'buttons' %}
                        <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
                          {% for value in product_option.values %}
                            {% if settings.enable_unavailable_options %}
                              {%- liquid
                                assign option_disabled = true

                                for option1_name in variants_option1_arr
                                  case product_option.position
                                    when 1
                                      if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                            {% endif %}
                            <button
                              type="button"
                              class="btn btn--plain btn--small"
                              {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                                x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                              {% endif %}
                              :class="
                                {
                                  {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                                    'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                                  {% elsif settings.enable_unavailable_options %}
                                    'strikethrough': {{ option_disabled }},
                                  {% endif %}
                                  'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                                  'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                                }
                              "
                              @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
                            >
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      {% else %}
                        <select
                          @change="handleForm()"
                          class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
                          :class="{ '!border-rose-500': choosing }"
                          id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
                          x-model="{{ product_option.name | handle | remove: '-' }}"
                        >
                          <option disabled selected value="">
                            {{ 'products.general.choose_option' | t }}
                          </option>
                          {% for value in product_option.values %}
                            {% if settings.enable_unavailable_options %}
                              {%- liquid
                                assign option_disabled = true

                                for option1_name in variants_option1_arr
                                  case product_option.position
                                    when 1
                                      if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                            {% endif %}
                            <option
                              value="{{ value | handle }}"
                              {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                                :disabled="!optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                              {% endif %}
                            >
                              {{ value }}
                              {% if settings.enable_unavailable_options
                                and option_disabled
                              %}
                                - {{ 'products.general.sold_out' | t -}}
                              {%- endif %}
                            </option>
                          {% endfor %}
                        </select>
                      {% endif %}

                      {% comment %} All other options {% endcomment %}
                    {% else %}
                      {% if settings.product_variant_selection == 'dropdowns' %}
                        <select
                          @change="handleForm()"
                          class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
                          :class="{ '!border-rose-500': choosing }"
                          id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
                          x-model="{{ product_option.name | handle | remove: '-' }}"
                        >
                          <option disabled selected value="">
                            {{ 'products.general.choose_option' | t }}
                          </option>
                          {% for value in product_option.values %}
                            {% if settings.enable_unavailable_options %}
                              {%- liquid
                                assign option_disabled = true

                                for option1_name in variants_option1_arr
                                  case product_option.position
                                    when 1
                                      if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                            {% endif %}
                            <option
                              value="{{ value | handle }}"
                              {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                                :disabled="!optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                              {% endif %}
                            >
                              {{ value }}
                              {% if settings.enable_unavailable_options
                                and option_disabled
                              %}
                                - {{ 'products.general.sold_out' | t -}}
                              {%- endif %}
                            </option>
                          {% endfor %}
                        </select>
                      {% else %}
                        <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
                          {% for value in product_option.values %}
                            {% if settings.enable_unavailable_options %}
                              {%- liquid
                                assign option_disabled = true

                                for option1_name in variants_option1_arr
                                  case product_option.position
                                    when 1
                                      if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                            {% endif %}
                            <button
                              type="button"
                              class="btn btn--plain btn--small"
                              {% if product.options_with_values.size > 1 and product_option.position > 1 %}
                                x-show="optionValueExists({{ product_option.position }}, '{{ value | handle }}')"
                              {% endif %}
                              :class="
                                {
                                  {% if product.options_with_values.size > 1 and settings.enable_unavailable_options %}
                                    'strikethrough': !optionValueHasAvailableVariant({{ product_option.position }}, '{{ value | handle }}'),
                                  {% elsif settings.enable_unavailable_options %}
                                    'strikethrough': {{ option_disabled }},
                                  {% endif %}
                                  'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                                  'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                                }
                              "
                              @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
                              {{ option_size }}
                              {% if option_size == 1 %}
                                x-init="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
                              {% endif %}
                            >
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      {% endif %}
                    {% endif %}
                  </div>
                {% endfor %}

                <select
                  class="hidden"
                  name="handle"
                  x-model="variantHandle"
                >
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.title | handle }}"
                      data-id="{{ variant.id }}"
                      {% if variant.id
                          == product.selected_or_first_available_variant.id
                      %}
                        selected
                      {% endif %}
                    >
                      {{ variant.title | handle }}
                    </option>
                  {% endfor %}
                </select>
              </div>
              <div
                class="
                  flex-wrap px-4 py-4 hidden no-js--block
                  {% if product.variants.size <= 1 %}hidden{% endif %}
                "
              >
                <div class="w-full">
                  <label
                    class="flex mb-1 opacity-75 type--smaller"
                    for="Variants-{{ section.id }}"
                  >
                    {{ 'products.general.sold_out' | t }}
                  </label>
                  <select
                    id="Variants-{{ section.id }}"
                    class="w-full"
                    name="id"
                    x-model="defaultVariantId"
                  >
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant
                            == product.selected_or_first_available_variant
                        %}
                          selected="selected"
                        {% endif %}
                        {% if variant.available == false %}
                          disabled
                        {% endif %}
                      >
                        {{ variant.title }}
                        {%- if variant.available == false %}
                          - {{ 'products.general.sold_out' | t -}}
                        {%- endif %}
                        - {{ variant.price | money | strip_html }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              </div>

              {%- comment -%}selling plans{%- endcomment -%}
              {% if product.selected_or_first_available_selling_plan_allocation %}
                <div
                  class="
                    no-js--hide w-full px-4
                    {% unless product.has_only_default_variant %}my-4{% endunless %}
                  "
                  x-show="defaultHasSellingPlan"
                >
                  <div
                    class="border--width color__border-divider-1 border--radius w-full !border-b-0 overflow-hidden"
                  >
                    {% unless product.requires_selling_plan %}
                      <div
                        class="border--b-width color__border-divider-1"
                      >
                        <label
                          class="inline-flex items-center justify-between w-full px-4 py-4"
                          @click="sellingGroupId = 0"
                        >
                          <input
                            type="radio"
                            name="purchase_option"
                            value="0"
                            {% if product.selected_or_first_available_selling_plan_allocation %}
                              checked
                            {% endif %}
                            :checked="{ 'checked': sellingGroupId == 0 }"
                            @change="handleForm"
                          >
                          <span
                            class="ml-2 grow"
                          >
                            {{ 'products.general.one_time_purchase' | t }}
                          </span>
                          <span>
                            {{ product.price_min | money }}
                          </span>
                        </label>
                      </div>
                    {% endunless %}

                    {% for group in product.selling_plan_groups %}
                      <div
                        class="border--b-width color__border-divider-1"
                      >
                        {% comment %} find lowest price {% endcomment %}
                        {% assign selling_plan_price_min = product.price_max
                          | plus: 0
                        %}
                        {% assign selling_plan_discount = 0 %}
                        {% for variant in product.variants %}
                          {%- for allocation in variant.selling_plan_allocations -%}
                            {% if allocation.selling_plan_group_id == group.id
                            %}
                              {% if selling_plan_price_min
                                  >= allocation.per_delivery_price
                              %}
                                {% assign selling_plan_price_min = allocation.per_delivery_price
                                  | plus: 0
                                %}
                              {% endif %}
                            {% endif %}
                          {%- endfor -%}
                        {%- endfor -%}

                        {% comment %} find biggest discount {% endcomment %}
                        {% assign selling_plan_discount = 0 %}
                        {% assign selling_plan_discount_original = 0 %}
                        {% assign selling_plan_discount_type = '' %}
                        {% for selling_plan in group.selling_plans %}
                          {%- for price_adjustment in selling_plan.price_adjustments -%}
                            {% assign current_discount = 0 %}
                            {% if price_adjustment.value_type == 'fixed_amount'
                            %}
                              {% assign current_discount = price_adjustment.value %}
                            {% elsif price_adjustment.value_type == 'price' %}
                              {% assign current_discount = product.price
                                | minus: price_adjustment.value
                              %}
                            {% elsif price_adjustment.value_type == 'percentage'
                            %}
                              {% assign current_discount = product.price
                                | times: price_adjustment.value
                                | divided_by: 100
                              %}
                            {% endif %}
                            {% if current_discount > selling_plan_discount %}
                              {% assign selling_plan_discount = current_discount %}
                              {% assign selling_plan_discount_original = price_adjustment.value %}
                              {% assign selling_plan_discount_type = price_adjustment.value_type %}
                            {% endif %}
                          {%- endfor -%}
                        {% endfor %}

                        <label
                          class="inline-flex items-center justify-between w-full px-4 py-4"
                          @click="sellingGroupId = '{{ group.id }}';"
                        >
                          <input
                            type="radio"
                            name="purchase_option"
                            value="{{ group.id }}"
                            {% if product.requires_selling_plan
                              or product.selling_plan_groups.size == 1
                            %}
                              checked
                            {% endif %}
                            {% if product.selling_plan_groups.size == 1 %}
                              x-init="sellingGroupId = '{{ group.id }}';"
                            {% endif %}
                            @change="handleForm"
                          >
                          <span class="flex flex-wrap items-center gap-1 ml-2 grow">
                            {{ group.name }}
                            {% capture selling_plan_discount %}
                              {% if selling_plan_discount_type == 'percentage' %}
                                {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | append: '%' }}
                              {% else %}
                                {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | money }}
                              {% endif %}
                            {% endcapture %}
                            {% render 'component__badge',
                              color: 'overlay-1',
                              icon: '',
                              content: selling_plan_discount
                            %}
                          </span>
                          <span class="flex flex-col items-end text-right">
                            {{ selling_plan_price_min | money }}
                            <span class="flex opacity-75 type--smaller">
                              {{ 'products.general.each' | t }}
                            </span>
                          </span>
                        </label>

                        {% for variant in product.variants %}
                          <div
                            class="pb-4 pl-4 border--t-width color__border-divider-1 color__bg-overlay-1"
                            x-show="defaultVariantId == {{ variant.id }} && sellingGroupId == '{{ group.id }}'"
                            x-cloak
                          >
                            {% for selling_plan in group.selling_plans %}
                              <label
                                class="inline-flex items-center justify-between w-full px-4 pt-4"
                              >
                                <input
                                  class="js:{{ group.id }}_{{ variant.id }}_selling_plan"
                                  type="radio"
                                  name="{{ group.id }}_{{ variant.id }}_selling_plan"
                                  value="{{ selling_plan.id }}"
                                  {% if product.selected_or_first_available_selling_plan_allocation
                                    or group.selling_plans.size == 1
                                  %}
                                    checked
                                  {% endif %}
                                  {% if group.selling_plans.size == 1 %}
                                    x-init="handleForm"
                                  {% endif %}
                                  x-model="defaultSellingPlanId"
                                  @change="handleForm"
                                  data-selling-plan='
                                    {
                                      {%- for allocation in variant.selling_plan_allocations -%}
                                        {% if allocation.selling_plan.id == selling_plan.id %}
                                          "price": {{ allocation.price }},
                                          "compare_at_price": {{ allocation.compare_at_price }},
                                          "per_delivery_price": {{ allocation.per_delivery_price }},
                                          "unit_price": {{ allocation.unit_price | default: "0" }},
                                        {% endif %}
                                      {%- endfor -%}
                                      "recurring_deliveries": {{ selling_plan.recurring_deliveries }},
                                      "name": "{{ selling_plan.name }}",
                                      "description": "{{ selling_plan.description }}",
                                      "price_adjustments": [
                                        {%- for price_adjustment in selling_plan.price_adjustments -%}
                                          {
                                            "index": {{ price_adjustment.position }},
                                            "value": {{ price_adjustment.value }},
                                            "order_count": {{ price_adjustment.order_count | default: "null" }},
                                            "value_type": "{{ price_adjustment.value_type }}"
                                          }{% unless forloop.last == true %},{% endunless %}
                                        {%- endfor -%}
                                      ]
                                    }
                                  '
                                >
                                <span class="ml-2 grow">
                                  {{ selling_plan.name }}
                                </span>
                                <span>
                                  {%- for allocation in variant.selling_plan_allocations -%}
                                    {% if allocation.selling_plan.id
                                        == selling_plan.id
                                    %}
                                      <span class="flex flex-col items-end text-right">
                                        {{
                                          allocation.per_delivery_price
                                          | money
                                        }}
                                        <span class="flex opacity-75 type--smaller">
                                          {{ 'products.general.each' | t }}
                                        </span>
                                      </span>
                                    {% endif %}
                                  {%- endfor -%}
                                </span>
                              </label>
                            {% endfor %}
                          </div>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>

                  <div
                    class="mt-2"
                    x-show="defaultSellingPlanName && sellingGroupId != 0"
                    x-cloak
                  >
                    <div class="flex items-center gap-2">
                      {% render 'component__icon',
                        icon: 'refresh-cw',
                        size: '16'
                      %}
                      <p class="mb-0 type--small">
                        <span x-text="defaultSellingPlanName"></span>
                        <span x-text="defaultSavingsSummary"></span>
                        <span x-text="defaultSellingPlanDescription"></span>
                      </p>
                    </div>
                  </div>
                </div>
                <div class="flex flex-wrap hidden px-4 no-js--block">
                  <div class="w-full">
                    <label
                      class="flex mb-1 opacity-75 type--smaller"
                      for="Variants-{{ section.id }}"
                    >
                      {{ 'products.general.purchase_options' | t }}
                    </label>
                    <select
                      name="selling_plan"
                      x-model="defaultSellingPlanId"
                    >
                      {% for group in product.selling_plan_groups %}
                        <optgroup label="{{ group.name }}">
                          {% for selling_plan in group.selling_plans %}
                            <option value="{{ selling_plan.id }}">
                              {{ selling_plan.name }}
                            </option>
                          {% endfor %}
                        </optgroup>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              {% endif %}

              {%- comment -%}add butttons{%- endcomment -%}
              <div class="sticky bottom-0 z-10 flex w-full shrink-0 flex-wrap content-end items-end p-4 color__bg-body border--t-width color__border-divider-1">
                <button
                  disabled
                  type="button"
                  role="button"
                  class="btn btn--load btn--plain !w-full"
                  x-show="buttonDisabled && defaultAvailable"
                  @click="choosing = true"
                  :class="{ 'btn--loading' : cart_loading && button_loading }"
                  :disabled="button_loading"
                  x-cloak
                >
                  <div class="btn__content">
                    {{ 'products.general.choose_options' | t }}
                  </div>
                </button>

                {% comment %}
                  <button disabled type="button" role="button" class="btn btn--load btn--plain !w-full"
                    x-show="!defaultAvailable"
                    :class="{ 'btn--loading' : cart_loading && button_loading }"
                    :disabled="button_loading"
                    x-cloak>
                    <div class="btn__content">{{ 'products.general.sold_out' | t }}</div>
                  </button>
                {% endcomment %}
                <a
                  type="button"
                  class="btn btn--load btn--plain !w-full"
                  x-show="!defaultAvailable"
                  x-cloak
                  href="{{ product.url }}"
                >
                  Notify me
                </a>

                <button
                  role="button"
                  class="btn btn--load btn--primary !w-full"
                  x-show="!buttonDisabled && defaultAvailable"
                  :class="{ 'btn--loading' : cart_loading && button_loading }"
                  :disabled="button_loading"
                  x-cloak
                >
                  <div class="btn__content">
                    {% if product.metafields.custom.button_text %}
                      {{ product.metafields.custom.button_text }}
                      {% if settings.type_seperator == 'dot' -%}
                        ·
                      {%- else -%}
                        |
                      {%- endif %}
                    {% else %}
                      {{ 'products.general.add_to_cart' | t }}
                      {% if settings.type_seperator == 'dot' -%}
                        ·
                      {%- else -%}
                        |
                      {%- endif %}
                    {% endif %}
                    <span
                      class="ml-1"
                      x-text="Shopify.formatMoney(defaultVariantPrice, '{{ cart.currency.symbol }}')"
                    >
                      {{- product.price | money -}}
                    </span>
                  </div>
                  <div class="btn__spinner">
                    {% render 'component__icon',
                      icon: 'spinner',
                      size: '24',
                      class: ''
                    %}
                  </div>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</dialog>
