<!-- sections/product__main.liquid -->
{% comment %}
  Loop through different blocks to create a product page.

    - settings.thumbmails_color_scheme: set color of items

  Possible enhancements:
    - Add alternative layouts
    - Add support so upsell can fit within form

  Pro tips:
    - Multiple product templates can be created from the theme editor.
{% endcomment %}

{% liquid
  assign gallery_sticky_top_class = 'md:top-10'
  if settings.header_position == 'sticky' or settings.header_position == 'dynamic'
    assign gallery_sticky_top_class = 'md:top-[calc(var(--header-height,0px)+1.5rem)]'
  endif
%}

<section
  class="
    z-10 relative max-w-full overflow-x-clip md:overflow-x-visible
    {{ section.settings.color_scheme }}
    md:window--wide
  "
  data-pdp-main="{{ section.id }}"
  x-data="
    {
      fullscreen: false,
    }
  "
  x-init="checkLineItems('{{ product.handle }}')"
  x-intersect:enter="scroll_up_force = true;"
  x-intersect:leave="scroll_up_force = false;"
>
  {%- capture script_product -%}
    {% render 'script__product', 
      gallery_style : section.settings.media_gallery_style,
      enable_variant_section_rendering: true %}
  {%- endcapture -%}
  {%- comment -%}The desktop gallery uses native sticky positioning within the product layout.{%- endcomment -%}
  <div
    class="flex w-full flex-col md:flex-row md:items-start md:gap-[2em] md:py-6"

    x-data="{{ script_product }}"
    x-init="      initProductForm();"
    x-ref="formContainer"
  >
    <div
      class="z-30 flex w-full min-w-0 flex-col md:sticky md:w-[70%] md:flex-none md:self-start md:overflow-hidden {{ gallery_sticky_top_class }}"
    >
      <div class="w-full">
        <div class="contents" data-product-media-container="{{ section.id }}">
          {% if section.settings.media_gallery_style == 'grid' %}
            {% render 'product__gallery-grid', nested_gallery_column: true %}
          {% elsif section.settings.media_gallery_style == 'slider' %}
            {% render 'product__gallery-slider', nested_gallery_column: true %}
          {% else %}
            {% render 'product__gallery-thumbnail-slider', nested_gallery_column: true %}
          {% endif %}
        </div>
      </div>
    </div>

    <div
      class="
        border--t-width md:border-t-0 w-full min-w-0 md:flex-1
        {{ section.settings.color_border }}
      "
    >
      <div
        class="w-full"
        x-data="
          {
            button_loading: false
          }
        "
      >
        {% form 'product', product %}
          {% comment %} Desktop only blocks {% endcomment %}
          <div class="hidden w-full md:block">
            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when 'breadcrumb' -%}
                  {% render 'product__breadcrumb', blocksettings: block.settings %}

                {%- when 'title' -%}
                  {% render 'product__title', blocksettings: block.settings %}

                {%- when 'price' -%}
                  <div
                    class="
                      px-4 md:!pt-3 md:!pb-[22px]
                      {{ section.settings.color_border }}
                      {{ block.settings.color_scheme }}
                      {{ block.settings.style_border }}
                    "
                    style="
                      padding-top:{{ block.settings.spacing_top }}px;
                      padding-bottom:{{ block.settings.spacing_bottom }}px;
                    "
                  >
                    <div class="relative flex items-end justify-between">
                      {% render 'product__price', blocksettings: block.settings %}
                    </div>
                  </div>
              {%- endcase -%}
            {% endfor %}
          </div>

          {% assign skip_paired_icon = false %}
          {% for block in section.blocks %}
            {% if skip_paired_icon %}
              {% assign skip_paired_icon = false %}
              {% continue %}
            {% endif %}
            {%- case block.type -%}
              {%- when 'icon' -%}
                {% assign next_block = section.blocks[forloop.index] %}
                <div class="flex w-full flex-wrap items-center justify-center gap-3">
                  {% render 'product__icon', blocksettings: block.settings %}
                  {% if next_block.type == 'icon' %}
                    {% render 'product__icon', blocksettings: next_block.settings %}
                    {% assign skip_paired_icon = true %}
                  {% endif %}
                </div>

              {%- when 'custom' -%}
                <div
                  class="
                    px-4
                    {{ section.settings.color_border }}
                    {{ block.settings.color_scheme }}
                    {{ block.settings.style_border }}
                  "
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;
                  "
                >
                  {% render 'product__custom-field', blocksettings: block.settings %}
                </div>

              {%- when 'text' -%}
                {% if product.tags contains block.settings.text_block_tag %}
                  {% render 'product__text', blocksettings: block.settings %}
                {% endif %}

              {%- when 'description' -%}
                {% render 'product__description', blocksettings: block.settings %}

              {%- when 'accordion' -%}
                {% render 'product__accordion', blocksettings: block.settings %}

              {%- when 'popup' -%}
                {% render 'product__popup', blocksettings: block.settings %}

              {%- when 'inventory' -%}
                {% render 'product__inventory', blocksettings: block.settings %}

              {%- when 'pickup' -%}
                {% render 'product__pickup', blocksettings: block.settings %}

              {%- when 'options' -%}
                <div
                  class="
                    options flex flex-col gap-2 md:!pt-0
                    {{ section.settings.color_border }}
                    {{ block.settings.color_scheme }}
                    {{ block.settings.style_border }}
                  "
                  style="
                    padding-top:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_top }}px;{% else %}0;{% endif %}
                    padding-bottom:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_bottom }}px;{% else %}0;{% endif %}
                  "
                >
                  {% render 'product__options', blocksettings: block.settings %}
                </div>

              {%- when 'add' -%}
                <div
                  class="
                    {{ section.settings.color_border }}
                    {{ block.settings.color_scheme }}
                    {{ block.settings.style_border }}
                  "
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;
                  "
                >
                  <div
                    class="md:[&_.btn]:rounded-lg"
                    x-intersect:enter="stickyadd = false"
                    x-intersect:leave="stickyadd = true"
                  >
                    {% render 'product__add', blocksettings: block.settings %}
                  </div>
                  {% if block.settings.enable_dynamic_checkout %}
                    <div class="px-4 mt-4">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                  {%- unless block.settings.content == blank -%}
                    <div class="w-full px-4 mt-4">
                      <div class="p-2 text-center type--small m-0--clear color__bg-overlay-1 border--radius">
                        {{ block.settings.content }}
                      </div>
                    </div>
                  {% endunless %}
                </div>

              {%- when 'stickyadd' -%}
                {% render 'product__stickyadd', blocksettings: block.settings %}

              {%- when 'rating' -%}
                {% render 'product__rating', blocksettings: block.settings %}

              {%- when 'countdown' -%}
                {% if product.tags contains block.settings.countdown_tag or block.settings.countdown_tag == '' %}
                  {% render 'product__countdown', blocksettings: block.settings %}
                {% endif %}

              {% when 'liquid' %}
                {% render 'product__liquid', blocksettings: block.settings %}

              {% when '@app' %}
                {% render block %}
            {%- endcase -%}
          {% endfor %}
        {% endform %}

        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'upsell' -%}
              {% render 'product__upsell', blocksettings: block.settings %}
          {%- endcase -%}
        {% endfor %}
      </div>
    </div>
  </div>

  <div data-product-fullscreen-container="{{ section.id }}">
    {% if section.settings.enable_zoom %}
      {% render 'product__gallery-fullscreen' %}
    {% endif %}
  </div>
</section>

{% render 'script__recent-view' %}
{% render 'script__swatches' %}

{% comment %} Backup collegiate swatch container - ensure it exists {% endcomment %}
{% if product.tags contains 'collegiate' %}
  <div class="hidden">
    <div class="js:pdp-collegiate-swatches-backup"></div>
  </div>
{% endif %}

