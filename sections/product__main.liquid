<!-- sections/product__main.liquid -->
{% comment %} 
  Loop through different blocks to create a product page.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.thumbmails_color_scheme: set color of items

  Possible enhancements:
    - Add alternative layouts
    - Add support so upsell can fit within form

  Pro tips:
    - Multiple product templates can be created from the theme editor.
{% endcomment %}

{%- liquid
  assign pdp_rail_gap = 24
  assign header_sticky = false
  if settings.header_position == 'sticky' or settings.header_position == 'dynamic'
    assign header_sticky = true
  endif
  if header_sticky
    assign pdp_top_px = 90
    assign pdp_top_offset = '90px'
  else
    assign pdp_top_px = 16
    assign pdp_top_offset = '1rem'
  endif
-%}

<section class="z-10 relative
  {{ section.settings.color_scheme }}
  {{ section.settings.layout_horizontal }}"
  data-pdp-main="{{ section.id }}"
  style="--pdp-gallery-top-offset: {{ pdp_top_offset }};--pdp-gallery-top-px: {{ pdp_top_px }};--pdp-gallery-rail-gap: {{ pdp_rail_gap }}px;"
  x-data="{ 
    fullscreen: false,
  }"
  x-init="checkLineItems('{{ product.handle }}')"
  x-intersect:enter="scroll_up_force = true;"
  x-intersect:leave="scroll_up_force = false;">

  {%- capture script_product -%}
    {% render 'script__product', 
      gallery_style : section.settings.media_gallery_style,
      enable_variant_section_rendering: true %}
  {%- endcapture -%}
  {% case section.settings.layout_gallery_size %}
    {% when 'w-full md:w-1/3' %}
      {% assign layout_detail_size = 'w-full md:w-2/3' %}
      {% assign pdp_gallery_width_ratio = '0.3333333333' %}
    {% when 'w-full md:w-1/2' %}
      {% assign layout_detail_size = 'w-full md:w-1/2' %}
      {% assign pdp_gallery_width_ratio = '0.5' %}
    {% when 'w-full md:w-2/3' %}
      {% assign layout_detail_size = 'w-full md:w-1/3' %}
      {% assign pdp_gallery_width_ratio = '0.6666666667' %}
    {% when 'w-full md:w-3/4' %}
      {% assign layout_detail_size = 'w-full md:w-1/4' %}
      {% assign pdp_gallery_width_ratio = '0.75' %}
  {% endcase %}

  {%- comment -%}Desktop: fixed gallery rail (offsets hardcoded in Liquid at top of file).{%- endcomment -%}
  <div class="flex flex-row flex-wrap md:items-start md:pt-[var(--pdp-gallery-rail-gap)]"

    x-data="{{ script_product }}"
    x-init="
      initProductForm();
    "
    x-ref="formContainer">

    <div class="w-full min-w-0 {{ section.settings.layout_gallery_size }} flex flex-col">
      <div class="hidden md:block pdp-gallery-spacer-{{ section.id }}" data-pdp-gallery-spacer="{{ section.id }}"></div>
      <div
        class="pdp-gallery-fixed-{{ section.id }} top-4 z-30 w-full md:fixed"
        data-pdp-gallery-fixed="{{ section.id }}"
      >
        <div data-product-media-container="{{ section.id }}" style="display: contents;">
          {% if section.settings.media_gallery_style == 'grid' %}
            {% render 'product__gallery-grid', nested_gallery_column: true %}
          {% elsif section.settings.media_gallery_style == 'slider' %}
            {% render 'product__gallery-slider', nested_gallery_column: true %}
          {% else %}
            {% render 'product__gallery-thumbnail-slider', nested_gallery_column: true %}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="border--t-width md:border-t-0 w-full min-w-0
      {{ section.settings.color_border }}
      {{ layout_detail_size }}">
      <div
        x-data="{ 
          button_loading: false 
        }">

        {% form "product", product %}

          {% comment %} Desktop only blocks {% endcomment %}
          <div class="hidden w-full md:block">
            {% for block in section.blocks %}
              {%- case block.type -%}
                
                {%- when 'breadcrumb' -%}
                  {% render 'product__breadcrumb', blocksettings: block.settings %}

                {%- when 'title' -%}
                  {% render 'product__title', blocksettings: block.settings %}

                {%- when 'price' -%}
                  <div class="px-4
                      {{ section.settings.color_border }}
                      {{ block.settings.color_scheme }} 
                      {{ block.settings.style_border }}"
                    style="
                      padding-top:{{ block.settings.spacing_top }}px;
                      padding-bottom:{{ block.settings.spacing_bottom }}px;">
                    <div class="relative flex items-end justify-between">
                      {% render 'product__price', blocksettings: block.settings %}
                    </div>
                  </div>

              {%- endcase -%}
            {% endfor %}
          </div>

          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'icon' -%}
                {% render 'product__icon', blocksettings: block.settings %} 

              {%- when 'custom' -%}
                <div class='px-4 
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }} 
                  {{ block.settings.style_border }}'
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;">
                  {% render 'product__custom-field', blocksettings: block.settings %}
                </div>

              {%- when 'text' -%}
                {% if product.tags contains block.settings.text_block_tag %}
                    {% render 'product__text', blocksettings: block.settings %}
                {% endif %}

              {%- when 'description' -%}
                {% render 'product__description', blocksettings: block.settings %}

              {%- when 'accordion' -%}
                {% render 'product__accordion', blocksettings: block.settings %}

              {%- when 'popup' -%}
                {% render 'product__popup', blocksettings: block.settings %}

              {%- when 'inventory' -%}
                {% render 'product__inventory', blocksettings: block.settings %}

              {%- when 'pickup' -%}
                {% render 'product__pickup', blocksettings: block.settings %}  

              {%- when 'options' -%}
                <div class="options flex flex-col gap-2
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }}
                  {{ block.settings.style_border }}"
                  style="
                    padding-top:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_top }}px;{% else %}0;{% endif %}
                    padding-bottom:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_bottom }}px;{% else %}0;{% endif %}">
                  {% render 'product__options', 
                    blocksettings: block.settings %}
                </div>

              {%- when 'add' -%}
                <div class="
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }}
                  {{ block.settings.style_border }}"
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;">
                  <div
                    data-pdp-primary-atc
                    x-intersect:enter="stickyadd = false"
                    x-intersect:leave="stickyadd = true">
                    {% render 'product__add',
                      blocksettings: block.settings %}
                  </div>
                  {% if block.settings.enable_dynamic_checkout %}
                    <div class="px-4 mt-4">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                  {%- unless block.settings.content == blank -%}
                    <div class="w-full px-4 mt-4">
                      <div class="p-2 text-center type--small m-0--clear color__bg-overlay-1 border--radius">
                        {{ block.settings.content }}
                      </div>
                    </div>
                  {% endunless %}
                </div>

              {%- when 'stickyadd' -%}
                {% render 'product__stickyadd', blocksettings: block.settings %}

              {%- when 'rating' -%}
                {% render 'product__rating', blocksettings: block.settings %}

              {%- when 'countdown' -%}
                {% if product.tags contains block.settings.countdown_tag or block.settings.countdown_tag == "" %}
                    {% render 'product__countdown', blocksettings: block.settings %}
                {% endif %}

              {% when 'liquid' %}
                {% render 'product__liquid', blocksettings: block.settings %}

              {% when '@app' %}
                {% render block %}

              {%- endcase -%}
          {% endfor %}
        {% endform %}

        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'upsell' -%}
              {% render 'product__upsell', blocksettings: block.settings %}
          {%- endcase -%}
        {% endfor %}

      </div>
    </div>
  </div>

  <div data-product-fullscreen-container="{{ section.id }}">
    {% if section.settings.enable_zoom %}
      {% render 'product__gallery-fullscreen' %}
    {% endif %}
  </div>

</section>

{% render 'script__recent-view' %}
{% render 'script__swatches' %}

{% comment %} Backup collegiate swatch container - ensure it exists {% endcomment %}
{% if product.tags contains 'collegiate' %}
  <div style="display: none;">
    <div class="js:pdp-collegiate-swatches-backup"></div>
  </div>
{% endif %}

<style>
  @media (min-width: 768px) {
    .pdp-gallery-fixed-{{ section.id }} {
      top: calc(var(--pdp-gallery-top-offset) + var(--pdp-gallery-rail-gap));
      left: max(1rem, calc((100vw - 1536px) / 2 + 1rem));
      width: calc((min(100vw, 1536px) - 2rem) * {{ pdp_gallery_width_ratio }});
      overflow: visible;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('[data-pdp-main="{{ section.id }}"]');
    const spacer = document.querySelector('[data-pdp-gallery-spacer="{{ section.id }}"]');
    const gallery = document.querySelector('[data-pdp-gallery-fixed="{{ section.id }}"]');

    if (!section || !spacer || !gallery) return;

    const resetGallery = () => {
      gallery.style.position = '';
      gallery.style.top = '';
      gallery.style.left = '';
      gallery.style.bottom = '';
      gallery.style.width = '';
      gallery.style.height = '';
      gallery.style.maxHeight = '';
      gallery.style.overflow = '';
      gallery.style.transform = '';
      spacer.style.height = '';
    };

    const readOffsetPx = () => {
      const fromPx = getComputedStyle(section).getPropertyValue('--pdp-gallery-top-px').trim();
      const n = parseFloat(fromPx);
      if (Number.isFinite(n) && n > 0) return n;
      const raw = getComputedStyle(section).getPropertyValue('--pdp-gallery-top-offset').trim() || '90px';
      if (raw.includes('rem')) {
        const rem = parseFloat(raw);
        const rootPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        if (Number.isFinite(rem) && rem > 0) return rem * rootPx;
      }
      return parseFloat(raw) || 90;
    };

    const readRailGapPx = () => {
      const raw = getComputedStyle(section).getPropertyValue('--pdp-gallery-rail-gap').trim();
      if (!raw) return 0;
      if (raw.includes('rem')) {
        const rem = parseFloat(raw);
        const rootPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        if (Number.isFinite(rem) && rem > 0) return rem * rootPx;
      }
      const n = parseFloat(raw);
      return Number.isFinite(n) && n >= 0 ? n : 0;
    };

    const syncGallery = () => {
      if (window.innerWidth < 768) {
        resetGallery();
        return;
      }

      const offsetPx = readOffsetPx();
      const railTopPx = offsetPx + readRailGapPx();
      const spacerRect = spacer.getBoundingClientRect();
      const sectionRect = section.getBoundingClientRect();
      const spacerLeftInSection = spacer.offsetLeft;
      // scrollHeight can be briefly inflated on first paint; cap for rail math so we
      // don't spuriously hit the "pin to section bottom" branch before layout settles.
      const rawH = gallery.scrollHeight;
      const vh = window.innerHeight;
      const heightCap = Math.max(vh * 6, 2400);
      const galleryHeight = Math.min(rawH, heightCap);
      gallery.style.width = `${spacerRect.width}px`;
      gallery.style.height = 'auto';
      gallery.style.maxHeight = 'none';
      gallery.style.overflow = 'visible';
      spacer.style.height = `${rawH}px`;

      // Pin gallery bottom when section ends before the fixed rail would overflow.
      const canPinToSectionBottom = sectionRect.top < railTopPx - 0.5;
      if (canPinToSectionBottom && sectionRect.bottom <= railTopPx + galleryHeight) {
        gallery.style.position = 'absolute';
        gallery.style.top = 'auto';
        gallery.style.left = `${spacerLeftInSection}px`;
        gallery.style.bottom = '0px';
        gallery.style.transform = '';
        return;
      }

      gallery.style.position = 'fixed';
      gallery.style.top = `${railTopPx}px`;
      gallery.style.left = `${spacerRect.left}px`;
      gallery.style.bottom = '';
      gallery.style.transform = '';
    };

    const scheduleSync = () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          syncGallery();
        });
      });
    };

    const onResize = () => {
      syncGallery();
    };

    const onSectionLoad = () => {
      scheduleSync();
    };

    syncGallery();
    scheduleSync();
    window.addEventListener('load', scheduleSync, { once: true });
    window.addEventListener('scroll', syncGallery, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener('shopify:section:load', onSectionLoad);
    window.addEventListener('tw:pdp-layout-changed', scheduleSync);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => {
        requestAnimationFrame(syncGallery);
      });
      ro.observe(gallery);
      ro.observe(section);
    }
  })();
</script>

