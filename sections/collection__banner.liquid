<!-- sections/collection__banner.liquid -->
{% comment %}
  Display a banner with the collection title and featured image.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.enable_animations: boolean to enable animations

  Pro tips:
    - Use images that have a high contrast with text.
    - To display any image this section could be replaced with a banner.liquid section.
{% endcomment %}

<section
  class="
    relative overflow-hidden flex items-center justify-center
    {{ section.settings.visibility }}
    {{ section.settings.color_scheme }}
    {{ section.settings.color_border }}
    {{ section.settings.style_border }}
  "
>
  {% comment %} Classes for custom image heights {% endcomment %}
  {% assign image_classes = '' %}
  {% if section.settings.show_entire_image %}
    {% assign image_classes = 'hidden md:block w-full h-full absolute object-contain z-10' %}
  {% else %}
    {% assign image_classes = 'hidden md:block w-full h-full absolute object-cover z-10' %}
  {% endif %}

  {%- if section.settings.image_background_desktop %}
    {{
      section.settings.image_background_desktop
      | image_url: width: 5760
      | image_tag: class: image_classes, loading: lazy_loading
    }}
  {%- endif -%}

  {%- if section.settings.image_background_mobile == blank %}
    {%- if section.settings.image_background_desktop %}
      {{
        section.settings.image_background_desktop
        | image_url: width: 5760
        | image_tag:
          class: 'md:hidden w-full h-full absolute object-cover z-10',
          loading: lazy_loading
      }}
    {%- endif -%}
  {%- else -%}
    {{
      section.settings.image_background_mobile
      | image_url: width: 900
      | image_tag:
        class: 'md:hidden w-full h-full absolute object-cover z-10',
        loading: lazy_loading
    }}
  {%- endif -%}

  <div
    class="relative z-10 w-full h-full"
    {% if section.settings.enable_gradient %}
      style="background: linear-gradient( to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.2) );"
    {% endif %}
  >
    <div
      class="
        w-full flex flex-row flex-wrap py-4
        {{ settings.layout_horizontal }}
        {{ section.settings.layout_x_alignment }}
        {{ section.settings.layout_y_alignment }}
        {{ section.settings.layout_y_spacing }}
        {{ section.settings.color_text }}
        {% assign colors = section.settings.color_scheme | split: " " %}{{ colors[1] }}
      "
    >
      <div
        class="
          max-w-prose
          {% unless request.design_mode %}
            {% if settings.enable_animations %}
              opacity-0 js:animation animation-300
            {% endif %}
          {% endunless %}
        "
        {% if settings.enable_animations %}
          data-delay="0"
          data-replace="
            {
              'opacity-0' : 'opacity-100'
            }
          "
        {% endif %}
      >
        {% unless collection.metafields.custom.disable_title %}
          {%- if section.settings.enable_title -%}
            {%- unless collection.title == blank %}
              <h1 class="mb-0">{{ collection.title }}</h1>
            {%- endunless -%}
          {% endif %}
        {% endunless %}

        {%- if section.settings.enable_description -%}
          {%- unless collection.description == blank %}
            <div>
              {{ collection.description }}
            </div>
          {%- endunless -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% comment %}Show back to school selection button for collegiate collection{% endcomment %}
{% if section.settings.enable_bar and collection.handle == 'collegiate' %}
  <section class="sticky top-0 z-10 z-20 hidden md:block color__bg-overlay-2">
    <div class="max-w-full mx-auto my-0">
      <div class="flex flex-row flex-wrap items-stretch">
        <div class="flex items-center flex-auto flex-grow-0 flex-shrink-0 w-auto p-4 border--r-width color__border-selected-1">
          <span class="!mb-0 type--smaller type__nav">
            <a href="/" class="type--smaller type__nav">HOME</a>
            /
            <span class="opacity-75">
              {{ collection.title }}
            </span>
          </span>
        </div>

        {% comment %} Back to school selection button {% endcomment %}
        <div class="relative flex items-center justify-start flex-1 w-auto px-4 color__border-selected-1">
          <a 
            href="/pages/shop-your-school"
            class="type__nav type--small py-4 px-6 no-underline transition-opacity hover:opacity-75"
          >
            ← Back to school selection
          </a>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% comment %}Hide sort/filter bar for other collections{% endcomment %}
{% if section.settings.enable_bar and collection.handle != 'collegiate' %}
  <section
    class="sticky top-0 z-10 z-20 hidden md:block color__bg-overlay-2"
    x-data="{ sort_by: ['{{ collection.sort_by | default: collection.default_sort_by }}'] }"
  >
    <div class="max-w-full mx-auto my-0">
      <div class="flex flex-row flex-wrap items-stretch">
        <div class="flex items-center flex-auto flex-grow-0 flex-shrink-0 w-auto p-4 border--r-width color__border-selected-1">
          <span class="!mb-0 type--smaller type__nav">
            <a href="/" class="type--smaller type__nav">HOME</a>
            /
            <span class="opacity-75">
              {{ collection.title }}
            </span>
          </span>
        </div>

        {% comment %} Sort dropdown functionality {% endcomment %}
        <div class="relative flex items-center justify-start flex-1 w-auto px-4 color__border-selected-1 gap-4">
          <form
            id="js:sortFilter"
            class="h-full flex items-center gap-4"
            @change="
              // Use page redirect for school filter instead of AJAX
              $el.submit();
            "
          >
            {% render 'component__sort-options',
              sort_by: sort_by,
              collection: collection
            %}

            {% comment %} School filter for Collegiate collections {% endcomment %}
            {% if collection.handle contains 'collegiate' %}
              {% assign school_filter = nil %}
              {% for f in collection.filters %}
                {% if f.label == 'School' %}
                  {% assign school_filter = f %}
                {% endif %}
              {% endfor %}
              {% if school_filter %}
                {% render 'component__school-filter', filter: school_filter, variant: 'desktop' %}
              {% endif %}
            {% endif %}
          </form>
        </div>
      </div>
    </div>
  </section>
{% endif %}

