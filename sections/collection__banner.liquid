<!-- sections/collection__banner.liquid -->
{% comment %}
  Display a banner with the collection title and featured image.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.enable_animations: boolean to enable animations

  Pro tips:
    - Use images that have a high contrast with text.
    - To display any image this section could be replaced with a banner.liquid section.
{% endcomment %}

<section
  style="--collection-banner-mobile: {{ section.settings.banner_min_height_mobile }}px; --collection-banner-desktop: {{ section.settings.banner_min_height_desktop }}px;"
  class="
    relative overflow-hidden flex items-center justify-center
    {% if section.settings.enable_header_overlap %}pt-[var(--header-height,0px)]{% unless request.page_type == 'index' %} -mt-[var(--header-height,0px)]{% endunless %}{% endif %}
    {{ section.settings.visibility }}
    {{ section.settings.color_scheme }}
    {{ section.settings.color_border }}
    {{ section.settings.style_border }}
  "
>
  {% comment %} Classes for custom image heights {% endcomment %}
  {% assign image_classes = '' %}
  {% if section.settings.show_entire_image %}
    {% assign image_classes = 'hidden md:block w-full h-full absolute object-contain z-10' %}
  {% else %}
    {% assign image_classes = 'hidden md:block w-full h-full absolute object-cover z-10' %}
  {% endif %}
  {% assign color_scheme_classes = section.settings.color_scheme | split: ' ' %}
  {% assign color_scheme_text = color_scheme_classes[1] %}

  {%- if section.settings.image_background_desktop %}
    {{
      section.settings.image_background_desktop
      | image_url: width: 5760
      | image_tag: class: image_classes, loading: lazy_loading
    }}
  {%- endif -%}

  {%- if section.settings.image_background_mobile == blank %}
    {%- if section.settings.image_background_desktop %}
      {{
        section.settings.image_background_desktop
        | image_url: width: 5760
        | image_tag: class: 'md:hidden w-full h-full absolute object-cover z-10', loading: lazy_loading
      }}
    {%- endif -%}
  {%- else -%}
    {{
      section.settings.image_background_mobile
      | image_url: width: 900
      | image_tag: class: 'md:hidden w-full h-full absolute object-cover z-10', loading: lazy_loading
    }}
  {%- endif -%}

  <div
    class="relative z-10 w-full h-full"
    {% if section.settings.enable_gradient %}
      style="background: linear-gradient(to bottom, rgb(0 0 0 / 0%), rgb(0 0 0 / 20%));"
    {% endif %}
  {% if section.settings.enable_header_overlap %}x-init="has_banner_overlap = true; header_color = '{{ section.settings.color_text }}'"{% endif %}>
    <div
      class="
        w-full flex flex-row flex-wrap py-4
        {{ settings.layout_horizontal }}
        {{ section.settings.layout_x_alignment }}
        {{ section.settings.layout_y_alignment }}
        {% if section.settings.use_custom_height %}min-h-[var(--collection-banner-mobile)] md:min-h-[var(--collection-banner-desktop)]{% else %}{{ section.settings.layout_y_spacing }}{% endif %}
        {{ section.settings.color_text }}
        {{ color_scheme_text }}
      "
    >
      <div
        class="
          max-w-full
          {% unless request.design_mode %}
            {% if settings.enable_animations %}
              opacity-0 js:animation animation-300
            {% endif %}
          {% endunless %}
        "
        {% if settings.enable_animations %}
          data-delay="0"
          data-replace="
            {
              'opacity-0' : 'opacity-100'
            }
          "
        {% endif %}
      >
        {% unless collection.metafields.custom.disable_title %}
          {%- if section.settings.enable_title -%}
            {%- unless collection.title == blank %}
              <h1 class="type__heading--bold-3 mb-0">{{ collection.title }}</h1>
            {%- endunless -%}
          {% endif %}
        {% endunless %}

        {%- if section.settings.enable_description -%}
          {%- unless collection.description == blank %}
            <div class="max-w-prose">
              {{ collection.description }}
            </div>
          {%- endunless -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% comment %}Show back to school selection button for collegiate collection{% endcomment %}
{% if section.settings.enable_bar and collection.handle == 'collegiate' %}
  <section class="sticky top-0 z-10 z-20 hidden md:block color__bg-overlay-2">
    <div class="max-w-full mx-auto my-0">
      <div class="flex flex-row flex-wrap items-stretch">
        <div class="flex items-center flex-auto flex-grow-0 flex-shrink-0 w-auto p-4 border--r-width color__border-selected-1">
          <span class="!mb-0 type--smaller type__nav">
            <a href="/" class="type--smaller type__nav">HOME</a>
            /
            <span class="opacity-75">
              {{ collection.title }}
            </span>
          </span>
        </div>

        {% comment %} Back to school selection button {% endcomment %}
        <div class="relative flex items-center justify-start flex-1 w-auto px-4 color__border-selected-1">
          <a
            href="/pages/shop-your-school"
            class="type__nav type--small py-4 px-6 no-underline transition-opacity hover:opacity-75"
          >
            ← Back to school selection
          </a>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_header_overlap",
      "label": "Enable header overlap",
      "info": "Places the banner media behind the header and offsets the banner content below it.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__4.content"
    },
    {
      "type": "image_picker",
      "id": "image_background_desktop",
      "label": "t:sections.banner.settings.image_background_desktop.label",
      "info": "t:sections.banner.settings.image_background_desktop.info"
    },
    {
      "type": "image_picker",
      "id": "image_background_mobile",
      "label": "t:sections.banner.settings.image_background_mobile.label",
      "info": "t:sections.banner.settings.image_background_mobile.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__1.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.colors.settings.color_scheme.label",
      "options": [
        {
          "value": "color__bg-body color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__1.label"
        },
        {
          "value": "color__bg-neutral color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__2.label"
        },
        {
          "value": "color__bg-overlay-1 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__3.label"
        },
        {
          "value": "color__bg-overlay-2 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__4.label"
        },
        {
          "value": "color__bg-overlay-3 color__text",
          "label": "t:sections.all.colors.settings.color_scheme.options__5.label"
        },
        {
          "value": "color__bg-primary color__primary",
          "label": "t:sections.all.colors.settings.color_scheme.options__6.label"
        },
        {
          "value": "color__bg-secondary color__secondary",
          "label": "t:sections.all.colors.settings.color_scheme.options__7.label"
        },
        {
          "value": "color__bg-tertiary color__tertiary",
          "label": "t:sections.all.colors.settings.color_scheme.options__8.label"
        }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "color_text",
      "label": "t:sections.all.colors.settings.color_text.label",
      "options": [
        {
          "value": "color__text",
          "label": "t:sections.all.colors.settings.color_text.options__1.label"
        },
        {
          "value": "color__light",
          "label": "t:sections.all.colors.settings.color_text.options__2.label"
        },
        {
          "value": "color__dark",
          "label": "t:sections.all.colors.settings.color_text.options__3.label"
        }
      ],
      "default": "color__light"
    },
    {
      "type": "select",
      "id": "color_border",
      "label": "t:sections.all.colors.settings.color_border.label",
      "options": [
        {
          "value": "color__border-divider-1",
          "label": "t:sections.all.colors.settings.color_border.options__1.label"
        },
        {
          "value": "color__border-selected-1",
          "label": "t:sections.all.colors.settings.color_border.options__2.label"
        }
      ],
      "default": "color__border-divider-1"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "t:sections.collection_banner.settings.enable_gradient.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__2.content"
    },
    {
      "type": "select",
      "id": "style_border",
      "label": "t:sections.all.styles.settings.style_border.label",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.styles.settings.style_border.options__1.label"
        },
        {
          "value": "border--t-width",
          "label": "t:sections.all.styles.settings.style_border.options__2.label"
        },
        {
          "value": "border--b-width",
          "label": "t:sections.all.styles.settings.style_border.options__3.label"
        },
        {
          "value": "border--b-width border--t-width",
          "label": "t:sections.all.styles.settings.style_border.options__4.label"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "use_custom_height",
      "label": "Use custom minimum height",
      "default": false
    },
    {
      "type": "range",
      "id": "banner_min_height_mobile",
      "label": "Mobile minimum height",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 70
