{% assign enable_banner_link = false %}
{% if section.settings.button_label != blank and section.settings.button_url != blank %}
	{% assign enable_banner_link = true %}
{% endif %}

<section
	class="
		alternative-video-banner
		{% if section.settings.enable_header_overlap %}pt-[var(--header-height,0px)]{% unless request.page_type == 'index' %} -mt-[var(--header-height,0px)]{% endunless %}{% endif %}
		{{ section.settings.visibility }}
		{% unless request.design_mode %}
			{% if settings.enable_animations %}
				opacity-50 js:animation animation-100
			{% endif %}
		{% endunless %}
	"
	style="
		--alternative-video-banner-height-mobile: {{ section.settings.height_mobile }}px;
		--alternative-video-banner-height-desktop: {{ section.settings.height_desktop }}px;
		padding-top: {{ section.settings.spacing_top }}px;
		padding-bottom: {{ section.settings.spacing_bottom }}px;
	"
	{% if settings.enable_animations %}
		data-delay="100"
		data-replace="{'opacity-50' : 'opacity-100'}"
	{% endif %}
	x-data="{ play: false }"
	{% if section.settings.auto_play and section.settings.video_background != blank %}
		x-intersect:enter="play = true"
		x-intersect:leave="play = false"
	{% endif %}
	x-init="{% if section.settings.enable_header_overlap %}has_banner_overlap = true; header_color = 'color__light';{% endif %} $watch('play', (value) => {
		if (value) {
			$refs.video.play().catch(() => {})
		} else {
			$refs.video.pause()
		}
	})"
>
	{% if enable_banner_link %}
		<a href="{{ section.settings.button_url }}" class="alternative-video-banner__media alternative-video-banner__link relative flex flex-col no-underline hover:no-underline">
	{% else %}
		<div class="alternative-video-banner__media relative flex flex-col">
	{% endif %}
		<div class="absolute inset-x-0 bottom-0 z-10 flex flex-row flex-wrap color__light">
			<div class="alternative-video-banner__content min-[525px]:max-w-[55vw] md:!max-w-[67vw] min-[1550px]:!max-w-[64vw] gap-4 pl-8 py-8 md:p-14">
				{%- unless section.settings.heading == blank -%}
					<h1 class="m-0">{{ section.settings.heading }}</h1>
				{%- endunless -%}

				{%- unless section.settings.content == blank -%}
					<div class="m-0--clear">
						{{ section.settings.content }}
					</div>
				{%- endunless -%}

				{%- unless section.settings.button_label == blank or section.settings.button_url == blank -%}
					{% if enable_banner_link %}
						<span class="btn--minimal-light">
							{{ section.settings.button_label }}
						</span>
					{% else %}
						<a href="{{ section.settings.button_url }}" class="btn--minimal-light">
							{{ section.settings.button_label }}
						</a>
					{% endif %}
				{%- endunless -%}
			</div>
		</div>

		{%- unless section.settings.video_background == blank %}
			<div class="relative h-full overflow-hidden">
				<video
					x-ref="video"
					class="rounded-none absolute h-full w-full left-0 top-0 object-cover"
					playsinline
					{% if section.settings.auto_play %} loop muted {% endif %}
					poster="{%- if section.settings.image_background == blank %}
					https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png?format=webp&v=1530129081
					{%- else -%}
					{{ section.settings.image_background | image_url: width: 1200 }}
					{%- endif -%}">
						{% for source in section.settings.video_background.sources %}
							<source src="{{ source.url }}" type="{{ source.mime_type }}">
						{% endfor %}
				</video>
				{% if section.settings.enable_gradient %}
					<div
						class="absolute inset-0 z-[1] pointer-events-none"
						style="background: linear-gradient( to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.2) );"
					></div>
				{% endif %}
				{% if section.settings.auto_play == false and enable_banner_link == false %}
					<button x-ref="playBtn" class="hover:cursor-default border relative z-10 flex items-center justify-center w-full h-full overflow-hidden" aria-label="Play">
						<span
							class="btn btn--secondary hover:cursor-pointer absolute mt-2"
							@click='
								$refs.video.play();
								$refs.video.controls = true;
								$refs.playBtn.style.display = "none";
							'
						>
							{% render 'component__icon', icon: 'play', size: '30', class: "ml-2" %}
						</span>
					</button>
				{% endif %}
			</div>
		{%- endunless -%}
	{% if enable_banner_link %}
		</a>
	{% else %}
		</div>
	{% endif %}
</section>

{% schema %}
{
  "name": "Alternative video banner",
	"settings": [
		{"type":"checkbox","id":"enable_header_overlap","label":"Enable header overlap","info":"Places the banner media behind the header and offsets the banner content below it.","default":false},
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "",
          "label": "Show on all devices"
        },
        {
          "value": "md:hidden",
          "label": "Show on mobile only"
        },
        {
          "value": "hidden md:block",
          "label": "Show on desktop only"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "image_picker",
      "id": "image_background",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video_background",
      "label": "Video"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto-play video",
      "info": "Video will auto-play with muted audio. Customers will see a button to unmute and play the full video.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient overlay",
      "default": true
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 240,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile video height",
      "default": 420
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 240,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Desktop video height",
      "default": 320
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Subline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "SPACING"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Alternative video banner",
      "settings": {
        "visibility": "",
        "image_background": "shopify://shop_images/DSC08789.jpg",
        "video_background": "shopify://files/videos/Thread_FINAL_subtitles 2_1_1_1.mp4",
        "auto_play": true,
        "enable_gradient": true,
        "height_mobile": 420,
        "height_desktop": 320,
        "content": "<p>OUR MISSION</p>",
        "heading": "Empower and inspire others to carry on",
        "button_label": "Shop now",
        "button_url": "shopify://collections/all",
        "spacing_top": 0,
        "spacing_bottom": 0
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "custom.overlay"
    ]
  }
}
{% endschema %}
