<!-- sections/collection__sidebar.liquid -->
{% comment %}
  Main contents of the collection template (with vertical filters)

  Globals:
    - settings.layout_horizontal: horizontaly margin

  Possible enhancements:
    - Add support for global setting to control grid gap.
    - Add setting so blocks can be set to width of two blocks.
    - Add new block to support SMS opt-in.
  Pro tips:
    - Use blocks to showcase promotional content.
{% endcomment %}

{% assign sort_by = collection.sort_by | default: collection.default_sort_by | split: '?' | first %}
{% assign default_sort_by = '' %}
{% for option in collection.sort_options %}
  {% if sort_by contains option.value %}
    {% assign default_sort_by = option.name | split: '?' | first %}
  {% endif %}
{% endfor %}

<section id="js:top" class="{{ section.settings.color_scheme }}">
  {% render 'collection__sublinks' %}
  {% render 'collection__subtags' %}
  {% render 'collection__quickfilter' %}

  {% comment %}Back to school selection button for collegiate collection (mobile){% endcomment %}
  {% if collection.handle == 'collegiate' %}
    <div class="md:hidden border--b-width color__border-divider-1">
      <div class="px-4 py-4">
        <a 
          href="/pages/shop-your-school"
          class="type__nav type--small no-underline transition-opacity hover:opacity-75"
        >
          ← Back to school selection
        </a>
      </div>
    </div>
  {% endif %}

  <div class="flex flex-wrap max-w-full md:flex-nowrap">
    <div
      class="sticky top-0 z-20 w-full md:hidden color__bg-body md:border-r color__border-divider-1"
      x-ref="destop_filter"
      x-data="
        {
          sort_by : ['{{ sort_by }}'],
          height: 0
        }
      "
      {% if settings.header_position == 'sticky' %}
        x-init="
          height = $refs.header.offsetHeight;
          $refs.destop_filter.style.top = height + 'px';
        "
      {% endif %}
    >
      {% render 'component__collection-vertical-filter' %}
    </div>

    <div class="px-4 grow">
      {% comment %}
        {%- unless collection.title == blank -%}
          <h1 class="mt-12 mb-0 text-center type--big">{{ collection.title }}</h1>
        {%- endunless -%}
      {% endcomment %}
      {% paginate collection.products by section.settings.products_per_page %}
        {% comment %} Collection description {% endcomment %}
        {%- if section.settings.collection_enable_description -%}
          {% assign collection_image = collection.metafields.custom.description_image %}
          {% assign collection_body = collection.metafields.sf_global.collection_description_body %}

          {%- if collection_image != blank or collection_body != blank -%}
            <div class="py-8 border--t-width color__border-divider-1">
              <div
                class="grid"
                style="gap: {{ settings.layout_gap_size }}px;"
              >
                <div>
                  <div class="text-center opacity-75">
                    {{ collection_body }}
                  </div>
                </div>
                {%- unless collection_image == blank -%}
                  <div class="md:col-span-2">
                    {{ collection_image | image_url: width: 900 | image_tag: class: 'w-full', loading: lazy_loading }}
                  </div>
                {%- endunless -%}
              </div>
            </div>
          {% endif %}
        {%- endif -%}

        <section
          id="js:results"
          class="
            grid animation-500 py-4
            {{ section.settings.row_size_desktop }}
            {{ section.settings.row_size_mobile }}
          "
          :class="
            {
            'opacity-25' : pagination_loading }
          "
          style="
            column-gap: {{ settings.layout_gap_size }}px;
            row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;
          "
        >
          {% for product in collection.products %}
            {% assign gridIndex = forloop.index %}

            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when 'newsletter' -%}
                  {% assign paginateIndex = block.settings.paginate_index %}
                  {% if block.settings.index == gridIndex %}
                    {% if paginate.current_page == paginateIndex %}
                      {% render 'component__newsletter-item',
                        title: block.settings.heading,
                        content: block.settings.content,
                        button_label: block.settings.button_label,
                        disclaimer: block.settings.disclaimer,
                        success: block.settings.success,
                        size_desktop: block.settings.column_size,
                        background_image: block.settings.image_background,
                        background_color: block.settings.background_color_scheme,
                        index: gridIndex
                      %}
                    {% endif %}
                  {% endif %}

                {%- when 'content' -%}
                  {% assign paginateIndex = block.settings.paginate_index %}
                  {% if block.settings.index == gridIndex %}
                    {% if paginate.current_page == paginateIndex %}
                      {% render 'component__content-item',
                        url: block.settings.url,
                        title: block.settings.heading,
                        content: block.settings.content,
                        button_label: block.settings.button_label,
                        size_desktop: block.settings.column_size,
                        background_image: block.settings.image_background,
                        mobile_image: block.settings.mobile_image_background,
                        background_color: block.settings.background_color_scheme,
                        video: block.settings.video,
                        mobile_video: block.settings.mobile_video,
                        autoplay: block.settings.enable_autoplay,
                        mute: block.settings.enable_mute_toggle,
                        loop: block.settings.enable_loop,
                        index: gridIndex
                      %}
                    {% endif %}
                  {% endif %}
              {%- endcase -%}
            {% endfor %}

            {% render 'component__product-item', product: product, source: 'col_main', forloop: forloop.index %}
          {% endfor %}
        </section>

        {% if collection.all_products_count == 0 %}
          <section class="py-4 text-center">
            <span>{{ 'collections.general.no_matches' | t }}</span>
          </section>
        {% else %}
          {% render 'component__pagination', paginate: paginate %}
          {% render 'component__collection-schema', collection: collection %}
        {% endif %}

        {% render 'script__swatches' %}
      {% endpaginate %}
    </div>
  </div>
</section>

