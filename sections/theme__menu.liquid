<!-- sections/theme__menu.liquid -->
{% comment %} 
  Slide out menu for mobile visitors.

  Globals:
    - settings.enable_region: boolean to enable/disable the region selector
    - settings.enable_language: boolean to enable/disable the language selector
    - settings.type_seperator: setting to pick the type of seperator between text
  
  Protips:
    - Create a new navigation link list to set unique menu items for mobile visitors.
    - Nested items: upload Files named {collection-or-product-handle}-mobile.jpg (collections and products).
{% endcomment %}

{% capture drawer_content %}

  {%- comment -%} Top bar {%- endcomment -%}
  <section class="sticky top-0 flex flex-wrap items-center justify-between h-[56px]
    {{ section.settings.top_color_scheme }}"
    @click="menu_nested = false;">
    <div class="flex items-center justify-between w-full h-full">
      <button 
        class="type__body type--big w-full h-full flex-grow !text-left !justify-start !px-4 flex items-center border--b-width {{ section.settings.top_color_border }}"
        title="Search"
        @click.stop="menu_drawer = false; search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-mobile').focus(); });">
        {% render 'component__icon', icon: 'search', size: '20', class: 'opacity-50' %}
        <span class="ml-2 type__body type--big opacity-50">Search...</span>
      </button>
      <button 
        class="type--big h-full !text-left !justify-start !px-4 flex items-center border--b-width {{ section.settings.top_color_border }}"
        title="Close Menu"
        @click.stop="menu_drawer = false; menu_nested = false" >
        {% render 'component__icon', icon: 'x', size: '24', class: '' %}
      </button>
    </div>
    
    {% comment %} 
    <div class="text-right ">
      {% if section.settings.top_button_cart_type == "text" %}
        <a
          class="inline-flex pl-4 no-underline type--big"
          href="{{ routes.cart_url }}"
          rel="nofollow"
          {% if settings.cart_icon_behavior == "open_cart_drawer" %}
          @click.prevent="menu_drawer = false; cart_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}"
          {% endif %}>
            {{ 'cart.general.title' | t }} 
          <span class="ml-1">(<span x-text="cart.item_count">{{ cart.item_count }}</span>)</span>
        </a>
      {% else %}
        <a
          class="btn--close-dark btn--smaller"
          title="{{ 'general.navigation.close' | t }}"
          @click="menu_drawer = false;">
          {% render 'component__icon', icon: 'x', size: '24', class: '' %} 
        </a>
      {% endif %}
    </div> 
    {% endcomment %}
    
  </section>

  {%- if shop.customer_accounts_enabled -%}
    <a
      href="{{ routes.account_url }}"
      rel="nofollow"
      @click="menu_drawer = false; menu_nested = false"
      class="type__body type--big shrink-0 flex items-center gap-2 w-full min-h-[56px] px-4 py-3 border--b-width {{ section.settings.top_color_border }} {{ section.settings.top_color_scheme }} no-underline">
      {% render 'component__icon', icon: 'account', size: '24', class: 'shrink-0' %}
      <span>
        {% if customer %}
          {{ 'general.navigation.account' | t }}
        {% else %}
          {{ 'customer.account.log_in' | t }}
        {% endif %}
      </span>
    </a>
  {%- endif -%}

  {%- comment -%} Navigation {%- endcomment -%}
  <section class="relative flex min-h-0 flex-1 flex-col overflow-y-auto overflow-x-hidden
    {{ section.settings.main_color_scheme }}">
      <div 
        class="w-full pt-4"
        x-cloak
        x-data="{ accordion: null }">

            {%- for link in section.settings.main_links.links -%}
            {% if link.links != blank %}
                {% capture accordion_content %}
                  <div class="flex flex-col gap-2">
                    {% for child_link in link.links %}
                        <a href="{{ child_link.url }}" class="type--base flex items-center gap-2 w-full px-4 no-underline">
                            {%- liquid
                              assign child_image = ''
                              if child_link.url contains 'collections'
                                assign collection_handle = child_link.url | remove: shop.url | remove: 'collections' | remove: '//' | handleize
                                assign child_image = collection_handle | append: '-mobile.jpg'
                              elsif child_link.url contains 'products'
                                assign product_handle = child_link.url | split: '/products/' | last | split: '/' | first | split: '?' | first | handleize
                                assign child_image = product_handle | append: '-mobile.jpg'
                              endif
                            -%}
                            {% if child_image != blank %}
                                <picture
                                  class="mobile-menu__image shrink-0 color__bg-overlay-2 border--radius flex items-center overflow-hidden font-normal">
                                <source media="(min-width: 1px)" data-srcset="
                                    {{ child_image | file_img_url: "640x", format: 'jpg' }} 1x,
                                    {{ child_image | file_img_url: "640x", format: 'jpg', scale: 2 }} 2x">
                                <img
                                  class="w-full h-full object-cover"
                                  loading="lazy"
                                  width="80"
                                  height="80"
                                  alt="{{ child_link.title }}"
                                  src="{{ child_image | file_img_url: "1200x", format: 'jpg' }}">
                                </picture>
                            {%- endif -%}
                            <span class="type--base">{{ child_link.title }}</span>
                        </a>
                    {% endfor %}
                  </div>
                      <a href="{{ link.url }}" class="type__button uppercase leading-normal tracking-widest color__link flex items-center mx-4 mt-4 no-underline">
                    {{ 'general.navigation.shop_all' | t: title: link.title }}
                    {% render 'component__icon', icon: 'chevron-right', size: '16', class: 'ml-1' %}
                  </a>
                {% endcapture %}
                {% capture accordion_container_class %}{% endcapture %}
                {% capture accordion_inner_class %}bg-transparent{% endcapture %}
                {% render 'component__accordion', 
                    open: false,
                    index: forloop.index,
                    button_class: '!py-3',
                    button_label: link.title,
                    button_label_class: 'type__body type--big',
                    container_class: accordion_container_class,
                    inner_class: accordion_inner_class,
                    content: accordion_content %}

            {% else %}
                <a id="accordion-{{ forloop.index }}" class="type__body flex items-center justify-between w-full px-4 py-3 no-underline" href="{{ link.url }}">
                    <span class="text-left type--big">
                    {{ link.title }}
                    </span>
                </a>
            {% endif %}
            {% endfor %}

            {%- unless section.settings.feature_img == blank -%}
              <a href="{{ section.settings.url_id }}" class="block mx-4 mt-2 no-underline">
                <div class="relative aspect-[1/1.05] overflow-hidden color__bg-overlay-1 border--radius">
                  {{ section.settings.feature_img | image_url: width: 900 | image_tag: class: 'block w-full aspect-[1/1.05] object-cover', loading: 'lazy' }}
                  {%- if section.settings.text_id != blank -%}
                    <span class="!uppercase absolute bottom-4 right-4 type--big font-bold text-white border-b-2 border-white leading-tight">
                      {{ section.settings.text_id }}
                    </span>
                  {%- endif -%}
                </div>
              </a>
            {% endunless %}

      </div>

      {%- if section.settings.bottom_links.links != blank -%}
        <aside class="mt-auto px-4 py-3 {{ section.settings.bottom_color_scheme }}">
          {%- for link in section.settings.bottom_links.links -%}
            <a href="{{ link.url }}" class="type--big block py-2 no-underline">
              {{ link.title }}
            </a>
          {%- endfor -%}
        </aside>
      {%- endif -%}
  </section>

{% endcapture %}

{% render 'component__drawer', 
  drawer_id: 'menu_drawer',
  position: 'left',
  content: drawer_content %}

{% stylesheet %}
  .mobile-menu__image {
    --mobile-menu-image-size: 5rem;
    width: var(--mobile-menu-image-size);
    height: var(--mobile-menu-image-size);
    flex: 0 0 var(--mobile-menu-image-size);
  }
{% endstylesheet %}

