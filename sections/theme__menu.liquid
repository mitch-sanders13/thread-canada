<!-- sections/theme__menu.liquid -->
{% comment %} 
  Slide out menu for mobile visitors.

  Globals:
    - settings.enable_region: boolean to enable/disable the region selector
    - settings.enable_language: boolean to enable/disable the language selector
    - settings.type_seperator: setting to pick the type of seperator between text
  
  Protips:
    - Create a new navigation link list to set unique menu items for mobile visitors.
    - Nested items: upload Files named {collection-or-product-handle}-mobile.jpg (collections and products).
{% endcomment %}

{% capture drawer_content %}

  {%- comment -%} Top bar {%- endcomment -%}
  <section class="sticky top-0 flex flex-wrap items-center justify-between h-[56px]
    {{ section.settings.top_color_scheme }}"
    @click="menu_nested = false;">
    <div class="flex items-center justify-between w-full h-full">
      <button 
        class="type__nav w-full h-full flex-grow !text-left !justify-start !px-4 flex items-center border--b-width {{ section.settings.top_color_border }}"
        title="Search"
        @click.stop="menu_drawer = false; search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-mobile').focus(); });">
        {% render 'component__icon', icon: 'search', size: '24', class: '' %} 
        <span class="ml-1 type__nav">Search...</span>
      </button>
      <button 
        class="type__nav h-full !text-left !justify-start !px-4 flex items-center border--b-width {{ section.settings.top_color_border }}"
        title="Close Menu"
        @click.stop="menu_drawer = false; menu_nested = false" >
        {% render 'component__icon', icon: 'x', size: '24', class: '' %}
      </button>
    </div>
    
    {% comment %} 
    <div class="text-right ">
      {% if section.settings.top_button_cart_type == "text" %}
        <a
          class="inline-flex pl-4 no-underline type__nav"
          href="{{ routes.cart_url }}"
          rel="nofollow"
          {% if settings.cart_icon_behavior == "open_cart_drawer" %}
          @click.prevent="menu_drawer = false; cart_drawer = true; {% if settings.enable_audio %} const click_audio = new Audio(window.__initialData.click_audio); click_audio.play(); {% endif %}"
          {% endif %}>
            {{ 'cart.general.title' | t }} 
          <span class="ml-1">(<span x-text="cart.item_count">{{ cart.item_count }}</span>)</span>
        </a>
      {% else %}
        <a
          class="btn--close-dark btn--smaller"
          title="{{ 'general.navigation.close' | t }}"
          @click="menu_drawer = false;">
          {% render 'component__icon', icon: 'x', size: '24', class: '' %} 
        </a>
      {% endif %}
    </div> 
    {% endcomment %}
    
  </section>

  {%- comment -%}
    Mobile: account is not in the top header; only in this drawer, styled like the search control above (same h-[56px], padding, icon + label).
  {%- endcomment -%}
  {%- if shop.customer_accounts_enabled -%}
    <a
      href="{{ routes.account_url }}"
      rel="nofollow"
      @click="menu_drawer = false"
      class="type__nav w-full flex items-center h-[56px] !px-4 !text-left !justify-start border--b-width {{ section.settings.top_color_border }} no-underline uppercase
        {{ section.settings.top_color_scheme }}"
    >
      {% render 'component__icon', icon: 'account', size: '24', class: '' %}
      <span class="ml-1 type__nav">
        {%- if customer -%}
          {{ 'general.navigation.account' | t }}
        {%- else -%}
          {{ 'customer.account.log_in' | t }}
        {%- endif -%}
      </span>
    </a>
  {%- endif -%}
  
  {%- comment -%} Navigation {%- endcomment -%}
  <section class="relative h-[inherit] overflow-y-auto overflow-x-hidden
    {{ section.settings.main_color_scheme }}">
      <div 
        class="w-full"
        x-cloak
        x-data="{ accordion: null }">

            {%- for link in section.settings.main_links.links -%}
            {% if link.links != blank %}
                {% capture accordion_content %}
                    {% for child_link in link.links %}
                        <a href="{{ child_link.url }}" class="type__nav border--t-width {{ section.settings.main_color_border }} flex flex-col items-start justify-start w-full px-4 py-4 no-underline uppercase">
                            {%- liquid
                              assign child_image = ''
                              if child_link.url contains 'collections'
                                assign collection_handle = child_link.url | remove: shop.url | remove: 'collections' | remove: '//' | handleize
                                assign child_image = collection_handle | append: '-mobile.jpg'
                              elsif child_link.url contains 'products'
                                assign product_handle = child_link.url | split: '/products/' | last | split: '/' | first | split: '?' | first | handleize
                                assign child_image = product_handle | append: '-mobile.jpg'
                              endif
                            -%}
                            {% if child_image != blank %}
                                <picture class="color__bg-overlay-2 aspect-[1/1] border--radius flex items-center font-normal">
                                <source media="(min-width: 1px)" data-srcset="
                                    {{ child_image | file_img_url: "640x", format: 'jpg' }} 1x,
                                    {{ child_image | file_img_url: "640x", format: 'jpg', scale: 2 }} 2x">
                                <img class="h-[127px] w-[127px]" loading="lazy" alt="{{ child_link.title }}" src="{{ child_image | file_img_url: "1200x", format: 'jpg' }}">
                                </picture>
                            {%- endif -%}
                            <span class="pt-2 type__nav">{{ child_link.title }}</span>
                        </a>
                    {% endfor %}
                {% endcapture %}
                {% capture accordion_container_class %}{% unless forloop.last %}border--b-width{% endunless %} {{ section.settings.main_color_border }}{% endcapture %}
                {% capture accordion_inner_class %}color__bg-overlay-1 {% unless link.title == "Brand" %}grid grid-cols-2{% endunless %}{% endcapture %}
                {% render 'component__accordion', 
                    open: false,
                    index: forloop.index,
                    button_label: link.title, 
                    container_class: accordion_container_class,
                    inner_class: accordion_inner_class,
                    content: accordion_content %}

            {% else %}
                <a id="accordion-{{ forloop.index }}" class="type__body border--b-width {{ section.settings.main_color_border }} flex items-center justify-between w-full px-4 py-[1.25rem] no-underline uppercase" href="{{ link.url }}">
                    <span class="text-left type__nav">
                    {{ link.title }}
                    </span>
                </a>
            {% endif %}
            {% endfor %}

            {%- unless section.settings.feature_img == blank -%}
              <a href="{{ section.settings.url_id }}">
                <div class="relative m-4 color__bg-overlay-1">
                  {{ section.settings.feature_img | image_url: height: 210 | image_tag: class: 'w-full', loading: 'lazy' }}
                  <div class="absolute flex items-center justify-center bg-white bottom-2 left-2 right-2">
                    <button class="btn btn--secondary !w-full">{{ section.settings.text_id }}</button>
                  </div>
                </div>
              </a>
            {% endunless %}

      </div>
  </section>

  {%- comment -%} Sticky footer {%- endcomment -%}
  {% comment %} 
  <aside class="sticky bottom-0 {{ section.settings.bottom_color_scheme }}" x-show="!menu_nested">
    <div class="flex flex-wrap">

      <div class="border--t-width {{ section.settings.bottom_color_border }} w-full">
        <div class="flex flex-wrap px-4 pt-2">

        {%- if shop.customer_accounts_enabled -%} 
          <a href="{{ routes.account_url }}" rel="nofollow" class="btn btn--smaller mb-2 mr-2
            {{ section.settings.bottom_button_color }}">
            {% if customer %}
              {{ 'general.navigation.account' | t }}
            {% else %}
            {{ 'customer.account.log_in' | t }}
            {% endif %}
          </a>
        {% endif %}

          {% if settings.enable_region or settings.enable_language %}
            <button class="btn btn--smaller mb-2 mr-2
            {{ section.settings.bottom_button_color }}" 
              @click="localization_popup = true;">
              <span class="fi type--smaller" style="background-image: url(https://flagicons.lipis.dev/flags/4x3/{{ localization.country.iso_code | downcase }}.svg)"></span>
              <span class="ml-1 type--smaller">{{ localization.country.currency.symbol }} {{ localization.country.currency.iso_code }}
              {% if settings.type_seperator == 'dot' %}·{% else %}|{% endif %}
              {{ localization.language.iso_code | upcase }}</span> 
              {% render 'component__icon', icon: 'chevron-down', size: '16' %}
            </button>
          {% endif %}
          
        </div>
      </div>

      <div class="border--t-width {{ section.settings.bottom_color_border }} w-full">
        <p class="px-4 py-2 m-0 type--small">
          {%- for link in section.settings.bottom_links.links -%}
            <a href="{{ link.url }}" class="mr-2">{{ link.title }}</a>
          {%- endfor -%}
         </p>
      </div>
      
    </div>
  </aside> 
  {% endcomment %}

{% endcapture %}

{% render 'component__drawer', 
  drawer_id: 'menu_drawer',
  position: 'left',
  content: drawer_content %}

