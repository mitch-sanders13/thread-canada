<!-- sections/product-grid.liquid -->
{% comment %} 
  Grid of products.

  Globals:
    - settings.layout_horizontal: horizontaly margin
{% endcomment %}

{% assign collection_tab_count = 0 %}
{% assign first_collection_tab_id = '' %}
{% for block in section.blocks %}
  {% if block.type == 'collection_tab' %}
    {% assign collection_tab_count = collection_tab_count | plus: 1 %}
    {% if first_collection_tab_id == '' %}
      {% assign first_collection_tab_id = block.id %}
    {% endif %}
  {% endif %}
{% endfor %}

<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_scheme }} 
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}" style="--product-grid-active-color: {% if section.settings.enable_featured_layout %}var(--thread-blue){% else %}{{ settings.mobile_bar_light }}{% endif %};">
  <div class="{% if section.settings.enable_featured_layout %}px-2 py-6 md:px-12 md:pb-12{% else %}{{ settings.layout_horizontal }}{% endif %}"
    {% unless section.settings.enable_featured_layout %}style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;"{% endunless %}>

    {% if section.settings.use_large_heading %}
      {% if section.settings.heading != blank %}
        <h2 class="type__heading--section mb-2 text-center">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.content != blank or section.settings.button_url != blank %}
        <div class="mx-auto mb-4 max-w-prose text-center">
          {% if section.settings.content != blank %}
            <div class="m-0--clear">{{ section.settings.content }}</div>
          {% endif %}
          {% if section.settings.button_url != blank %}
            <a href="{{ section.settings.button_url }}" class="mt-2 {{ section.settings.color_button }}">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      {% render 'component__section-header' %}
    {% endif %}
    {% if collection_tab_count > 0 %}
      <div
        x-data="{ activeTab: '{{ section.id }}-{{ first_collection_tab_id }}' }"
      >
        <div class="flex flex-wrap justify-center gap-6 pb-8">
          {% for block in section.blocks %}
            {% if block.type == 'collection_tab' %}
              {% assign tab_label = block.settings.label %}
              {% if tab_label == blank %}
                {% assign tab_label = collections[block.settings.collection].title %}
              {% endif %}
              <button
                type="button"
                class="type__label min-h-[44px] px-1 pb-1 border--b-width border-transparent aria-pressed:text-[var(--product-grid-active-color)] aria-pressed:border-[var(--product-grid-active-color)]"
                :aria-pressed="activeTab === '{{ section.id }}-{{ block.id }}'"
                @click="activeTab = '{{ section.id }}-{{ block.id }}'"
                {{ block.shopify_attributes }}
              >
                {{ tab_label }}
              </button>
            {% endif %}
          {% endfor %}
        </div>

        {% for block in section.blocks %}
          {% if block.type == 'collection_tab' %}
            <div
              x-show="activeTab === '{{ section.id }}-{{ block.id }}'"
              x-cloak
            >
              <div class="grid {% if section.settings.enable_featured_layout %}gap-x-2 gap-y-8{% else %}gap-x-[var(--product-grid-column-gap)] gap-y-[var(--product-grid-row-gap)]{% endif %}
                {{ section.settings.row_size_desktop }}
                {{ section.settings.row_size_mobile }}"
                style="
                  --product-grid-column-gap: {{ settings.layout_gap_size }}px;
                  --product-grid-row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;">
                
                {% assign displayed_count = 0 %}
                {% for product in collections[block.settings.collection].products %}
                  
                  {% assign hideproduct = false %}
                  {% for tag in product.tags %}
                    {% if tag contains "hideproduct" %}
                      {% assign hideproduct = true %}
                    {% endif %}
                    {% comment %} Hide collegiate products from non-collegiate collections {% endcomment %}
                    {% if tag == "collegiate" and collections[block.settings.collection].handle != "collegiate" %}
                      {% assign hideproduct = true %}
                    {% endif %}
                  {% endfor %}
                  
                  {% unless hideproduct %}
                    {% render 'component__product-item', product: product, source: block.id %}
                    {% assign displayed_count = displayed_count | plus: 1 %}
                    {% if displayed_count == section.settings.products_count %}
                      {% break %}
                    {% endif %}
                  {% endunless %}
                  
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% if section.settings.show_collection_buttons %}
          <div class="flex justify-center pt-6">
            {% for block in section.blocks %}
              {% if block.type == 'collection_tab' %}
                <a class="{{ section.settings.color_button }} min-h-[48px] w-full md:w-auto" href="{{ block.settings.cta_url | default: collections[block.settings.collection].url }}"
                  x-show="activeTab === '{{ section.id }}-{{ block.id }}'" x-cloak>
                  {{ block.settings.cta_label | default: block.settings.label | default: collections[block.settings.collection].title | escape }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        {% render 'script__swatches' %}
      </div>
    {% else %}
      <div class="grid {% if section.settings.enable_featured_layout %}gap-x-2 gap-y-8{% else %}gap-x-[var(--product-grid-column-gap)] gap-y-[var(--product-grid-row-gap)]{% endif %}
        {{ section.settings.row_size_desktop }}
        {{ section.settings.row_size_mobile }}"
        style="
          --product-grid-column-gap: {{ settings.layout_gap_size }}px;
          --product-grid-row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;">
        
        {% assign displayed_count = 0 %}
        {% for product in collections[section.settings.collection].products %}
          
          {% assign hideproduct = false %}
          {% for tag in product.tags %}
            {% if tag contains "hideproduct" %}
              {% assign hideproduct = true %}
            {% endif %}
            {% comment %} Hide collegiate products from non-collegiate collections {% endcomment %}
            {% if tag == "collegiate" and collections[section.settings.collection].handle != "collegiate" %}
              {% assign hideproduct = true %}
            {% endif %}
          {% endfor %}
          
          {% unless hideproduct %}
            {% render 'component__product-item', product: product, source: 'prod-grid' %}
            {% assign displayed_count = displayed_count | plus: 1 %}
            {% if displayed_count == section.settings.products_count %}
              {% break %}
            {% endif %}
          {% endunless %}
          
        {% endfor %}

        {% render 'script__swatches' %}
        
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'card' -%}
            {% render 'component__content-item',
              background_color: settings.thumbmails_color_scheme,
              title: block.settings.heading,
              content: block.settings.content,
              button_label: block.settings.button_label,
              url: block.settings.button_url %}
          {%- endcase -%}
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
