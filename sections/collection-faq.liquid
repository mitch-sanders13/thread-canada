<!-- sections/collection-faq.liquid -->
{% comment %} 
  Display a two-column FAQ grid with expandable accordion items.

  Content (per collection):
    1) Collection metafield custom.faq_items — list OR one metaobject reference (Collection FAQ item)
    2) Collection metafield custom.collection_faq — JSON array of { question|title, answer|content, open? }

  Globals:
    - settings.layout_horizontal: horizontal margin
    - settings.enable_animations: boolean to enable animations

  Pro tips:
    - Designed for collection pages to boost SEO with FAQ content.
    - Uses a 2-column grid on desktop that collapses to 1 column on mobile.
{% endcomment %}

{% liquid
  assign mf_faqs = blank
  assign mf_faq_single = blank
  assign json_faqs = blank
  if collection
    assign mf_def = collection.metafields.custom.faq_items
    assign mf_raw = mf_def.value
    if mf_def != blank and mf_def.type contains 'list.metaobject_reference'
      if mf_raw != blank and mf_raw.size > 0
        assign mf_faqs = mf_raw
      endif
    elsif mf_def != blank and mf_def.type == 'metaobject_reference' and mf_raw != blank
      assign mf_faq_single = mf_raw
    endif
    assign json_faqs = collection.metafields.custom.collection_faq.value
  endif

  assign content_source = blank
  if mf_faqs != blank
    assign content_source = 'metaobject'
  elsif mf_faq_single != blank
    assign content_source = 'metaobject_single'
  elsif json_faqs != blank and json_faqs.size > 0
    assign content_source = 'json'
  endif

  assign has_any_faq = false
  if content_source != blank
    assign has_any_faq = true
  endif

  assign faq_count = 0
  case content_source
    when 'metaobject'
      assign faq_count = mf_faqs.size
    when 'metaobject_single'
      assign faq_count = 1
    when 'json'
      assign faq_count = json_faqs.size
  endcase
%}

{% if has_any_faq or request.design_mode %}
<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_scheme }} 
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}">
  <div style="
    padding-top:{{ section.settings.spacing_top }}px;
    padding-bottom:{{ section.settings.spacing_bottom }}px;" 
    class="{{ section.settings.layout_horizontal }}">

    {% render 'component__section-header' %} 

    <div class="grid md:grid-cols-2 grid-cols-1 items-start" style="gap: {{ section.settings.layout_gap }}px;">
      {% case content_source %}
        {% when 'metaobject' %}
          {% for entry in mf_faqs %}
            {% assign fq = entry.question.value | default: entry.question %}
            {% liquid
              assign is_open = false
              if entry.open.value == true or entry.open == true
                assign is_open = true
              elsif entry.enable_open.value == true or entry.enable_open == true
                assign is_open = true
              elsif entry.accordion_expanded_by_default.value == true or entry.accordion_expanded_by_default == true
                assign is_open = true
              endif
            %}
            {% capture faq_body %}{{ entry.answer | metafield_tag }}{% endcapture %}
            {% render 'collection-faq__item',
              title: fq,
              content_html: faq_body,
              open: is_open,
              border_color: section.settings.color_border,
              shopify_attributes: '' %}
          {% endfor %}
        {% when 'metaobject_single' %}
          {% assign entry = mf_faq_single %}
          {% assign fq = entry.question.value | default: entry.question %}
          {% liquid
            assign is_open = false
            if entry.open.value == true or entry.open == true
              assign is_open = true
            elsif entry.enable_open.value == true or entry.enable_open == true
              assign is_open = true
            elsif entry.accordion_expanded_by_default.value == true or entry.accordion_expanded_by_default == true
              assign is_open = true
            endif
          %}
          {% capture faq_body %}{{ entry.answer | metafield_tag }}{% endcapture %}
          {% render 'collection-faq__item',
            title: fq,
            content_html: faq_body,
            open: is_open,
            border_color: section.settings.color_border,
            shopify_attributes: '' %}
        {% when 'json' %}
          {% for item in json_faqs %}
            {% assign fq = item.question | default: item.title %}
            {% liquid
              assign is_open = false
              if item.open == true or item.open == 'true' or item.enable_open == true or item.enable_open == 'true' or item.accordion_expanded_by_default == true or item.accordion_expanded_by_default == 'true'
                assign is_open = true
              endif
            %}
            {% assign ans = item.answer | default: item.content %}
            {% render 'collection-faq__item',
              title: fq,
              content_html: ans,
              open: is_open,
              border_color: section.settings.color_border,
              shopify_attributes: '' %}
          {% endfor %}
      {% endcase %}
      {% if request.design_mode and faq_count == 0 %}
        <p class="opacity-70 text-sm col-span-full">
          {{ 'sections.collection_faq.editor_empty_state' | t }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.enable_schema and faq_count > 0 %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- case content_source -%}
              {%- when 'metaobject' -%}
                {%- for entry in mf_faqs -%}
                  {%- assign schema_q = entry.question.value | default: entry.question | strip -%}
                  {%- assign schema_a = entry.answer.value | default: entry.answer | strip_html -%}
                  {
                    "@type": "Question",
                    "name": {{ schema_q | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ schema_a | json }}
                    }
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              {%- when 'metaobject_single' -%}
                {%- assign entry = mf_faq_single -%}
                {%- assign schema_q = entry.question.value | default: entry.question | strip -%}
                {%- assign schema_a = entry.answer.value | default: entry.answer | strip_html -%}
                {
                  "@type": "Question",
                  "name": {{ schema_q | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ schema_a | json }}
                  }
                }
              {%- when 'json' -%}
                {%- for item in json_faqs -%}
                  {%- assign schema_q = item.question | default: item.title | strip -%}
                  {%- assign schema_a = item.answer | default: item.content | strip_html -%}
                  {
                    "@type": "Question",
                    "name": {{ schema_q | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ schema_a | json }}
                    }
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
            {%- endcase -%}
          ]
        }
      </script>
    {% endif %}
    
  </div>
</section>
{% endif %}

